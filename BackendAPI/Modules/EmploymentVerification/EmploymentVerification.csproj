<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Carter" Version="10.0.0" />
		<PackageReference Include="MediatR" Version="12.2.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<!-- Quartz, for the automatic verification-request job. Versions pinned to match
		     ATS: there is one scheduler in the process and ATS owns it, so a version
		     skew here would be a runtime surprise rather than a build error. PhilSys
		     rides the same scheduler from its own module the same way. -->
		<PackageReference Include="Quartz" Version="3.18.2" />
		<PackageReference Include="Quartz.Extensions.DependencyInjection" Version="3.18.2" />
		<PackageReference Include="Quartz.Extensions.Hosting" Version="3.18.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\BuildingBlocks\BuildingBlocks\BuildingBlocks.csproj" />
		<ProjectReference Include="..\ATS\ATS.csproj" />
	</ItemGroup>

</Project>
