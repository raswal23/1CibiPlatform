{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PlatformLogging": {
    "PostgreSqlEnabled": true,
    "ConnectionStringName": "OnePlatform_Connection",
    "Schema": "logging",
    "Table": "log_events",
    "BufferSize": 10000,
    "BatchSize": 100,
    "FlushIntervalSeconds": 2,
    "RetentionEnabled": true,
    "RetentionDays": 30,
    "RetentionIntervalHours": 24,
    "RetentionBatchSize": 5000
  },
  "AllowedHosts": "*"
}
