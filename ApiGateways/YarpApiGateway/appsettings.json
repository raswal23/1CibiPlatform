{
  "Monitoring": {
    // CIDR blocks permitted to reach /metrics and /health on the gateway. Narrow this
    // to the monitoring server's private address in each deployed environment; the
    // default is deliberately empty so an unconfigured host exposes nothing.
    "AllowedScrapeNetworks": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
