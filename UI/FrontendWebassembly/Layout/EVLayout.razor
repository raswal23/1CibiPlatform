@layout ConsoleLayout
@inherits LayoutComponentBase
@implements IDisposable

@* Employment Verification console shell.

   Deliberately a TOP NAVBAR where ATS uses a sidebar. The two applications share
   everything else - the same navy topbar gradient, the same icon buttons, the same
   avatar, the same dialogs and tables - so they read as one platform, while the
   axis of the navigation tells you at a glance which application you are in.
   Three tabs do not justify a 232px sidebar the way ATS's sixteen modules do. *@

@if (_isReady)
{
    <div class="ev-console">
        <header class="ev-topbar">
            <div class="ev-topbar-brand">
                <span class="ev-topbar-logo">
                    <img src="images/generic/cibi-icon.png" alt="CIBI" />
                </span>
                <span class="ev-topbar-brand-text">
                    <small>OnePlatform</small>
                    <strong>Employment Verification</strong>
                </span>
            </div>

            <nav class="ev-topbar-nav" aria-label="Employment verification sections">
                @foreach (var tab in Tabs)
                {
                    <NavLink href="@tab.Href" class="ev-nav-item" Match="NavLinkMatch.Prefix">
                        <MudIcon Icon="@tab.Icon" Class="ev-nav-ic" />
                        <span class="ev-nav-text">@tab.Label</span>
                    </NavLink>
                }
            </nav>

            <div class="ev-topbar-right">
                <button type="button"
                        class="ats-console-icon-btn"
                        aria-label="@(Theme.IsDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                        aria-pressed="@Theme.IsDarkMode"
                        title="@(Theme.IsDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                        @onclick="ToggleThemeAsync">
                    @if (Theme.IsDarkMode)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8" />
                        </svg>
                    }
                </button>

                <button type="button"
                        class="ats-console-icon-btn"
                        title="Return home"
                        aria-label="Return to OnePlatform"
                        @onclick="GoToOnePlatform">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        @* House with a return arrow sweeping back in through the doorway,
                           matching the ATS sidebar's Return Home mark. *@
                        <path d="M3.5 10.5 12 3.5l8.5 7" />
                        <path d="M5.5 9v10.5h4.8" />
                        <path d="M18.5 9v10.5h-4.6" />
                        <path d="M20 15.5h-7.5" />
                        <path d="m15.2 12.9-2.7 2.6 2.7 2.6" />
                    </svg>
                </button>

                <div class="ev-topbar-divider" aria-hidden="true"></div>

                <div class="ev-topbar-avatar"
                     role="img"
                     aria-label="@($"{_userDisplayName} profile initials")"
                     title="@_userDisplayName">
                    @_userInitials
                </div>
            </div>
        </header>

        <main class="ev-console-content">
            @Body
        </main>
    </div>
}
else
{
    <CibiLoaderComponent />
}
