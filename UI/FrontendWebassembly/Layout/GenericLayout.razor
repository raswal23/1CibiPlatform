@inherits LayoutComponentBase
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider BackdropClick="false" />
<MudSnackbarProvider />

<ErrorBoundary>
    <ChildContent>
            @Body
    </ChildContent>

    <ErrorContent Context="exception">
        <ErrorDialogComponent Message="@exception.Message" />
    </ErrorContent>
</ErrorBoundary>
