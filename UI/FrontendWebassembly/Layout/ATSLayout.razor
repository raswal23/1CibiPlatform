@layout ConsoleLayout
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IAuthService IAuthService
@inject IAccessService AccessService
@inject IATSUserManagementService UserManagementService
@inject LocalStorageService LocalStorageService
@inject ThemeService Theme
@inject IJSRuntime JS
@implements IDisposable
@using FrontendWebassembly.ShareData.ATS

@if (_isReady)
{
    <CascadingValue TValue="IReadOnlySet<int>"
                    Name="ATSAccessibleModuleIds"
                    Value="_accessibleModuleIds"
                    IsFixed="true">
    <div class="@($"ats-console {(_isSidebarCollapsed ? "ats-console-collapsed" : string.Empty)} {(_isMobileDrawerOpen ? "ats-console-mobile-drawer-open" : string.Empty)}")">
        @if (_isMobileDrawerOpen)
        {
            <button type="button" class="ats-console-mobile-overlay" aria-label="Close drawer" @onclick="CloseMobileDrawer"></button>
        }

        <aside class="ats-console-sidebar">
            @* The logo lives outside the scroll area so it stays put — inside it,
               the nav scrollbar appearing would shift it left and scrolling would
               move it off-screen. *@
            <div class="ats-console-logo">
                <div class="ats-console-logo-mark">
                    @* The shipped CIBI mark, used as the asset rather than redrawn as inline
                       polygons: the artwork is a seven-shade rhombic lattice, and a hand-traced
                       copy would drift from the brand file the next time it is reissued. The
                       same PNG is already the favicon in index.html.

                       No "ATS" lettering over it any more - the mark stands alone. *@
                    <img class="ats-logo-facets"
                         src="images/generic/cibi-icon.png"
                         alt="CIBI" />
                </div>
            </div>

            <div class="ats-console-sidebar-scroll">
                @foreach (var module in ModuleList.List
                    .Where(item => ModuleList.IsPrimaryNavigationModule(item.Key) && _accessibleModuleIds.Contains(item.Key))
                    .OrderBy(item => item.Key))
                {
                    <NavLink href="@($"/s&i/ats/{module.Value.path}")" class="ats-console-nav-item" Match="NavLinkMatch.Prefix">
                        <MudIcon Icon="@module.Value.Icon" Class="ats-console-nav-ic" />
                        <span class="ats-console-nav-text">@module.Value.Name</span>
                    </NavLink>
                }

                @{ var settingsModules = ModuleList.List
					.Where(item => !ModuleList.IsPrimaryNavigationModule(item.Key) && _accessibleModuleIds.Contains(item.Key))
                    .OrderBy(item => item.Key)
                    .ToArray(); }

                @if (settingsModules.Length > 0)
                {
                    <div class="ats-console-nav-label">Manage</div>

                    <div class="ats-console-nav-group">
                        <button type="button"
                                class="@($"ats-console-nav-item ats-console-nav-item-toggle {(_isSettingsExpanded ? "ats-console-nav-item-expanded" : string.Empty)}")"
                                aria-expanded="@_isSettingsExpanded"
                                @onclick="ToggleSettingsExpanded">
                            <MudIcon Icon="@Icons.Material.Filled.Settings" Class="ats-console-nav-ic" />
                            <span class="ats-console-nav-text">Settings</span>
                            <MudIcon Icon="@Icons.Material.Filled.ExpandMore"
                                     Class="@( "ats-console-nav-chevron " + (_isSettingsExpanded ? "expanded" : "") )" />
                        </button>

						<div class="@($"ats-console-nav-submenu-shell {(_isSettingsExpanded ? "is-expanded" : string.Empty)}")"
							 aria-hidden="@(!_isSettingsExpanded)">
							<div class="ats-console-nav-submenu">
								@foreach (var module in settingsModules)
								{
									<NavLink href="@($"/s&i/ats/{module.Value.path}")" class="ats-console-nav-subitem" Match="NavLinkMatch.Prefix">
										<MudIcon Icon="@module.Value.Icon" Class="ats-console-nav-ic" />
										<span class="ats-console-nav-text">@module.Value.Name</span>
									</NavLink>
								}
							</div>
						</div>
                    </div>
                }
            </div>

            <div class="ats-console-sidebar-bottom">
                <button type="button"
                        class="ats-console-nav-item ats-console-back-btn"
                        title="Return home"
                        @onclick="GoBackToOnePlatform">
                    <svg class="ats-console-nav-ic ats-console-back-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        @* House with a return arrow sweeping back in through the doorway *@
                        <path d="M3.5 10.5 12 3.5l8.5 7" />
                        <path d="M5.5 9v10.5h4.8" />
                        <path d="M18.5 9v10.5h-4.6" />
                        <path d="M20 15.5h-7.5" />
                        <path d="m15.2 12.9-2.7 2.6 2.7 2.6" />
                    </svg>
                    <span class="ats-console-nav-text">Return Home</span>
                </button>
            </div>
        </aside>

        <div class="ats-console-main">
            <div class="ats-console-topbar">
                <div class="ats-console-topbar-left">
                    <button type="button"
                            class="ats-console-icon-btn ats-console-menu-btn"
                            aria-label="@(_isSidebarCollapsed ? "Expand drawer" : "Collapse drawer")"
                            aria-expanded="@(!_isSidebarCollapsed)"
                            title="@(_isSidebarCollapsed ? "Expand drawer" : "Collapse drawer")"
                            @onclick="ToggleSidebar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <path d="M4 7h16M4 12h16M4 17h16" />
                        </svg>
                    </button>
                    <div class="ats-console-title-block">
                        <div class="ats-console-crumb">
                            <span>Applicant Tracking System</span>
                            <span class="ats-console-crumb-separator">/</span>
                            <strong>@_pageTitle</strong>
                        </div>
                        <h1>@_pageTitle</h1>
                    </div>
                </div>
                <div class="ats-console-topbar-right">
                    <button type="button"
                            class="ats-console-icon-btn"
                            aria-label="@(Theme.IsDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                            aria-pressed="@Theme.IsDarkMode"
                            title="@(Theme.IsDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                            @onclick="ToggleThemeAsync">
                        @if (Theme.IsDarkMode)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="4" />
                                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8" />
                            </svg>
                        }
                    </button>

                    @* Mounted here rather than per page so the hub connection is opened
                       once and stays live across ATS navigation. *@
                    <NotificationCenter />
                    <div class="ats-console-topbar-divider" aria-hidden="true"></div>
                    <div class="ats-console-avatar"
                         role="img"
                         aria-label="@($"{_userDisplayName} profile initials")"
                         title="@_userDisplayName">
                        @_userInitials
                    </div>
                </div>
            </div>

            <div class="ats-console-content">
                @Body
            </div>
        </div>
    </div>
    </CascadingValue>
}
else
{
    <CibiLoaderComponent />
}


@code {
    private bool _isSettingsExpanded;
	private const string UserNameStorageKey = "Name";
	private const string ATSRoleIdStorageKey = "ATSRoleId";

    private void ToggleSettingsExpanded()
    {
        _isSettingsExpanded = !_isSettingsExpanded;
    }

    // Must match the sidebar's off-canvas breakpoint in wwwroot/css/ats.css and
    // MudTable's Breakpoint.Sm card mode, which both fire at 960px. It was 920,
    // which left 921-960px showing a static 232px sidebar beside tables that had
    // already collapsed to stacked cards.
    private const int MobileBreakpoint = 960;
    private string _pageTitle = "Dashboard";
    private bool _isReady;
    private bool _isSidebarCollapsed;
    private bool _isMobileDrawerOpen;
    private bool _isMobileView;
    private string _userDisplayName = "User";
    private string _userInitials = "U";
    private HashSet<int> _accessibleModuleIds = new();

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await IAuthService.IsAuthenticated();

        //getclientid

		if (!isAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

		if (!await AccessService.HasAccessAsync(6, 7))
		{
			NavigationManager.NavigateTo("/access-denied");
			return;
		}

		var storedUserName = await LocalStorageService.GetItemAsync<string>(UserNameStorageKey);
		_userDisplayName = string.IsNullOrWhiteSpace(storedUserName) ? "User" : storedUserName.Trim();
		_userInitials = GetUserInitials(_userDisplayName);

		var roleIdResponse = await UserManagementService.GetMyRoleIdAsync();
		var atsRoleId = (roleIdResponse.IsSuccess ? roleIdResponse.Data : null) ?? 0;
		await LocalStorageService.SetItemAsync(ATSRoleIdStorageKey, atsRoleId);

		if (await AccessService.HasRoleAsync(RoleList.SuperAdminId))
		{
			_accessibleModuleIds = ModuleList.List.Keys.ToHashSet();
		}
		else
		{
			var moduleIdsResponse = await UserManagementService.GetMyModuleIdsAsync();

			// Fail closed: no module list means no access; the route check below redirects.
			_accessibleModuleIds = moduleIdsResponse.IsSuccess && moduleIdsResponse.Data is not null
				? moduleIdsResponse.Data.ToHashSet()
				: new HashSet<int>();
		}
		if (!CanAccessRoute(NavigationManager.Uri))
		{
			NavigationManager.NavigateTo("/access-denied");
			return;
		}

        SetTitleFromUri();
        NavigationManager.LocationChanged += HandleLocationChanged;
        Theme.OnChanged += HandleThemeChanged;
        _isReady = true;
    }

    private async Task ToggleThemeAsync() => await Theme.ToggleAsync();

    private void HandleThemeChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await UpdateViewportModeAsync();
        StateHasChanged();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
		if (!CanAccessRoute(e.Location))
		{
			NavigationManager.NavigateTo("/access-denied");
			return;
		}

        SetTitleFromUri();

        if (_isMobileView)
        {
            _isMobileDrawerOpen = false;
        }

        InvokeAsync(StateHasChanged);
    }

	private bool CanAccessRoute(string uri)
	{
		var relativePath = NavigationManager.ToBaseRelativePath(uri)
			.Split('?', '#')[0]
			.Trim('/');
		const string atsRoot = "s&i/ats";

		if (string.Equals(relativePath, atsRoot, StringComparison.OrdinalIgnoreCase))
			return _accessibleModuleIds.Count > 0;

		if (!relativePath.StartsWith($"{atsRoot}/", StringComparison.OrdinalIgnoreCase))
			return true;

		var routeSegment = relativePath[(atsRoot.Length + 1)..]
			.Split('/', StringSplitOptions.RemoveEmptyEntries)[0];
		var module = ModuleList.List.FirstOrDefault(item =>
			string.Equals(item.Value.path, routeSegment, StringComparison.OrdinalIgnoreCase));
		if (module.Key > 0)
			return _accessibleModuleIds.Contains(module.Key);

		// Notifications is not a permissioned module - everyone who can reach ATS at all
		// has an inbox, and it only ever shows that user's own rows. It is therefore
		// deliberately absent from ModuleList, which would otherwise put an ungrantable
		// entry in the sidebar; the check has to allow it explicitly instead.
		if (string.Equals(routeSegment, "notifications", StringComparison.OrdinalIgnoreCase))
			return true;

		return string.Equals(routeSegment, "settings", StringComparison.OrdinalIgnoreCase) &&
			_accessibleModuleIds.Overlaps([6, 7, 8]);
	}

    private async Task ToggleSidebar()
    {
        await UpdateViewportModeAsync();

        if (_isMobileView)
        {
            _isSidebarCollapsed = false;
            _isMobileDrawerOpen = !_isMobileDrawerOpen;
            return;
        }

        _isMobileDrawerOpen = false;
        _isSidebarCollapsed = !_isSidebarCollapsed;
    }

    private void CloseMobileDrawer()
    {
        _isMobileDrawerOpen = false;
    }

    private async Task UpdateViewportModeAsync()
    {
        _isMobileView = await JS.InvokeAsync<int>("getViewportWidth") <= MobileBreakpoint;

        if (!_isMobileView)
        {
            _isMobileDrawerOpen = false;
        }
    }

    private void SetTitleFromUri()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
		var path = relative.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
		_pageTitle = ModuleList.List.Values
			.FirstOrDefault(module => string.Equals(module.path, path, StringComparison.OrdinalIgnoreCase))
			.Name ?? "Dashboard";
    }

	private static string GetUserInitials(string? fullName)
	{
		var nameParts = fullName?
			.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
			?? [];

		if (nameParts.Length == 0)
			return "U";

		var firstInitial = char.ToUpperInvariant(nameParts[0][0]);
		if (nameParts.Length == 1)
			return firstInitial.ToString();

		var lastInitial = char.ToUpperInvariant(nameParts[^1][0]);
		return $"{firstInitial}{lastInitial}";
	}

    private void GoBackToOnePlatform()
    {
        NavigationManager.NavigateTo("/");
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
        Theme.OnChanged -= HandleThemeChanged;
    }
}
