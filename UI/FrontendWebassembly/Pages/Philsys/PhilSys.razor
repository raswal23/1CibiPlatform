@page "/philsys/idv"
@layout MainLayout
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inherits SecurePageBase
@attribute [RequirePermission(2, 2)]
@* philsys/idv *@

<PageTitle>Identity Verification System</PageTitle>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="12" Class="philsys-lookup-shell">

        <PhilSysFormTabComponent ActiveTabChanged="ChangeActiveTab" />

        @if (_activeIndex == 0)
        {
            <BasicInformationFormComponent />
        }
        else if (_activeIndex == 1)
        {
            <PhilSysCardNumbeFormComponent />
        }

    </MudItem>
</MudGrid>
