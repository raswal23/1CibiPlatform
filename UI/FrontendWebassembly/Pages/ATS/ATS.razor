@page "/s&i/ats"
@layout MainLayout
@inherits SecurePageBase
@attribute [RequirePermission(6, 7)]


<MudContainer Class="pa-0">

    <div class="d-flex align-center mb-3" style="gap:12px; align-items:center;">
        <div>
            <MudText Typo="Typo.h5" Class="mb-0 gradient-text" Style="font-weight: 700;">@($"{ATSname}")</MudText>
        </div>
        <MudImage Src="/images/generic/cibi-icon.png" Alt="logo" Style="width:48px; height:48px;" />
    </div>

    <ATSTabComponent ActiveTabChanged="ChangeActiveTab" />

    @if (_isLoading)
    {
        <div class="d-flex justify-center align-center" style="height:300px;">
            <LoaderComponent />
        </div>
    }
    else
    {
        @* @if (_activeIndex == 0)
        {
            <PageTitle>@($"{ATSname} - Dashboard")</PageTitle>

            <ATSDashboardComponent />
        } *@
        if (_activeIndex == 1)
        {
            <PageTitle>@($"{ATSname} - Dispute Order")</PageTitle>

            <DisputeOrderComponent />
        }
        else if (_activeIndex == 2)
        {
            <PageTitle>@($"{ATSname} - New Order")</PageTitle>

            <NewOrderComponent />
        }
        else if (_activeIndex == 3)
        {
            <PageTitle>@($"{ATSname} - Search Report")</PageTitle>

            <SearchReportComponent />
        }
        else if (_activeIndex == 4)
        {
            <PageTitle>@($"{ATSname} - Upload Report")</PageTitle>

            <UploadReportComponent />
        }
        @* else if (_activeIndex == 5)
        {
            <PageTitle>@($"{ATSname} - Invoice")</PageTitle>

            <InvoiceComponent />
        } *@
    }

</MudContainer>
