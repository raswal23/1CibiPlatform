@layout GenericLayout
@inject IApplicationFormService ATSService
@inject IJSRuntime JSRuntime
@page "/s&i/ats/applicationform/{HashToken}"

<PageTitle>ATS - Application Form</PageTitle>

<NavigationLock ConfirmExternalNavigation="true"
                OnBeforeInternalNavigation="ConfirmNavigation" />

<div class="@RootCssClass">
    @if (_initError is not null)
    {
        <ErrorDialogComponent Message="@_initError" />
    }
    else if (string.Equals(Status, "Done", StringComparison.OrdinalIgnoreCase))
    {
        <CompletedComponent />
    }
    else if (string.Equals(Status, "Withdrawn", StringComparison.OrdinalIgnoreCase))
    {
        <WithdrawnComponent />
    }
    else if (IsInstructionsVisible)
    {
        <main class="ats-application-intro-page">
            <article class="ats-application-intro-card" aria-labelledby="ats-application-intro-title">
                <header class="ats-application-intro-header">
                    <span class="ats-application-logo-badge" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                            <path d="M3.3 6.9 12 12l8.7-5.1M12 22V12" />
                        </svg>
                    </span>
                    <h1 id="ats-application-intro-title">WFS Talent Suite</h1>
                </header>

                <div class="ats-application-intro-body">
                    <p class="ats-application-intro-lead">Thank you for acknowledging our email.</p>
                    <p class="ats-application-intro-copy">
                        We are CIBI Information, Inc., a third-party verification company engaged by a firm with whom you have either an ongoing job application or currently employed to conduct background checks. Please provide all required documents and information as outlined in the email you received.
                    </p>

                    <section class="ats-application-section" aria-labelledby="ats-document-title">
                        <div class="ats-application-section-title">
                            <span class="ats-application-section-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5" />
                                    <path d="M4 16v2.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V16" />
                                </svg>
                            </span>
                            <h2 id="ats-document-title">Prepare &amp; upload documents</h2>
                        </div>
                        <p class="ats-application-section-copy">
                            Please ensure you have clear digital copies of the following required documents ready for upload.
                            <strong>Every file must be in PDF format</strong> &mdash; the form does not accept any other file type,
                            so please convert or scan your documents to PDF before you begin.
                        </p>

                        <ol class="ats-application-document-list">
                            <li><span class="ats-application-document-index">1</span><span>All, or any in case of unavailability: Transcript of Records (TOR), Diploma, or Certificate of Graduation</span></li>
                            <li><span class="ats-application-document-index">2</span><span>Birth certificate</span></li>
                            <li><span class="ats-application-document-index">3</span><span>One (1) valid government-issued ID</span></li>
                            <li><span class="ats-application-document-index">4</span><span>Certificate of Employment (COE) covering all previous employment within the past 5 years (if applicable)</span></li>
                            <li><span class="ats-application-document-index">5</span><span>Upload CV in the TOR / Diploma / School Credentials portion of the form</span></li>
                        </ol>
                    </section>

                    <section class="ats-application-section" aria-labelledby="ats-reminder-title">
                        <div class="ats-application-section-title">
                            <span class="ats-application-section-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m9 12 2 2 4-4" />
                                    <circle cx="12" cy="12" r="9" />
                                </svg>
                            </span>
                            <h2 id="ats-reminder-title">Reminders in answering the form</h2>
                        </div>

                        @* This page is now the ONLY place the candidate is told how to fill the form in.
                           The invitation and follow-up emails used to carry the same list; they no longer
                           do - they just link here - so anything a candidate must know before starting
                           has to be stated on this page. *@
                        <div class="ats-application-reminder-block">
                            <h3>Uploading your documents</h3>
                            <ul class="ats-application-reminder-list">
                                <li><strong>All documents you upload must be in PDF format.</strong> The form only accepts PDF files, so please convert or scan your documents before uploading them.</li>
                                <li>Make sure every page is clear and readable, and that the whole document is captured in the file.</li>
                                <li>Upload your CV in the TOR / Diploma / School Credentials portion of the form.</li>
                            </ul>
                        </div>

                        <div class="ats-application-reminder-block">
                            <h3>Application form</h3>
                            <ul class="ats-application-reminder-list">
                                <li>Provide all information requested and affix signatures where needed.</li>
                                <li>Answer every field, even if it is non-mandatory.</li>
                                <li>If the form asks for the email address of an HR point of contact, kindly input your HR person of contact at the company you are applying to.</li>
                                <li>Enter details for your references. You must provide three (3) references (not relatives). They should be colleagues, former superiors, or friends.</li>
                                <li>Inform each reference in advance that you have shared their information and that they will be contacted by CIBI.</li>
                                <li>Double-check your answers to ensure accuracy (dates, names, employer details, etc.) before submitting.</li>
                            </ul>
                        </div>
                    </section>

                    <aside class="ats-application-notice" aria-label="Important response information">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M10.3 3.9 2.8 17.1a1.8 1.8 0 0 0 1.6 2.7h15.2a1.8 1.8 0 0 0 1.6-2.7L13.7 3.9a1.8 1.8 0 0 0-3.4 0Z" />
                            <path d="M12 9v4m0 4h.01" />
                        </svg>
                        <p>
                            Your prompt response to this request is critical to the success of your job application. Rest assured that all information you provide will be kept confidential in compliance with Philippine laws, including the Data Privacy Act, and will only be used for processing your application. For questions or concerns, reach out via our support chat, or call us at <a href="tel:+639230878757">+63 923 087 8757</a> (Sun) or <a href="tel:+639176320486">+63 917 632 0486</a> (Globe).
                        </p>
                    </aside>

                    <footer class="ats-application-intro-footer">
                        <button type="button" class="ats-application-proceed-button" @onclick="ShowApplicationForm">
                            <span>Proceed</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14m-6-6 6 6-6 6" />
                            </svg>
                        </button>
                    </footer>
                </div>
            </article>
        </main>
    }
    else
    {
        <ApplicationFormComponent IsWithDrawn="SetWithdrawnStatus"
                                  HasChangesChanged="SetDirtyState"
                                  EmailId="@EmailId"
                                  ActiveStep="@_stepActive"
                                  ShowsPhilSys="@_showPhilsys"
                                  HashToken="@HashToken"
                                  OrderDateOfBirth="@_orderDateOfBirth" />
    }
</div>
