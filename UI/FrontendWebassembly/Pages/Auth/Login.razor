@page "/login"
@page "/register"
@page "/forgot-password"
@layout ConsoleLayout
@inject NavigationManager Navigation
@inject IAuthService IAuthService
@inject LocalStorageService LocalStorageService
@inject EmailValidationService EmailValidationService

@if (!_isLoading)
{
    <main class="auth-page" @onclick="HandleSecretClick">
        <div class="@GetAuthCardClass()">
            <section class="auth-panel auth-login-panel"
                     aria-hidden="@(isRegisterMode || isForgotPasswordMode || isSecretMode)"
                     inert="@(isRegisterMode || isForgotPasswordMode || isSecretMode ? string.Empty : null)">
                <div class="auth-content">
                    <div class="auth-icon-badge" aria-hidden="true">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <rect x="4" y="10" width="16" height="10" rx="2" />
                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                        </svg>
                    </div>

                    <h1>One Platform</h1>
                    <p class="auth-subtitle">Sign in to your account to continue</p>

                    @if (!isLoginUserValid)
                    {
                        <MudAlert Severity="Severity.Error"
                                  Elevation="0"
                                  Variant="Variant.Filled"
                                  Class="auth-alert">
                            @loginErrorMessage
                        </MudAlert>
                    }

                    <MudForm @ref="loginForm"
                             @bind-IsValid="@loginFormValid"
                             OnEnterPressed="HandleLoginEnter">
                        <div class="auth-field">
                            <label>Email <span>*</span></label>
                            <div class="auth-input-wrap">
                                <svg class="auth-leading-icon"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     aria-hidden="true">
                                    <rect x="3" y="5.5" width="18" height="13" rx="2.4" />
                                    <path d="M4 7l8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <MudTextField @bind-Value="loginEmail"
                                              Placeholder="juandelacruz@cibi.com.ph"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Required="true"
                                              RequiredError="Email is required"
                                              InputType="InputType.Email"
                                              Validation="@((string value) => EmailValidationService.ValidateEmail(value))"
                                              Class="auth-input"
                                              autocomplete="username"
                                              aria-label="Email" />
                            </div>
                        </div>

                        <div class="auth-field">
                            <label>Password <span>*</span></label>
                            <div class="auth-input-wrap has-trailing">
                                <svg class="auth-leading-icon"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     aria-hidden="true">
                                    <rect x="4" y="10" width="16" height="10" rx="2" />
                                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                </svg>
                                <MudTextField @bind-Value="loginPassword"
                                              Placeholder="••••••••"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Required="true"
                                              RequiredError="Password is required"
                                              InputType="@loginPasswordInput"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@loginPasswordIcon"
                                              OnAdornmentClick="ToggleLoginPasswordVisibility"
                                              AdornmentAriaLabel="Show password"
                                              Class="auth-input"
                                              autocomplete="current-password"
                                              aria-label="Password" />
                            </div>
                        </div>

                        <div class="auth-row-between">
                            <MudCheckBox @bind-Value="rememberMe"
                                         Label="Remember me"
                                         Color="Color.Primary"
                                         Dense="true"
                                         Class="auth-remember" />
                            <button type="button" class="auth-link auth-link-button" @onclick="ShowForgotPassword" @onclick:stopPropagation="true">
                                Forgot password?
                            </button>
                        </div>

                        <div @onclick:stopPropagation="true">
                            <ButtonComponent ButtonType="ButtonType.Submit"
                                             OnClick="HandleLogin"
                                             Disabled="@(!loginFormValid || isLoginLoading)"
                                             Class="auth-submit">
                                @if (isLoginLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <span>Sign In</span>
                                }
                            </ButtonComponent>
                        </div>
                    </MudForm>

                    <p class="auth-footer-line">
                        Don't have an account?
                        <button type="button" class="auth-inline-link" @onclick="ShowRegister" @onclick:stopPropagation="true">Sign up</button>
                    </p>
                </div>
            </section>

            <section class="auth-panel auth-forgot-panel"
                     aria-hidden="@(!isForgotPasswordMode)"
                     inert="@(!isForgotPasswordMode ? string.Empty : null)">
                <div class="auth-content auth-forgot-content">
                    <div class="auth-icon-badge" aria-hidden="true">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <rect x="4" y="10" width="16" height="10" rx="2" />
                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                        </svg>
                    </div>

                    <h1>One Platform</h1>
                    <p class="auth-subtitle auth-forgot-subtitle">
                        Enter the email associated with your account and we'll send you a link to reset your password.
                    </p>

                    @if (!isForgotPasswordUserValid)
                    {
                        <MudAlert Severity="Severity.Error"
                                  Elevation="0"
                                  Variant="Variant.Filled"
                                  Class="auth-alert">
                            @forgotPasswordErrorMessage
                        </MudAlert>
                    }

                    @if (isForgotPasswordSuccess)
                    {
                        <MudAlert Severity="Severity.Success"
                                  Elevation="0"
                                  Variant="Variant.Filled"
                                  Class="auth-alert">
                            @forgotPasswordSuccessMessage
                        </MudAlert>
                    }

                    <MudForm @ref="forgotPasswordForm"
                             @bind-IsValid="@forgotPasswordFormValid"
                             OnEnterPressed="HandleForgotPasswordEnter">
                        <div class="auth-field auth-forgot-field">
                            <label>Email <span>*</span></label>
                            <div class="auth-input-wrap">
                                <svg class="auth-leading-icon"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     aria-hidden="true">
                                    <rect x="3" y="5.5" width="18" height="13" rx="2.4" />
                                    <path d="M4 7l8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <MudTextField @bind-Value="forgotPasswordEmail"
                                              Placeholder="juandelacruz@cibi.com.ph"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Required="true"
                                              RequiredError="Email is required"
                                              InputType="InputType.Email"
                                              Validation="@((string value) => EmailValidationService.ValidateEmail(value))"
                                              Class="auth-input"
                                              aria-label="Email" />
                            </div>
                        </div>

                        <div @onclick:stopPropagation="true">
                        <ButtonComponent ButtonType="ButtonType.Submit"
                                         OnClick="HandleForgotPassword"
                                         Disabled="@(!forgotPasswordFormValid || isForgotPasswordLoading)"
                                         Class="auth-submit">
                            @if (isForgotPasswordLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span> Sending...</span>
                            }
                            else
                            {
                                <svg class="auth-submit-icon"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2.2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">
                                    <path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z" />
                                </svg>
                                <span>Send reset link</span>
                            }
                        </ButtonComponent>
                        </div>
                    </MudForm>

                    <p class="auth-footer-line">
                        Remembered your password?
                        <button type="button" class="auth-inline-link" @onclick="ShowLogin" @onclick:stopPropagation="true">Sign in</button>
                    </p>
                </div>
            </section>

            <section class="auth-panel auth-register-panel"
                     aria-hidden="@(!isRegisterMode)"
                     inert="@(!isRegisterMode ? string.Empty : null)">
                <div class="auth-content auth-register-content">
                    <div class="auth-icon-badge" aria-hidden="true">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <circle cx="12" cy="8" r="3.4" />
                            <path d="M4.5 20c0-3.9 3.1-6.8 7.5-6.8s7.5 2.9 7.5 6.8" />
                            <path d="M18 8h4M20 6v4" stroke-linecap="round" />
                        </svg>
                    </div>

                    <h1>One Platform</h1>
                    <p class="auth-subtitle">Create your account to get started</p>

                    @if (!isRegisterUserValid)
                    {
                        <MudAlert Severity="Severity.Error"
                                  Elevation="0"
                                  Variant="Variant.Filled"
                                  Class="auth-alert">
                            @registerErrorMessage
                        </MudAlert>
                    }

                    <MudForm @ref="registerForm" @bind-IsValid="@registerFormValid">
                        <div class="auth-field-row">
                            <div class="auth-field">
                                <label>First name <span>*</span></label>
                                <div class="auth-input-wrap">
                                    <svg class="auth-leading-icon auth-person-icon"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         aria-hidden="true">
                                        <path d="M4 20c0-3.6 2.8-6.4 6.5-6.4h3c3.7 0 6.5 2.8 6.5 6.4" stroke-linecap="round" />
                                        <circle cx="12" cy="8" r="3.4" />
                                    </svg>
                                    <MudTextField @bind-Value="firstName"
                                                  Placeholder="Juan"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Required="true"
                                                  RequiredError="First name is required"
                                                  Class="auth-input"
                                                  aria-label="First name" />
                                </div>
                            </div>

                            <div class="auth-field">
                                <label>Last name <span>*</span></label>
                                <div class="auth-input-wrap">
                                    <svg class="auth-leading-icon auth-person-icon"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         aria-hidden="true">
                                        <path d="M4 20c0-3.6 2.8-6.4 6.5-6.4h3c3.7 0 6.5 2.8 6.5 6.4" stroke-linecap="round" />
                                        <circle cx="12" cy="8" r="3.4" />
                                    </svg>
                                    <MudTextField @bind-Value="lastName"
                                                  Placeholder="Dela Cruz"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Required="true"
                                                  RequiredError="Last name is required"
                                                  Class="auth-input"
                                                  aria-label="Last name" />
                                </div>
                            </div>
                        </div>

                        <div class="auth-field">
                            <label>Middle name <em>(Optional)</em></label>
                            <div class="auth-input-wrap">
                                <svg class="auth-leading-icon auth-person-icon"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     aria-hidden="true">
                                    <path d="M4 20c0-3.6 2.8-6.4 6.5-6.4h3c3.7 0 6.5 2.8 6.5 6.4" stroke-linecap="round" />
                                    <circle cx="12" cy="8" r="3.4" />
                                </svg>
                                <MudTextField @bind-Value="middleName"
                                              Placeholder="Santos"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="auth-input"
                                              aria-label="Middle name" />
                            </div>
                        </div>

                        <div class="auth-field">
                            <label>Email <span>*</span></label>
                            <div class="auth-input-wrap">
                                <svg class="auth-leading-icon"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     aria-hidden="true">
                                    <rect x="3" y="5.5" width="18" height="13" rx="2.4" />
                                    <path d="M4 7l8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <MudTextField @bind-Value="registerEmail"
                                              Placeholder="juan.delacruz@email.com"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Required="true"
                                              RequiredError="Email is required"
                                              InputType="InputType.Email"
                                              Validation="@((string value) => EmailValidationService.ValidateEmail(value))"
                                              Class="auth-input"
                                              autocomplete="off"
                                              aria-label="Email" />
                            </div>
                        </div>

                        <div class="auth-field-row">
                            <div class="auth-field">
                                <label>Password <span>*</span></label>
                                <div class="auth-input-wrap has-trailing">
                                    <svg class="auth-leading-icon"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         aria-hidden="true">
                                        <rect x="4" y="10" width="16" height="10" rx="2" />
                                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                    </svg>
                                    <MudTextField @bind-Value="registerPassword"
                                                  @bind-Value:after="RevalidateConfirmPassword"
                                                  Placeholder="••••••••"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true"
                                                  Required="true"
                                                  RequiredError="Password is required"
                                                  InputType="@registerPasswordInput"
                                                  Validation="@((string value) => ValidatePassword(value))"
                                                  Adornment="Adornment.End"
                                                  AdornmentIcon="@registerPasswordIcon"
                                                  OnAdornmentClick="ToggleRegisterPasswordVisibility"
                                                  AdornmentAriaLabel="Show password"
                                                  Class="auth-input"
                                                  autocomplete="new-password"
                                                  aria-label="Password" />
                                </div>
                            </div>

                            <div class="auth-field">
                                <label>Confirm password <span>*</span></label>
                                <div class="auth-input-wrap has-trailing">
                                    <svg class="auth-leading-icon"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         aria-hidden="true">
                                        <rect x="4" y="10" width="16" height="10" rx="2" />
                                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                    </svg>
                                    <MudTextField @ref="confirmPasswordField"
                                                  @bind-Value="confirmPassword"
                                                  Placeholder="••••••••"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true"
                                                  Required="true"
                                                  RequiredError="Please confirm your password"
                                                  InputType="@confirmPasswordInput"
                                                  Validation="@((string value) => ValidateConfirmPassword(value))"
                                                  Adornment="Adornment.End"
                                                  AdornmentIcon="@confirmPasswordIcon"
                                                  OnAdornmentClick="ToggleConfirmPasswordVisibility"
                                                  AdornmentAriaLabel="Show password"
                                                  Class="auth-input"
                                                  autocomplete="new-password"
                                                  aria-label="Confirm password" />
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(registerPassword))
                        {
                            <div class="auth-strength-slot">
                                <PasswordStrengthComponent Password="@registerPassword" />
                            </div>
                        }

                        <div @onclick:stopPropagation="true">
                            <ButtonComponent ButtonType="ButtonType.Submit"
                                             OnClick="HandleRegister"
                                             Disabled="@(!registerFormValid || isRegisterLoading)"
                                             Class="auth-submit auth-register-submit">
                                @if (isRegisterLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <span>Create Account</span>
                                }
                            </ButtonComponent>
                        </div>
                    </MudForm>

                    <p class="auth-footer-line">
                        Already have an account?
                        <button type="button" class="auth-inline-link" @onclick="ShowLogin" @onclick:stopPropagation="true">Sign in</button>
                    </p>
                </div>
            </section>

            <section class="auth-panel auth-page-panel auth-front"
                     aria-hidden="@(isRegisterMode || isSecretMode)"
                     inert="@(isRegisterMode || isSecretMode ? string.Empty : null)">
                <div class="auth-content">
                    @if (isForgotPasswordMode)
                    {
                        <div class="auth-icon-badge ghost" aria-hidden="true">
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8">
                                <rect x="4" y="10" width="16" height="10" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                            </svg>
                        </div>
                        <h1>Welcome Back!</h1>
                        <p>Remembered your password? Return to sign in and continue to One Platform.</p>
                        <button type="button" class="auth-ghost-button" @onclick="ShowLogin" @onclick:stopPropagation="true">Sign In</button>
                    }
                    else
                    {
                        <div class="auth-icon-badge ghost" aria-hidden="true">
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8">
                                <circle cx="12" cy="8" r="3.4" />
                                <path d="M4.5 20c0-3.9 3.1-6.8 7.5-6.8s7.5 2.9 7.5 6.8" />
                                <path d="M18 8h4M20 6v4" stroke-linecap="round" />
                            </svg>
                        </div>
                        <h1>Hello, Friend!</h1>
                        <p>Enter your personal details and start your journey with One Platform.</p>
                        <button type="button" class="auth-ghost-button" @onclick="ShowRegister" @onclick:stopPropagation="true">Sign Up</button>
                    }
                </div>
            </section>

            <section class="auth-panel auth-page-panel auth-back"
                     aria-hidden="@(!isRegisterMode && !isSecretMode)"
                     inert="@(!isRegisterMode && !isSecretMode ? string.Empty : null)">
                <div class="auth-content">
                    <div class="auth-icon-badge ghost" aria-hidden="true">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <rect x="4" y="10" width="16" height="10" rx="2" />
                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                        </svg>
                    </div>
                    <h1>Welcome Back!</h1>
                    <p>To keep connected with us, please sign in with your personal info.</p>
                    <button type="button" class="auth-ghost-button" @onclick="ShowLogin" @onclick:stopPropagation="true">Sign In</button>
                </div>
            </section>

            @* The closed book's leather front cover (easter egg) - and the credits page
               in one: the author names burn in gold-framed leather once the pages have
               clapped shut around it. The whole cover is the way back: any click (or
               Enter/Space, it stands in for the old Flip Back button) unfolds the book
               and returns to the login. *@
            <section class="auth-cover-panel"
                     role="button"
                     tabindex="@(isSecretMode ? 0 : -1)"
                     aria-label="Flip the book back open to return to sign in"
                     aria-hidden="@(!isSecretMode)"
                     inert="@(!isSecretMode ? string.Empty : null)"
                     @onclick="CloseSecretPage"
                     @onclick:stopPropagation="true"
                     @onkeydown="HandleCoverKeyDown">
                <div class="auth-secret-embers" aria-hidden="true">
                    @for (var i = 0; i < 120; i++)
                    {
                        <span style="@GetEmberStyle(i)"></span>
                    }
                </div>
                <div class="auth-cover-frame">
                    <div class="auth-cover-emblem" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.5 2.5c-4.6.4-8.4 2-11 4.6-2.1 2.1-3.4 4.8-3.9 7.9l-1.9 5.6c-.1.4 0 .8.3 1.1.3.3.7.4 1.1.3l3.3-1.1.9.9 1.4-1.4-.9-.9.7-2.1c.2.1.5.1.8.1 2.5 0 4.9-1.1 7-3.2 2.6-2.6 4.2-6.4 4.6-11 0-.3-.1-.5-.3-.7-.2-.2-.4-.3-.7-.3l-1.4.2zm-2 3.9c-.4 2.9-1.5 5.3-3.2 7-1.6 1.6-3.3 2.4-5 2.4h-.2l6.2-6.2-1.4-1.4-6.2 6.2c.3-1.9 1.2-3.7 2.6-5.1 1.7-1.7 4.1-2.8 7-3.2l.2.3z" />
                        </svg>
                    </div>
                    <h2 class="auth-cover-title">Crafted By</h2>
                    <ul class="auth-secret-authors">
                        <li>
                            <span class="auth-secret-author-name">Russel Gutierrez</span>
                            <span class="auth-secret-author-role">Lead Developer</span>
                        </li>
                        <li>
                            <span class="auth-secret-author-name">Renzy Gutierrez</span>
                            <span class="auth-secret-author-role">Software Developer</span>
                        </li>
                        <li>
                            <span class="auth-secret-author-name">Siegmund Valdemoro</span>
                            <span class="auth-secret-author-role">Software Developer</span>
                        </li>
                        <li>
                            <span class="auth-secret-author-name">Christian Lorenzo Evangelista</span>
                            <span class="auth-secret-author-role">Project Manager</span>
                        </li>
                    </ul>
                </div>
                <span class="auth-cover-spine" aria-hidden="true"></span>
            </section>
        </div>
    </main>
}
else
{
    <CibiLoaderComponent />
}
