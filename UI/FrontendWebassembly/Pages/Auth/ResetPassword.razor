@page "/reset-password"
@layout GenericLayout
@inject NavigationManager Navigation
@inject IAuthService IAuthService
@inject LocalStorageService LocalStorageService

@if (!isLoading)
{
    <main class="reset-password-page">
        <section class="reset-password-card">
            <div class="reset-password-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">
                    <rect x="4" y="10" width="16" height="10" rx="2" />
                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                </svg>
            </div>

            <h1>One Platform</h1>
            <p class="reset-password-subtitle">Choose a new password for your account</p>

            @if (!isUserValid)
            {
                <MudAlert Severity="Severity.Error"
                          Elevation="0"
                          Variant="Variant.Filled"
                          Class="reset-password-alert">
                    @errorMessage
                </MudAlert>
            }

            @if (isValidationError)
            {
                <MudAlert Severity="Severity.Error"
                          Elevation="0"
                          Variant="Variant.Filled"
                          Class="reset-password-alert">
                    @errorMessage
                </MudAlert>
            }

            @if (isSuccess)
            {
                <MudAlert Severity="Severity.Success"
                          Elevation="0"
                          Variant="Variant.Filled"
                          Class="reset-password-alert">
                    Your password has been reset successfully. Redirecting to login in @redirectCountdown seconds...
                </MudAlert>
            }

            @if (tokenValid && isUserValid && !isSuccess)
            {
                <MudForm @ref="form"
                         @bind-IsValid="@formValid"
                         OnEnterPressed="HandleResetPasswordEnter">
                    <div class="reset-password-field">
                        <label>New password <span>*</span></label>
                        <div class="reset-password-input-wrap">
                            <svg class="reset-password-leading-icon"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 aria-hidden="true">
                                <rect x="4" y="10" width="16" height="10" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                            </svg>
                            <MudTextField @bind-Value="newPassword"
                                          Placeholder="••••••••"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          MaxLength="100"
                                          Required="true"
                                          RequiredError="Password is required"
                                          InputType="@passwordInput"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@passwordIcon"
                                          OnAdornmentClick="TogglePasswordVisibility"
                                          AdornmentAriaLabel="Show password"
                                          Validation="@(new Func<string, string>(ValidatePassword))"
                                          Class="reset-password-input"
                                          aria-label="New password" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(newPassword))
                    {
                        <div class="reset-password-strength-slot">
                            <PasswordStrengthComponent Password="@newPassword" />
                        </div>
                    }

                    <div class="reset-password-field">
                        <label>Confirm password <span>*</span></label>
                        <div class="reset-password-input-wrap">
                            <svg class="reset-password-leading-icon"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 aria-hidden="true">
                                <rect x="4" y="10" width="16" height="10" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                            </svg>
                            <MudTextField @bind-Value="confirmPassword"
                                          Placeholder="••••••••"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          MaxLength="100"
                                          Required="true"
                                          RequiredError="Confirm password is required"
                                          InputType="@passwordInput"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@passwordIcon"
                                          OnAdornmentClick="TogglePasswordVisibility"
                                          AdornmentAriaLabel="Show password"
                                          Validation="@(new Func<string, string>(ValidateConfirmPassword))"
                                          Class="reset-password-input"
                                          aria-label="Confirm password" />
                        </div>
                    </div>

                    <ButtonComponent ButtonType="ButtonType.Submit"
                                     OnClick="HandleResetPassword"
                                     Disabled="@(!formValid || isButtonLoading || isDisable)"
                                     Class="reset-password-submit">
                        @if (isButtonLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span> Resetting...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2.2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M20 6 9 17l-5-5" />
                            </svg>
                            <span>Reset password</span>
                        }
                    </ButtonComponent>
                </MudForm>
            }

            <a href="/login" class="reset-password-back-link">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.4"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M19 12H5M11 18l-6-6 6-6" />
                </svg>
                Back to Sign in
            </a>
        </section>
    </main>
}
else
{
    <CibiLoaderComponent />
}
