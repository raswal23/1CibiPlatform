@page "/verify-otp"
@layout GenericLayout
@inject NavigationManager Navigation
@inject IAuthService IAuthService
@inject IJSRuntime JSRuntime
@inject LocalStorageService LocalStorageService

<NavigationLock ConfirmExternalNavigation="true"
                OnBeforeInternalNavigation="ConfirmNavigation" />

@if (!_isLoading)
{
    <main class="otp-page">
        <section class="otp-card">
            <div class="otp-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M12 2l7.5 3.3v6c0 5.2-3.2 8.7-7.5 10.7-4.3-2-7.5-5.5-7.5-10.7v-6L12 2z" />
                    <path d="M9 12l2 2 4-4" />
                </svg>
            </div>

            <h1>Verify Your Email</h1>
            <p class="otp-subtitle">
                Enter the verification code sent to <strong>@email</strong>
            </p>

            @if (!isOtpValid)
            {
                <div class="otp-banner error" role="alert">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         aria-hidden="true">
                        <path d="M10.3 3.9 2.8 17.1a1.8 1.8 0 0 0 1.6 2.7h15.2a1.8 1.8 0 0 0 1.6-2.7L13.7 3.9a1.8 1.8 0 0 0-3.4 0z" />
                        <path d="M12 9v4M12 17h.01" />
                    </svg>
                    <span>@errorMessage</span>
                </div>
            }

            @if (showSuccessMessage)
            {
                <div class="otp-banner success" role="status">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2.4"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M5 12l5 5L20 7" />
                    </svg>
                    <span>
                        Email verified successfully! Redirecting to login in @redirectCountdown seconds...
                    </span>
                </div>
            }

            @if (isResendSuccess)
            {
                <div class="otp-banner success" role="status">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2.4"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M5 12l5 5L20 7" />
                    </svg>
                    <span>New OTP has been sent to your email.</span>
                </div>
            }

            <div class="otp-field-label">
                Verification code <span>*</span>
            </div>

            <div class="@GetOtpBoxesClass()"
                 role="group"
                 aria-label="Six-digit verification code">
                <input @ref="otpInput1"
                       value="@otpDigits[0]"
                       @oninput="@(args => UpdateOtpDigitAsync(0, args))"
                       @onkeydown="@(args => HandleOtpKeyDownAsync(0, args))"
                       class="otp-box"
                       maxlength="1"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       autocomplete="one-time-code"
                       aria-label="Verification code digit 1"
                       disabled="@isDone"
                       autofocus />
                <input @ref="otpInput2"
                       value="@otpDigits[1]"
                       @oninput="@(args => UpdateOtpDigitAsync(1, args))"
                       @onkeydown="@(args => HandleOtpKeyDownAsync(1, args))"
                       class="otp-box"
                       maxlength="1"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       aria-label="Verification code digit 2"
                       disabled="@isDone" />
                <input @ref="otpInput3"
                       value="@otpDigits[2]"
                       @oninput="@(args => UpdateOtpDigitAsync(2, args))"
                       @onkeydown="@(args => HandleOtpKeyDownAsync(2, args))"
                       class="otp-box"
                       maxlength="1"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       aria-label="Verification code digit 3"
                       disabled="@isDone" />
                <input @ref="otpInput4"
                       value="@otpDigits[3]"
                       @oninput="@(args => UpdateOtpDigitAsync(3, args))"
                       @onkeydown="@(args => HandleOtpKeyDownAsync(3, args))"
                       class="otp-box"
                       maxlength="1"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       aria-label="Verification code digit 4"
                       disabled="@isDone" />
                <input @ref="otpInput5"
                       value="@otpDigits[4]"
                       @oninput="@(args => UpdateOtpDigitAsync(4, args))"
                       @onkeydown="@(args => HandleOtpKeyDownAsync(4, args))"
                       class="otp-box"
                       maxlength="1"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       aria-label="Verification code digit 5"
                       disabled="@isDone" />
                <input @ref="otpInput6"
                       value="@otpDigits[5]"
                       @oninput="@(args => UpdateOtpDigitAsync(5, args))"
                       @onkeydown="@(args => HandleOtpKeyDownAsync(5, args))"
                       class="otp-box"
                       maxlength="1"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       aria-label="Verification code digit 6"
                       disabled="@isDone" />
            </div>

            @if (!isOtpValid)
            {
                <div class="otp-field-error">@errorMessage</div>
            }
            else
            {
                <div class="otp-field-spacer" aria-hidden="true"></div>
            }

            <div class="otp-actions">
                <ButtonComponent ButtonType="ButtonType.Button"
                                 OnClick="HandleResendOtp"
                                 Disabled="@(isLoading || isDone)"
                                 Variant="Variant.Outlined"
                                 Class="otp-resend-button">
                    @if (isLoading && isResendLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <span>Resend OTP</span>
                    }
                </ButtonComponent>

                <ButtonComponent ButtonType="ButtonType.Button"
                                 OnClick="HandleVerifyOtp"
                                 Disabled="@(!IsOtpComplete || isLoading || isDone)"
                                 Class="@GetVerifyButtonClass()">
                    @if (isLoading && !isResendLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2.2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="M20 6 9 17l-5-5" />
                        </svg>
                        <span>Verify email</span>
                    }
                </ButtonComponent>
            </div>

            <p class="otp-footer">
                Wrong email? <a href="/register">Go back to registration</a>
            </p>
        </section>
    </main>
}
else
{
    <LoaderComponent />
}
