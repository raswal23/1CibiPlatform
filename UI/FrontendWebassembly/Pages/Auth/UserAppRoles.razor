@page "/settings/usermanagement"
@layout MainLayout
@inject IUserManagementService UserManagementService
@inherits CrudPageBase
@inject IConfiguration Configuration
@attribute [RequirePermission(3, 3)]
<div class="user-app-roles-page">
    <nav class="user-management-tab-shell" aria-label="User management sections">
        <div class="user-management-tab-strip" role="tablist">
            <button type="button" role="tab" aria-selected="@(_activeIndex == 0)" class="@GetTabButtonClass(0)" @onclick="@(() => SelectTab(0))">Locked User</button>
            <button type="button" role="tab" aria-selected="@(_activeIndex == 1)" class="@GetTabButtonClass(1)" @onclick="@(() => SelectTab(1))">Approval</button>
            <button type="button" role="tab" aria-selected="@(_activeIndex == 2)" class="@GetTabButtonClass(2)" @onclick="@(() => SelectTab(2))">User</button>
            <button type="button" role="tab" aria-selected="@(_activeIndex == 3)" class="@GetTabButtonClass(3)" @onclick="@(() => SelectTab(3))">Application</button>
            <button type="button" role="tab" aria-selected="@(_activeIndex == 4)" class="@GetTabButtonClass(4)" @onclick="@(() => SelectTab(4))">SubMenu</button>
            <button type="button" role="tab" aria-selected="@(_activeIndex == 5)" class="@GetTabButtonClass(5)" @onclick="@(() => SelectTab(5))">Role</button>
            <button type="button" role="tab" aria-selected="@(_activeIndex == 6)" class="@GetTabButtonClass(6)" @onclick="@(() => SelectTab(6))">User's AppSubRole</button>
        </div>
    </nav>
@if (_activeIndex == 0)
{
    <TableComponent TItem="LockedUsersDTO"
                    ContainerClass="user-management-panel"
                    @ref="lockedUsersTable"
                    Title="Locked User/s"
                    CountLabel="locked users"
                    EnableSearch="true"
                    SearchLabel=""
                    SearchPlaceholder="Search locked users..."
                    LoadServerData="LoadLockedUsersServerData"
                    CursorPagerState="_lockedUsersLoader"
                    SearchString="@searchStringLockedUser"
                    ColumnCount="4"
                    SearchStringChanged="@((string val) => searchStringLockedUser = val)">
        <HeaderTemplate>
            <MudTh>Email</MudTh>
            <MudTh>Locked At</MudTh>
            <MudTh>Lock Release At</MudTh>
            <MudTh Class="um-actions-col">Unlock</MudTh>
        </HeaderTemplate>

        <RowTemplate Context="lockeduser">
            <MudTd DataLabel="Email">@lockeduser.Email</MudTd>
            <MudTd DataLabel="Locked At">@lockeduser.CreatedAt</MudTd>
            <MudTd DataLabel="Locked Release At">@lockeduser.LockReleaseAt</MudTd>
            <MudTd DataLabel="Unlock" Class="um-actions-col">
                <MudIconButton Icon="@Icons.Material.Filled.LockOpen" Color="Color.Error" Size="Size.Medium"
                               Class="um-icon-action um-icon-action-danger"
                               OnClick="@(() => ConfirmUnlockAccount(lockeduser.UserId))"></MudIconButton>
            </MudTd>
        </RowTemplate>

        <NoRecordsTemplate>
            <div class="um-empty-state" role="status">
                <MudIcon Icon="@Icons.Material.Outlined.Lock" />
                <strong>No locked users</strong>
                <span>Locked accounts will appear here.</span>
            </div>
        </NoRecordsTemplate>
    </TableComponent>
}
else if (_activeIndex == 1)
{
    <TableComponent TItem="UnApprovedUsersDTO"
                    ContainerClass="user-management-panel"
                    @ref="unapprovedUsersTable"
                    Title="User Approval"
                    CountLabel="users awaiting approval"
                    EnableSearch="true"
                    SearchLabel=""
                    SearchPlaceholder="Search approvals..."
                    LoadServerData="LoadUnApprovedUsersServerData"
                    CursorPagerState="_unapprovedUsersLoader"
                    SearchString="@searchStringUnApprovedUser"
                    ColumnCount="2"
                    SearchStringChanged="@((string val) => searchStringUnApprovedUser = val)">
        <HeaderTemplate>
            <MudTh>Email</MudTh>
            <MudTh Class="um-actions-col">Action</MudTh>
        </HeaderTemplate>

        <RowTemplate Context="unapproveduser">
            <MudTd DataLabel="Email">@unapproveduser.email</MudTd>
            <MudTd DataLabel="Action" Class="um-actions-col">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Medium"
                               Class="um-icon-action um-icon-action-edit"
                               OnClick="@(() => OpenEditUserApprovalDialog(unapproveduser))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsTemplate>
            <div class="um-empty-state" role="status">
                <MudIcon Icon="@Icons.Material.Outlined.HowToReg" />
                <strong>No pending approvals</strong>
                <span>Users awaiting approval will appear here.</span>
            </div>
        </NoRecordsTemplate>
    </TableComponent>
}
else if (_activeIndex == 2)
{
    <TableComponent TItem="UsersDTO"
                    ContainerClass="user-management-panel"
                    @ref="usersTable"
                    Title="User Management"
                    CountLabel="registered users"
                    EnableSearch="true"
                    SearchLabel=""
                    SearchPlaceholder="Search users..."
                    LoadServerData="LoadUsersServerData"
                    CursorPagerState="_usersLoader"
                    SearchString="@searchStringUser"
                    ColumnCount="4"
                    SearchStringChanged="@((string val) => searchStringUser = val)">
        <HeaderTemplate>
            <MudTh>Email</MudTh>
            <MudTh>First Name</MudTh>
            <MudTh>Middle Name</MudTh>
            <MudTh>Last Name</MudTh>
        </HeaderTemplate>

        <RowTemplate Context="user">
            <MudTd DataLabel="Email">@user.email</MudTd>
            <MudTd DataLabel="First Name">@user.firstName</MudTd>
            <MudTd DataLabel="Middle Name">@user.middleName</MudTd>
            <MudTd DataLabel="Last Name">@user.lastName</MudTd>
        </RowTemplate>

        <NoRecordsTemplate>
            <div class="um-empty-state" role="status">
                <MudIcon Icon="@Icons.Material.Outlined.People" />
                <strong>No users</strong>
                <span>Registered users will appear here.</span>
            </div>
        </NoRecordsTemplate>
    </TableComponent>
}

else if (_activeIndex == 3)
{
    <TableComponent TItem="ApplicationsDTO"
                    ContainerClass="user-management-panel"
                    @ref="applicationsTable"
                    Title="Application Management"
                    CountLabel="registered applications"
                    EnableSearch="true"
                    SearchLabel=""
                    SearchPlaceholder="Search applications..."
                    AddButtonText="Add"
                    OnAddClicked="OpenAddApplicationDialog"
                    LoadServerData="LoadApplicationsServerData"
                    CursorPagerState="_applicationsLoader"
                    SearchString="@searchStringApp"
                    ColumnCount="4"
                    SearchStringChanged="@((string val) => searchStringApp = val)">

        <HeaderTemplate>
            <MudTh Class="um-id-col">Id</MudTh>
            <MudTh>Application</MudTh>
            <MudTh>Description</MudTh>
            <MudTh Class="um-actions-col">Action</MudTh>
        </HeaderTemplate>

        <RowTemplate Context="app">
            <MudTd DataLabel="Id" Class="um-id-col">@app.applicationId</MudTd>
            <MudTd DataLabel="Application">@app.applicationName</MudTd>
            <MudTd DataLabel="Description" Class="um-description-col">@app.Description</MudTd>
            <MudTd DataLabel="Action" Class="um-actions-col">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Medium"
                                   Class="um-icon-action um-icon-action-edit"
                                   OnClick="@(() => OpenEditApplicationDialog(app))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Medium"
                                   Class="um-icon-action um-icon-action-danger"
                                   OnClick="@(() => ConfirmDelete(app.applicationId, "application"))" />
                </MudTd>
        </RowTemplate>

        <NoRecordsTemplate>
            <div class="um-empty-state" role="status">
                <MudIcon Icon="@Icons.Material.Outlined.Apps" />
                <strong>No applications</strong>
                <span>Create a new application to get started.</span>
            </div>
        </NoRecordsTemplate>
    </TableComponent>
}

else if (_activeIndex == 4)
{
    <TableComponent TItem="SubMenusDTO"
                    ContainerClass="user-management-panel"
                    @ref="subMenusTable"
                    Title="SubMenu Management"
                    CountLabel="registered submenus"
                    EnableSearch="true"
                    SearchLabel=""
                    SearchPlaceholder="Search submenus..."
                    AddButtonText="Add"
                    OnAddClicked="OpenAddSubMenuDialog"
                    LoadServerData="LoadSubMenusServerData"
                    CursorPagerState="_subMenusLoader"
                    SearchString="@searchStringSub"
                    ColumnCount="4"
                    SearchStringChanged="@((string val) => searchStringSub = val)">
              
        <HeaderTemplate>
            <MudTh Class="um-id-col">Id</MudTh>
            <MudTh>SubMenu</MudTh>
            <MudTh>Description</MudTh>
            <MudTh Class="um-actions-col">Action</MudTh>
        </HeaderTemplate>

        <RowTemplate Context="sub">
            <MudTd DataLabel="Id" Class="um-id-col">@sub.subMenuId</MudTd>
            <MudTd DataLabel="SubMenu">@sub.subMenuName</MudTd>
            <MudTd DataLabel="Description" Class="um-description-col">@sub.Description</MudTd>
            <MudTd DataLabel="Action" Class="um-actions-col">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                               Color="Color.Primary" 
                               Size="Size.Medium" 
                               Class="um-icon-action um-icon-action-edit"
                               OnClick="@(() => OpenEditSubMenuDialog(sub))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                               Color="Color.Error" 
                               Size="Size.Medium" 
                               Class="um-icon-action um-icon-action-danger"
                               OnClick="@(() => ConfirmDelete(sub.subMenuId, "submenu"))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsTemplate>
            <div class="um-empty-state" role="status">
                <MudIcon Icon="@Icons.Material.Outlined.Menu" />
                <strong>No submenus</strong>
                <span>Create a new submenu to get started.</span>
            </div>
        </NoRecordsTemplate>
    </TableComponent>
}

else if (_activeIndex == 5)
{
    <TableComponent TItem="RolesDTO"
                    ContainerClass="user-management-panel"
                    @ref="rolesTable"
                    Title="Role Management"
                    CountLabel="registered roles"
                    EnableSearch="true"
                    SearchLabel=""
                    SearchPlaceholder="Search roles..."
                    AddButtonText="Add"
                    OnAddClicked="OpenAddRoleDialog"
                    LoadServerData="LoadRolesServerData"
                    CursorPagerState="_rolesLoader"
                    SearchString="@searchStringRole"
                    ColumnCount="4"
                    SearchStringChanged="@((string val) => searchStringRole = val)">

        <HeaderTemplate>
            <MudTh Class="um-id-col">Id</MudTh>
            <MudTh>Role</MudTh>
            <MudTh>Description</MudTh>
            <MudTh Class="um-actions-col">Action</MudTh>
        </HeaderTemplate>

        <RowTemplate Context="role">
            <MudTd DataLabel="Id" Class="um-id-col">@role.roleId</MudTd>
            <MudTd DataLabel="Role">@role.roleName</MudTd>
            <MudTd DataLabel="Description" Class="um-description-col">@role.Description</MudTd>
            <MudTd DataLabel="Action" Class="um-actions-col">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                               Color="Color.Primary" 
                               Size="Size.Medium" 
                               Class="um-icon-action um-icon-action-edit"
                               OnClick="@(() => OpenEditRoleDialog(role))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                               Color="Color.Error" 
                               Size="Size.Medium" 
                               Class="um-icon-action um-icon-action-danger"
                               OnClick="@(() => ConfirmDelete(role.roleId, "role"))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsTemplate>
            <div class="um-empty-state" role="status">
                <MudIcon Icon="@Icons.Material.Outlined.AdminPanelSettings" />
                <strong>No roles</strong>
                <span>Create a new role to get started.</span>
            </div>
        </NoRecordsTemplate>
    </TableComponent>
}

else if (_activeIndex == 6)
{
    <TableComponent TItem="AppSubRolesDTO"
                    ContainerClass="user-management-panel"
                    @ref="appSubRolesTable"
                    Title="Users' AppSubRole Management"
                    CountLabel="assigned application roles"
                    EnableSearch="true"
                    SearchLabel=""
                    SearchPlaceholder="Search application roles..."
                    AddButtonText="Add"
                    OnAddClicked="OpenAddAppSubRoleDialog"
                    LoadServerData="LoadUserAppSubRolesServerData"
                    CursorPagerState="_appSubRolesLoader"
                    SearchString="@searchStringAppSubRole"
                    ColumnCount="5"
                    SearchStringChanged="@((string val) => searchStringAppSubRole = val)">

        <HeaderTemplate>
            <MudTh>Email</MudTh>
            <MudTh>Application</MudTh>
            <MudTh>SubMenu</MudTh>
            <MudTh>Role</MudTh>
            <MudTh Class="um-actions-col">Action</MudTh>
        </HeaderTemplate>

        <RowTemplate Context="appSubRole">
            <MudTd DataLabel="Email">@appSubRole.UserEmail</MudTd>
            <MudTd DataLabel="Application">@appSubRole.AppName</MudTd>
            <MudTd DataLabel="SubMenu">@appSubRole.SubMenuName</MudTd>
            <MudTd DataLabel="Role">@appSubRole.RoleName</MudTd>
            <MudTd DataLabel="Action" Class="um-actions-col">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                               Color="Color.Primary" 
                               Size="Size.Medium" 
                               Class="um-icon-action um-icon-action-edit"
                               OnClick="@(() => OpenEditAppSubRoleDialog(appSubRole))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                               Color="Color.Error" 
                               Size="Size.Medium" 
                               Class="um-icon-action um-icon-action-danger"
                               OnClick="@(() => ConfirmDelete(appSubRole.AppRoleId, "appsubrole"))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsTemplate>
            <div class="um-empty-state" role="status">
                <MudIcon Icon="@Icons.Material.Outlined.Security" />
                <strong>No assigned application roles</strong>
                <span>Assigned application roles will appear here.</span>
            </div>
        </NoRecordsTemplate>
    </TableComponent>
}
</div>

