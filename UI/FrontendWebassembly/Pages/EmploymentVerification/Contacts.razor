@page "/employmentverification/contacts"
@layout EVLayout
@inherits CrudPageBase
@attribute [RequirePermission(8, 9)]
@using FrontendWebassembly.Component.EmploymentVerification
@inject IContactDirectoryService ContactDirectoryService

<PageTitle>Employment Verification - Contacts</PageTitle>

<div class="ev-management-page">
    <div class="ev-page-head">
        <div>
            <span class="ev-eyebrow">Directory</span>
            <h1>HR contacts</h1>
            <p>Known HR mailboxes to reach when raising a verification request.</p>
        </div>

        <div class="ats-management-actions">
            <button type="button" class="ats-management-button" @onclick="AddContactAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                Add contact
            </button>
        </div>
    </div>

    <TableComponent TItem="EmploymentVerificationContactDTO"
                    @ref="_contactsTable"
                    Title="Contacts"
                    EnableReload="true"
                    ContainerClass="ats-management-card"
                    EnableSearch="true"
                    SearchLabel=""
                    SearchPlaceholder="Search company or email"
                    ColumnCount="5"
                    RowsPerPage="10"
                    LoadServerData="LoadContactsAsync"
                    CursorPagerState="_contactsLoader"
                    SearchString="@_searchString"
                    SearchStringChanged="@((string value) => _searchString = value)">

        <HeaderTemplate>
            <MudTh>Company</MudTh>
            <MudTh>Email address</MudTh>
            <MudTh Class="ats-table-cell-center">Status</MudTh>
            <MudTh Class="ats-table-cell-center">Updated</MudTh>
            <MudTh Class="ats-table-cell-center">Actions</MudTh>
        </HeaderTemplate>

        <RowTemplate Context="contact">
            <MudTd Class="ats-management-primary" DataLabel="Company">
                <div class="ats-management-client-cell">
                    <span class="ats-management-client-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" />
                        </svg>
                    </span>
                    <span style="font-weight: 600;">@contact.CompanyName</span>
                </div>
            </MudTd>

            <MudTd Class="ev-email-cell" DataLabel="Email address">
                @contact.EmailAddress
            </MudTd>

            <MudTd Class="ats-table-cell-center" DataLabel="Status">
                <span class="ats-management-status @(!contact.IsActive ? "is-disabled" : string.Empty)">
                    @(contact.IsActive ? "Active" : "Disabled")
                </span>
            </MudTd>

            <MudTd Class="ats-management-date" DataLabel="Updated">
                @contact.UpdatedAt.ToLocalTime().ToString("MMMM dd, yyyy")
            </MudTd>

            <MudTd Class="ats-table-cell-center" DataLabel="Actions">
                <button type="button"
                        class="ats-management-edit ats-management-edit-button"
                        aria-label="@($"Edit {contact.CompanyName}")"
                        @onclick="@(() => EditContactAsync(contact))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                    </svg>
                </button>
            </MudTd>
        </RowTemplate>

        <NoRecordsTemplate>
            <div class="ats-management-empty">
                <MudIcon Icon="@Icons.Material.Filled.ContactMail" />
                <strong>No contacts</strong>
                <span>Add a contact, or adjust the search to widen the results.</span>
            </div>
        </NoRecordsTemplate>
    </TableComponent>
</div>
