@page "/"
@page "/dashboard"

<PageTitle>CIBI OnePlatform</PageTitle>

@if (isLoading)
{
    <CibiLoaderComponent />
}
else
{
    <div class="home-shell">
        <section class="home-hero">
            <div class="home-hero-text">
                <div class="home-hero-eyebrow">Dashboard</div>
                <h1 class="home-hero-title">Welcome back, @DisplayName</h1>
                <p class="home-hero-subtitle">Pick up where you left off, or jump into any application below.</p>
            </div>
            <div class="home-hero-right">
                <div class="home-date-pill">
                    <span class="home-live-dot" aria-hidden="true"></span>
                    @CurrentDateText
                </div>
                <div class="home-status-strip" aria-label="Platform status">
                    <span class="home-status-item">All systems active</span>
                    <span class="home-status-item">@FilteredApps.Count apps online</span>
                </div>
            </div>
        </section>

        <section class="home-apps-section" aria-labelledby="home-apps-heading">
            <div class="home-section-title">
                <h2 id="home-apps-heading">Your applications</h2>
                <span class="home-section-count">@($"{FilteredApps.Count} active")</span>
            </div>

            <div class="home-app-grid">
                @foreach (var app in FilteredApps)
                {
                    <a class="home-app-card"
                       href="@app.OpenRoute"
                       aria-label="@($"Open {app.Name}")">
                        <div class="home-app-card-top">
                            <div class="home-app-icon" style="background: @app.AccentGradient;">
                                <MudIcon Icon="@app.Icon" Size="Size.Medium" />
                            </div>
                            <span class="home-app-status">Active</span>
                        </div>

                        <h3 class="home-app-title">@app.Name</h3>
                        <p class="home-app-subtitle">@app.Subtitle</p>

                        <div class="home-open-link">
                            Open
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                    </a>
                }
            </div>

            @if (FilteredApps.Count == 0)
            {
                <div class="home-search-empty" role="status">
                    No applications match &quot;@ApplicationSearchQuery.Trim()&quot;.
                </div>
            }
        </section>

        <section class="home-bottom-grid">
            <article class="home-panel">
                <h3 class="home-panel-title">Recent activity</h3>

                @* TODO: Replace this placeholder with a real shell-level activity/audit log data source and API once backend support is implemented. *@
                <div class="home-empty-state">
                    <div class="home-empty-icon-wrap">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7" />
                            <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <div class="home-empty-title">Recent activity coming soon</div>
                    <div class="home-empty-subtitle">Actions across your apps &mdash; orders, lookups, and updates &mdash; will show up here.</div>
                </div>
            </article>

            <article class="home-panel">
                <div class="home-section-title home-announcement-header">
                    <h3 class="home-panel-title">What's new</h3>
                    <span class="home-placeholder-chip">Placeholder</span>
                </div>

                @* TODO: Replace editorial announcement placeholders with a real platform announcement/CMS source. *@
                <div class="home-announcement-list">
                    @foreach (var item in Announcements)
                    {
                        <div class="home-announcement-item">
                            <span class="@($"home-announcement-accent {item.Tag.ToLowerInvariant()}")" aria-hidden="true"></span>
                            <div class="home-announcement-body">
                                <div class="home-announcement-tag">@item.Tag</div>
                                <div class="home-announcement-title">@item.Title</div>
                                <div class="home-announcement-detail">@item.Detail</div>
                            </div>
                        </div>
                    }
                </div>
            </article>
        </section>
    </div>
}
