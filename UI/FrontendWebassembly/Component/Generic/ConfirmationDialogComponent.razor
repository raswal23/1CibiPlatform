<MudDialog Class="confirmation-dialog"
           Gutters="false"
           ContentClass="confirmation-dialog-content">
    <DialogContent>
        <section class="confirmation-dialog-shell"
                 aria-labelledby="confirmation-dialog-title"
                 aria-describedby="confirmation-dialog-description">
            <button type="button"
                    class="confirmation-dialog-close"
                    aria-label="Close confirmation dialog"
                    @onclick="Cancel">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M18 6 6 18M6 6l12 12"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round" />
                </svg>
            </button>

            <div class="confirmation-dialog-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="5" width="18" height="14" rx="2"
                          stroke="currentColor" stroke-width="1.8" />
                    <circle cx="8.5" cy="12" r="2"
                            stroke="currentColor" stroke-width="1.6" />
                    <path d="M13 10h5M13 14h5"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round" />
                </svg>
            </div>

            <h2 id="confirmation-dialog-title" class="confirmation-dialog-title">@Title</h2>
            <p id="confirmation-dialog-description" class="confirmation-dialog-description">@Message</p>

            @if (!string.IsNullOrWhiteSpace(InformationMessage))
            {
                <div class="confirmation-dialog-notice">
                    <span class="confirmation-dialog-notice-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M12 16v-4M12 8h.01"
                                  stroke="currentColor"
                                  stroke-width="2.4"
                                  stroke-linecap="round" />
                            <circle cx="12" cy="12" r="9"
                                    stroke="currentColor" stroke-width="1.8" />
                        </svg>
                    </span>
                    <p>@RenderInformationMessage()</p>
                </div>
            }

            <button type="button"
                    class="confirmation-dialog-proceed"
                    @onclick="Confirm">
                <span>@ConfirmText</span>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                </svg>
            </button>

            @if (!string.IsNullOrWhiteSpace(Footnote))
            {
                <div class="confirmation-dialog-footnote">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3" y="8" width="14" height="10" rx="2"
                              stroke="currentColor" stroke-width="1.6" />
                        <path d="m17 11 4-2v10l-4-2"
                              stroke="currentColor"
                              stroke-width="1.6"
                              stroke-linejoin="round" />
                    </svg>
                    <span>@Footnote</span>
                </div>
            }
        </section>
    </DialogContent>
</MudDialog>
