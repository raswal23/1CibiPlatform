<MudDialog Style="border-radius:12px; padding-top:10px;" 
           Class="philsys-shadow-box" >
    
    <DialogContent >
        <MudStack AlignItems="AlignItems.Center" Spacing="3">

            <MudAvatar Size="Size.Large"
                       Color="Color.Primary" 
                       Variant="Variant.Filled">
                <MudIcon Icon="@Icons.Material.Filled.HelpOutline"/>
            </MudAvatar>

            <MudText Typo="Typo.h5"
                     Align="Align.Center"
                     Style="font-weight:700;">
                @Title
            </MudText>

            <MudText Align="Align.Center"
                     Class="mt-2">
                @Message
            </MudText>

        </MudStack>

        @if (!string.IsNullOrWhiteSpace(InformationMessage))
        {
            <MudPaper Class="d-flex align-center pa-3 mt-6"
                      Elevation="0"
                      Style="background:#EEF4FF; border-radius:12px;">

                <MudIcon Icon="@Icons.Material.Filled.Info"
                         Color="Color.Primary"
                         Class="me-2" />

                <MudText Typo="Typo.caption">
                    @InformationMessage
                </MudText>

            </MudPaper>
            }
    </DialogContent>

    <DialogActions>
        <div style="width:100%; display:flex; justify-content:center; padding-bottom:10px;">
        
            <MudButton Class="theme-button theme-button-active"
                       Style="min-width:120px; border-radius:12px;"
                       OnClick="Confirm">
                @ConfirmText
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>