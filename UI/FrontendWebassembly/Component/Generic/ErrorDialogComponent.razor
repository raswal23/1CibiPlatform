@inject NavigationManager Navigation

<div class="philsys-error-shell">
    <MudPaper Class="philsys-error-card" Elevation="0">
        <div class="philsys-error-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7.5v5.5M12 16.2v.1" />
            </svg>
        </div>

        <h1 class="philsys-error-title">Oops! Something went wrong</h1>
        <p class="philsys-error-subtitle">We encountered an unexpected error. Please try refreshing the page.</p>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <details class="philsys-error-details">
                <summary>Error details</summary>
                <pre class="philsys-error-message">@Message</pre>
            </details>
        }

        <div class="philsys-error-action">
            <MudButton ButtonType="ButtonType.Button"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       OnClick="@(() => Navigation.NavigateTo(Navigation.Uri, true))"
                       StartIcon="@Icons.Material.Outlined.Refresh"
                       Class="philsys-error-button">
                Reload Page
            </MudButton>
        </div>
    </MudPaper>
</div>
