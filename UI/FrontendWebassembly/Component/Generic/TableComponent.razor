@typeparam TItem

<div class="@ContainerCssClass"
     role="@(HasAccessibleName ? "region" : null)"
     aria-label="@AccessibleLabel"
     aria-labelledby="@AccessibleTitleId">
    @if (LoadServerData != null)
    {
        <MudTable T="TItem"
                  @ref="TableRef"
                  ServerData="LoadServerData"
                  Class="@TableCssClass"
                  OnRowClick="OnRowClick"
                  RowClassFunc="RowClassFunc"
                  Breakpoint="@ResponsiveBreakpoint"
                  HorizontalScrollbar="true"
                  Hover="true"
                  RowsPerPage="@_rowsPerPage"
                  RowsPerPageChanged="@OnRowsPerPageChanged"
                  LoadingContent="@(UseLoadingContentBody ? null : LoadingContent)"
                  LoadingContentBody="@(UseLoadingContentBody ? LoadingContentBody : null)">

            <ToolBarContent>
                @ToolbarContent
            </ToolBarContent>

            <HeaderContent>
                @HeaderTemplate
            </HeaderContent>

            <RowTemplate Context="item">
                @RowTemplate!(item)
            </RowTemplate>

            <NoRecordsContent>
                @NoRecordsTemplate
            </NoRecordsContent>

            <PagerContent>
                @PagerContent
            </PagerContent>
        </MudTable>
    }
    else
    {
        <MudTable T="TItem"
                  @ref="TableRef"
                  Items="Items"
                  Hover="true"
                  Class="@TableCssClass"
                  OnRowClick="OnRowClick"
                  Breakpoint="@ResponsiveBreakpoint"
                  RowsPerPage="@_rowsPerPage"
                  RowsPerPageChanged="@OnRowsPerPageChanged"
                  HorizontalScrollbar="true"
                  RowClassFunc="RowClassFunc">

            <ToolBarContent>
                @ToolbarContent
            </ToolBarContent>

            <HeaderContent>
                @HeaderTemplate
            </HeaderContent>

            <RowTemplate Context="item">
                @RowTemplate!(item)
            </RowTemplate>

            <NoRecordsContent>
                @NoRecordsTemplate
            </NoRecordsContent>

            <PagerContent>
                @PagerContent
            </PagerContent>
        </MudTable>
    }
</div>

@code {
    private readonly RenderFragment LoadingContent = @<MudSkeleton />;

    private RenderFragment ToolbarContent => @<div class="@ToolbarCssClass">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <MudText id="@ResolvedTitleId"
                     Typo="Typo.h6"
                     Class="table-component-title gradient-text">
                @Title
            </MudText>
        }

        @if (HasToolbarActions)
        {
            <div class="table-component-toolbar-row">
                @if (ToolBarLeft != null)
                {
                    <div class="table-component-toolbar-left">
                        @ToolBarLeft
                    </div>
                }

                @if (EnableReload)
                {
                    <button type="button"
                            class="table-component-reload-button @(_isReloading ? "is-reloading" : null)"
                            aria-label="@ReloadAriaLabel"
                            title="@ReloadAriaLabel"
                            disabled="@_isReloading"
                            @onclick="ReloadDataAsync">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2.2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v4h-4" />
                        </svg>
                    </button>
                }

                @if (EnableSearch)
                {
                    <div class="table-component-search">
                        <MudTextField T="string"
                                      Value="SearchString"
                                      ValueChanged="@(EventCallback.Factory.Create<string>(this, SearchChanged))"
                                      Label="@SearchLabel"
                                      Placeholder="@SearchPlaceholder"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="@SearchImmediate"
                                      DebounceInterval="@SearchDebounceInterval"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="Size.Medium"
                                      Class="table-component-search-input" />
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(AddButtonText))
                {
                    <div class="table-component-toolbar-actions">
                        <MudButton Variant="Variant.Filled"
                                   Class="theme-button theme-button-active"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@OnAddClicked">
                            @AddButtonText
                        </MudButton>
                    </div>
                }
            </div>
        }
    </div>;

    private RenderFragment PagerContent => CursorPagerState is not null
        ? @<CursorTablePager PagerState="@CursorPagerState"
                             PageSizeOptions="@PageSizeOptions"
                             RowsPerPageString="@RowsPerPageString"
                             InfoFormat="@PagerInfoFormat" />
        : @<MudTablePager PageSizeOptions="@PageSizeOptions"
                          RowsPerPageString="@RowsPerPageString"
                          InfoFormat="@PagerInfoFormat" />;

    private RenderFragment LoadingContentBody => @<text>
        @for (int r = 0; r < 4; r++)
        {
            <MudTr>
                @for (int c = 0; c < ColumnCount; c++)
                {
                    <MudTd><MudSkeleton /></MudTd>
                }
            </MudTr>
        }
    </text>;
}
