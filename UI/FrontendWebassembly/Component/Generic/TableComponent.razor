@typeparam TItem

<div class="responsive-table-container">
@if (LoadServerData != null)
    {
        <MudTable T="TItem"
        @ref="TableRef"
        ServerData="LoadServerData"
        Class="responsive-title transparent-paper"
        HorizontalScrollbar="true"
        Hover="true"
        RowsPerPage="@(RowsPerPage ?? 10)"
        LoadingContent="@(UseLoadingContentBody ? null : LoadingContent)"
        LoadingContentBody="@(UseLoadingContentBody ? LoadingContentBody : null)"
        Style="border-radius: 12px; padding: 10px;">

            <ToolBarContent>
                <div style="width:100%;">

                    @if (!string.IsNullOrWhiteSpace(Title))
                    {
                        <MudText Typo="Typo.h6"
                                 Class="responsive-title gradient-text"
                                 Style="width:100%; font-size:20px; font-weight:700; margin-bottom:12px;">
                            @Title
                        </MudText>
                    }

                    <div style="display:flex; align-items:center; width:100%; gap:12px;">

                        @if (ToolBarLeft != null)
                        {
                            <div style="width:350px; flex-shrink:0;">
                                @ToolBarLeft
                            </div>
                        }

                        @if (EnableSearch)
                        {
                            <div style="flex:1; justify-content:center;">
                                <MudTextField T="string"
                                              Value="SearchString"
                                              ValueChanged="@(EventCallback.Factory.Create<string>(this, SearchChanged))"
                                              ValueExpression="(() => SearchString)"
                                              Label="Search"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              IconSize="Size.Medium"
                                              Style="width:100%;"
                                              Class="mt-0" />
                            </div>
                        }
                        <div>   
                        @if (AddButtonText != null)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Class="theme-button theme-button-active"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@OnAddClicked">
                                @AddButtonText
                            </MudButton>
                        }
                        </div>
                    </div>

                </div>
            </ToolBarContent>

            <HeaderContent>
                @HeaderTemplate
            </HeaderContent>

            <RowTemplate Context="item">
                @RowTemplate!(item)
            </RowTemplate>

            <NoRecordsContent>
                @NoRecordsTemplate
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    }
else
    {
        <MudTable T="TItem"
                  @ref="TableRef"
                  Items="Items"
                  Hover="true"
                  Class="responsive-title"
                  Style="border-radius: 4px; padding: 10px;"
                  RowsPerPage="@(RowsPerPage ?? 10)"
                  HorizontalScrollbar="true">

            <HeaderContent>
                @HeaderTemplate
            </HeaderContent>

            <RowTemplate Context="item">
                @RowTemplate!(item)
            </RowTemplate>

            <NoRecordsContent>
                @NoRecordsTemplate
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager />
            </PagerContent>

        </MudTable>
    }
</div>

@code {
    private readonly RenderFragment LoadingContent = @<MudSkeleton />;

    private RenderFragment LoadingContentBody => @<text>
            @for (int r = 0; r< 4; r++)
                {
                <MudTr>
                    @for (int c = 0; c<ColumnCount; c++)
                            {
                    <MudTd><MudSkeleton /></MudTd>
                            }
                </MudTr>
                }
            </text>;
}
