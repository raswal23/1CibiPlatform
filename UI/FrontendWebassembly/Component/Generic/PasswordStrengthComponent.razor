<div class="@GetContainerClass()"
     aria-label="@GetLabel()"
     aria-live="polite">
    <p class="password-strength-requirements">
        <strong>Password requirements:</strong>
        Use 6–100 characters with at least one uppercase letter, one lowercase letter, one number, and one special character.
    </p>
    <div class="password-strength-bars" aria-hidden="true">
        <span class="@GetBarClass(1)"></span>
        <span class="@GetBarClass(2)"></span>
        <span class="@GetBarClass(3)"></span>
        <span class="@GetBarClass(4)"></span>
    </div>
    <div class="password-strength-label">
        @GetLabel()
    </div>
</div>
