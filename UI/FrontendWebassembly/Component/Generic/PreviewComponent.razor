@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject EmailValidationService EmailValidationService

<MudDialog Class="um-dialog preview-upload-dialog ats-scroll-dialog"
           Style="padding: 0; width: min(1000px, calc(100vw - 24px)); max-width: 1000px;">
    <DialogContent>
      <div class="preview-upload-shell ats-dialog-shell ats-management-page">
        <header class="preview-upload-header ats-dialog-header">
            <div class="preview-upload-header-row">
                <div class="preview-upload-header-left">
                    <span class="preview-upload-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M14 2H6.5A1.5 1.5 0 005 3.5v17A1.5 1.5 0 006.5 22h11a1.5 1.5 0 001.5-1.5V8l-5-6z" />
                            <path d="M14 2v5.5A1.5 1.5 0 0015.5 9H21M8.5 13h7M8.5 16.5h4" />
                        </svg>
                    </span>
                    <div>
                        <h2>Preview upload</h2>
                        <p>Review the candidates before confirming the bulk upload</p>
                    </div>
                </div>
                <button type="button" class="preview-upload-close" aria-label="Close preview" @onclick="Cancel">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                        <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                </button>
            </div>
        </header>

        <main class="preview-upload-body ats-dialog-body">
            @if (InvalidRows.Any())
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="preview-upload-alert mb-4">
                    @if (InvalidMobileRows.Any())
                    {
                        <div>Mobile number must be exactly 11 digits in row(s): @string.Join(", ", InvalidMobileRows).</div>
                    }
                    @if (InvalidEmailRows.Any())
                    {
                        <div>Email address is not a valid email in row(s): @string.Join(", ", InvalidEmailRows).</div>
                    }
                    @if (InvalidDateOfBirthRows.Any())
                    {
                        <div>Date of birth must be in MM/dd/yyyy format in row(s): @string.Join(", ", InvalidDateOfBirthRows).</div>
                    }
                    @if (InvalidSSSNumberRows.Any())
                    {
                        <div>SSS number must be 10 digits in row(s): @string.Join(", ", InvalidSSSNumberRows).</div>
                    }
                    @if (InvalidTINNumberRows.Any())
                    {
                        <div>TIN number must be 9-12 digits in row(s): @string.Join(", ", InvalidTINNumberRows).</div>
                    }
                    @if (BlankRows.Any())
                    {
                        <div>Blank values found in row(s): @string.Join(", ", BlankRows) - @Message</div>
                    }
                </MudAlert>
            }
            
            <div class="preview-upload-table-panel">
                @* Uses the default Breakpoint.Sm so the preview stacks into cards on a
                   phone. It previously passed Breakpoint.None, which suppressed card
                   mode entirely and left a 920px-wide table inside the dialog at every
                   viewport. Every MudTd below carries a DataLabel, so stacking reads
                   correctly. *@
                <TableComponent TItem="List<string>"
                                Items="Rows"
                                ContainerClass="ats-management-card ats-package-card preview-upload-table"
                                RowsPerPage="10">
                    <HeaderTemplate>
                        <MudTh>Row</MudTh>
                        @foreach (var header in Headers)
                        {
                            <MudTh>@header</MudTh>
                        }
                    </HeaderTemplate>

                    <RowTemplate Context="row">
                        <MudTd DataLabel="Row">
                            <span class="preview-upload-row-index">@(Rows.IndexOf(row) + 2)</span>
                        </MudTd>
                        @for (int i = 0; i < row.Count; i++)
                        {
                            var cellColumn = row[i];
                            <MudTd DataLabel="@Headers[i]"
                                   Class="@(IsInvalidCell(i, cellColumn) ? "preview-upload-invalid-cell" : null)">
                                @if (i == 0 && !string.IsNullOrWhiteSpace(cellColumn))
                                {
                                    <span class="preview-upload-name-cell">
                                        <span class="preview-upload-avatar">@GetCandidateInitials(row)</span>
                                        <span class="preview-upload-name">@cellColumn</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="@(i >= 2 ? "preview-upload-muted" : null)">
                                        @(string.IsNullOrWhiteSpace(cellColumn)
                                            ? (IsRequiredCellBlank(i, cellColumn) ? "(Blank)" : "—")
                                            : (IsInvalidMobileNumber(i, cellColumn) ? "(Invalid)" : cellColumn))
                                    </span>
                                }
                            </MudTd>
                        }
                    </RowTemplate>
                </TableComponent>
            </div>
        </main>

        <footer class="preview-upload-footer ats-dialog-footer">
            <button type="button"
                    class="preview-upload-button preview-upload-cancel"
                    @onclick="Cancel">
                Cancel
            </button>
            <button type="button"
                    class="preview-upload-button preview-upload-confirm"
                    disabled="@InvalidRows.Any()"
                    @onclick="Confirm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                </svg>
                Confirm upload
            </button>
        </footer>
      </div>
    </DialogContent>
</MudDialog>

