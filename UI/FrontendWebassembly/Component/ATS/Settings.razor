@page "/s&i/ats/settings"
@using FrontendWebassembly.Pages.ATS
@layout ATSLayout
@attribute [RequirePermission(6, 7)]

<PageTitle>ATS - Settings</PageTitle>

<div class="ats-segmented">
    <button class="@GetPackageSegmentClass()" type="button" @onclick='@(() => SetOrderMode("Package"))'>Package</button>
    <button class="@GetClientSegmentClass()" type="button" @onclick='@(() => SetOrderMode("Client"))'>Client</button>
    <button class="@GetRoleSegmentClass()" type="button" @onclick='@(() => SetOrderMode("Role"))'>Role</button>
</div>
    

@if (ManagementType == "Package")
{
    <PackageManagement/>
}
else if (ManagementType == "Client")
{
    <ClientManagement/>
}
else
{
    <div class="ats-console-placeholder-sub">Coming soon</div>
}

@code {
    private string? ManagementType = "Package";

    private string GetPackageSegmentClass()
    {
        if (ManagementType == "Package")
        {
            return "ats-segment-btn active";
        }
        return "ats-segment-btn";
    }

    private string GetClientSegmentClass()
    {
        if (ManagementType == "Client")
        {
            return "ats-segment-btn active";
        }
        return "ats-segment-btn";
    }

    private string GetRoleSegmentClass()
    {
        if (ManagementType == "Role")
        {
            return "ats-segment-btn active";
        }
        return "ats-segment-btn";
    }

    private void SetOrderMode(string packagementType)
    {
        ManagementType = packagementType;
    }
}