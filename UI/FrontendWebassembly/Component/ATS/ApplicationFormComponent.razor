                                            </MudText>
                                            <MudText Typo="Typo.body2" Class="mt-4">
                                                I understand that the information obtained because of this authorization and consent will be held in the strictest of confidentiality by CIBi and/or the Company and will be maintained in
                                                accordance with their respective Privacy Policies. The information obtained will only be used in accordance with and to satisfy the scope for which this authorization/consent has been
                                                signed. I release, waive and forever discharge anyone who provides information in relation to this release, from any and all liability for the disclosure of information to CIBI or the Company. I
                                                certify that the information set out by me in this authorization/consent is correct.
                                            </MudText>
                                            <MudText Typo="Typo.body2" Class="mt-4">
                                                You may reach out to the DPO at dpo@cibi.com.ph tor any privacy concerns.
                                            </MudText>
                                        </MudPaper>
                                    </MudItem>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12">
                                <MudPaper Elevation="0" Class="ats-signature-panel">
                                    <MudGrid>
                                        <MudItem xs="12">
                                            <div class="ats-signature-block">
                                                <MudText Typo="Typo.subtitle2" Class="mb-1">Signature</MudText>
                                                <SignaturePad Value="signatureDetails.Signature"
                                                              ValueChanged="OnSignatureChanged"
                                                              ClearButtonClass="@(isSaving
                                                               ? "theme-button theme-button-active ats-signature-button theme-button-inactive "
                                                               : "theme-button theme-button-active ats-signature-button")"
                                                              Class="ats-signature mb-2"
                                                              Disabled="@isSaving" />
                                            </div>
                                            @if (_signatureError)
                                            {
                                                <div class="ats-signature-error">
                                                    <MudText Color="Color.Error"
                                                             Typo="Typo.caption"
                                                             Class="mb-2">
                                                        Please provide your signature.
                                                    </MudText>
                                                </div>
                                            }
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudGrid Class="ats-signature-meta-row">
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField T="string"
                                                                  Label="Name"
                                                                  @bind-Value="signatureDetails.SignerName"
                                                                  Required="true"
                                                                  RequiredError="Name is required"
                                                                  Variant="Variant.Outlined"
                                                                  Margin="Margin.Dense"
                                                                  Class="oneplatform-rounded-input" />
                                                </MudItem>

                                                <MudItem xs="12" sm="6">
                                                    <MudDatePicker @bind-Date="SignatureDate"
                                                                   Label="Date"
                                                                   Required="true"
                                                                   RequiredError="Date is required"
                                                                   Variant="Variant.Outlined"
                                                                   Margin="Margin.Dense"
                                                                   Class="oneplatform-rounded-input"
                                                                   DateFormat="MM/dd/yyyy"
                                                                   ReadOnly />
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudStep>
                </ChildContent>

                <ActionContent Context="stepper">
                    @if (_activeStep != 0)
                    {
                        <div class="d-flex justify-space-between w-100 pa-2 ats-step-action-bar">

                            <MudButton Style="width: 150px; border-radius:12px; border: 2px solid gray; height; 40px;"
                                       Class="mt-3 mb-4"
                                       OnClick="@(() => stepper.PreviousStepAsync())">
                                Previous
                            </MudButton>

                            @if (_activeStep == stepper.Steps.Count - 1)
                            {
                                <MudButton Class="theme-button mt-3 theme-button-active mb-4"
                                           Style="width: 150px; border-radius:12px; height; 40px; "
                                           OnClick="OnSubmitForm">

                                    @if (isSaving)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />

                                        <span> Saving...</span>
                                    }
                                    else
                                    {
                                        <span>Submit</span>
                                    }
                                    
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Class="theme-button mt-3 theme-button-active mb-4"
                                           Style="width: 150px; border-radius:12px; "
                                           OnClick="OnSaveAndNextAsync">
                                    Save & Next
                                </MudButton>
                            }
                        </div>
                    }
                </ActionContent>
            </MudStepper>
        </MudForm>
    }

</MudPaper>
