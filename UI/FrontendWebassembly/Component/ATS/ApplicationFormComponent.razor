                                                      @bind-Value="referenceDetails.Ref1Email"
                                                      Validation="@((string value) => EmailValidationService.ValidateEmail(value))"
                                                      Label="Email Contact" />
                                    </MudItem>

                                    <MudItem xs="12" sm="4">
                                        <MudTextField FullWidth="true"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Required="true"
                                                      RequiredError="Mobile Contact Information is required"
                                                      Class="oneplatform-rounded-input"
                                                      @bind-Value="referenceDetails.Ref1ContactNumber"
                                                      Mask="@(new PatternMask("00000000000"))"
                                                      Validation="@((string value) => MobileNumberValidationService.ValidateMobileNumber(value))"
                                                      Label="Mobile Contact" />
                                    </MudItem>

                                    <MudItem xs="12" sm="6" Class="ats-reference-option-wrap">
                                        <MudText Typo="Typo.body2" Class="ats-reference-option-label">Available to Reach On</MudText>
                                        <MudRadioGroup T="string"
                                                       Required="true"
                                                       @bind-Value="referenceDetails.Ref1ModeOfContact"
                                                       Class="ats-reference-pill-group">
                                            <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref1ModeOfContact == "Email" ? "selected" : string.Empty)}")" Value="@("Email")">
                                                Email
                                            </MudRadio>
                                            <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref1ModeOfContact == "Phone" ? "selected" : string.Empty)}")" Value="@("Phone")">
                                                Phone
                                            </MudRadio>
                                            <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref1ModeOfContact == "Both" ? "selected" : string.Empty)}")" Value="@("Both")">
                                                Both
                                            </MudRadio>
                                        </MudRadioGroup>
                                    </MudItem>

                                    <MudItem xs="12" sm="6" Class="ats-reference-datetime-wrap">
                                        <MudDatePicker @bind-Date="Ref1BestDate"
                                                       Class="oneplatform-rounded-input ats-reference-date"
                                                       Placeholder="Date"
                                                       Adornment="Adornment.End"
                                                       Required="true"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       MinDate="@DateTime.Now"
                                                       Label="Best Date to Contact"
                                                       DateFormat="MM/dd/yyyy" />

                                        <MudTextField @bind-Value="Ref1BestTime"
                                                      Label="Time"
                                                      InputType="InputType.Time"
                                                      Required="true"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Class="oneplatform-rounded-input ats-reference-time" />
                                    </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <!-- Reference 2 -->
                            <MudItem xs="12" Class="ats-reference-item-after-first">
                                <MudPaper Elevation="0" Class="ats-reference-block">
                                    <MudGrid Class="ats-reference-grid">
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.subtitle2" Class="ats-reference-title">Reference 2</MudText>
                                        </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField FullWidth="true"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Required="true"
                                                      Class="oneplatform-rounded-input"
                                                      @bind-Value="referenceDetails.Ref2FullName"
                                                      Label="Full Name" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6" Class="ats-reference-option-wrap">
                                        <MudText Typo="Typo.body2" Class="ats-reference-option-label">Professional Relationship</MudText>
                                        <MudRadioGroup T="string"
                                                       Required="true"
                                                       RequiredError="Professional Relationship is required"
                                                       @bind-Value="referenceDetails.Ref2ProfessionalRelationship"
                                                       Class="ats-reference-pill-group">
                                            <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref2ProfessionalRelationship == "Colleague" ? "selected" : string.Empty)}")" Value="@("Colleague")">
                                                Colleague
                                            </MudRadio>
                                            <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref2ProfessionalRelationship == "Superior" ? "selected" : string.Empty)}")" Value="@("Superior")">
                                                Superior
                                            </MudRadio>
                                            <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref2ProfessionalRelationship == "Peer" ? "selected" : string.Empty)}")" Value="@("Peer")">
                                                Peer
                                            </MudRadio>
                                            <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref2ProfessionalRelationship == "Subordinate" ? "selected" : string.Empty)}")" Value="@("Subordinate")">
                                                Subordinate
                                            </MudRadio>
                                        </MudRadioGroup>
                                    </MudItem>

                                    <MudItem xs="12" sm="4">
                                        <MudTextField FullWidth="true"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Required="true"
                                                      RequiredError="Affiliated Company is required"
                                                      Class="oneplatform-rounded-input"
                                                      @bind-Value="referenceDetails.Ref2AffiliatedCompany"
                                                      Label="Affiliated Company" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudTextField FullWidth="true"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Class="oneplatform-rounded-input"
                                                      @bind-Value="referenceDetails.Ref2Email"
                                                      Required="true"
                                                      RequiredError="Email Contact Information is required"
                                                      Validation="@((string value) => EmailValidationService.ValidateEmail(value))"
                                                      Label="Email Contact" />
                                    </MudItem>

                                    <MudItem xs="12" sm="4">
                                        <MudTextField FullWidth="true"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Class="oneplatform-rounded-input"
                                                      @bind-Value="referenceDetails.Ref2ContactNumber"
                                                      Required="true"
                                                      Mask="@(new PatternMask("00000000000"))"
                                                      Validation="@((string value) => MobileNumberValidationService.ValidateMobileNumber(value))"
                                                      RequiredError="Mobile Contact Information is required"
                                                      Label="Mobile Contact" />
                                    </MudItem>

                                    <MudItem xs="12" sm="6" Class="ats-reference-option-wrap">
                                        <MudText Typo="Typo.body2" Class="ats-reference-option-label">Available to Reach On</MudText>
                                        <MudRadioGroup T="string"
                                                       Required="true"
                                                       @bind-Value="referenceDetails.Ref2ModeOfContact"
                                                       Class="ats-reference-pill-group">
                                            <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref2ModeOfContact == "Email" ? "selected" : string.Empty)}")" Value="@("Email")">
                                                Email
                                            </MudRadio>
                                            <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref2ModeOfContact == "Phone" ? "selected" : string.Empty)}")" Value="@("Phone")">
                                                Phone
                                            </MudRadio>
                                            <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref2ModeOfContact == "Both" ? "selected" : string.Empty)}")" Value="@("Both")">
                                                Both
                                            </MudRadio>
                                        </MudRadioGroup>
                                    </MudItem>

                                    <MudItem xs="12" sm="6" Class="ats-reference-datetime-wrap">
                                        <MudDatePicker @bind-Date="Ref2BestDate"
                                                       Placeholder="Date"
                                                       DateFormat="MM/dd/yyyy"
                                                       Class="oneplatform-rounded-input ats-reference-date"
                                                       Adornment="Adornment.End"
                                                       Required="true"
                                                       MinDate="@DateTime.Now"
                                                       Variant="Variant.Outlined"
                                                       Label="Best Date to Contact"
                                                       Margin="Margin.Dense" />

                                        <MudTextField @bind-Value="Ref2BestTime"
                                                      Label="Time"
                                                      InputType="InputType.Time"
                                                      Required="true"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Class="oneplatform-rounded-input ats-reference-time" />
                                    </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <!-- Reference 3 -->
                            <MudItem xs="12" Class="ats-reference-item-after-first">
                                @if (!AddAnotherReference)
                                {
                                    <MudCheckBox T="bool"
                                                 Class="ats-add-reference-card"
                                                 @bind-Value="AddAnotherReference"
                                                 Label="+ Add Reference 3" />
                                }
                                <MudCollapse Expanded="@AddAnotherReference">
                                    <MudPaper Elevation="0" Class="ats-reference-block">
                                        <MudGrid Class="ats-reference-grid">
                                            <MudItem xs="12" Class="d-flex align-center justify-space-between">
                                                <MudText Typo="Typo.subtitle2" Class="ats-reference-title mb-0">Reference 3</MudText>
                                                <MudButton Variant="Variant.Text"
                                                           Class="ats-remove-reference-btn"
                                                           OnClick="@(() => AddAnotherReference = false)">
                                                    Remove ✕
                                                </MudButton>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField FullWidth="true"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Required="@AddAnotherReference"
                                                              Class="oneplatform-rounded-input"
                                                              @bind-Value="referenceDetails.Ref3FullName"
                                                              Label="Full Name" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" Class="ats-reference-option-wrap">
                                                <MudText Typo="Typo.body2" Class="ats-reference-option-label">Professional Relationship</MudText>
                                                <MudRadioGroup T="string"
                                                               Required="@AddAnotherReference"
                                                               RequiredError="Professional Relationship is required"
                                                               @bind-Value="referenceDetails.Ref3ProfessionalRelationship"
                                                               Class="ats-reference-pill-group">
                                                    <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref3ProfessionalRelationship == "Colleague" ? "selected" : string.Empty)}")" Value="@("Colleague")">Colleague</MudRadio>
                                                    <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref3ProfessionalRelationship == "Superior" ? "selected" : string.Empty)}")" Value="@("Superior")">Superior</MudRadio>
                                                    <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref3ProfessionalRelationship == "Peer" ? "selected" : string.Empty)}")" Value="@("Peer")">Peer</MudRadio>
                                                    <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref3ProfessionalRelationship == "Subordinate" ? "selected" : string.Empty)}")" Value="@("Subordinate")">Subordinate</MudRadio>
                                                </MudRadioGroup>
                                            </MudItem>

                                            <MudItem xs="12" sm="4">
                                                <MudTextField FullWidth="true"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Class="oneplatform-rounded-input"
                                                              Required="@AddAnotherReference"
                                                              RequiredError="Affiliated Company is required"
                                                              @bind-Value="referenceDetails.Ref3AffiliatedCompany"
                                                              Label="Affiliated Company" />
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudTextField FullWidth="true"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Class="oneplatform-rounded-input"
                                                              @bind-Value="referenceDetails.Ref3Email"
                                                              Required="@AddAnotherReference"
                                                              RequiredError="Email Contact Information is required"
                                                              Validation="@((string value) => EmailValidationService.ValidateEmail(value))"
                                                              Label="Email Contact" />
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudTextField FullWidth="true"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Class="oneplatform-rounded-input"
                                                              @bind-Value="referenceDetails.Ref3ContactNumber"
                                                              Required="@AddAnotherReference"
                                                              Mask="@(new PatternMask("00000000000"))"
                                                              Validation="@((string? value) =>
                                                                {
                                                                    if (!AddAnotherReference || string.IsNullOrWhiteSpace(value))
                                                                        return null;

                                                                    return MobileNumberValidationService.ValidateMobileNumber(value);
                                                                })"
                                                              RequiredError="Mobile Contact Information is required"
                                                              Label="Mobile Contact" />
                                            </MudItem>

                                            <MudItem xs="12" sm="6" Class="ats-reference-option-wrap">
                                                <MudText Typo="Typo.body2" Class="ats-reference-option-label">Available to Reach On</MudText>
                                                <MudRadioGroup T="string"
                                                               Required="@AddAnotherReference"
                                                               @bind-Value="referenceDetails.Ref3ModeOfContact"
                                                               Class="ats-reference-pill-group">
                                                    <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref3ModeOfContact == "Email" ? "selected" : string.Empty)}")" Value="@("Email")">Email</MudRadio>
                                                    <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref3ModeOfContact == "Phone" ? "selected" : string.Empty)}")" Value="@("Phone")">Phone</MudRadio>
                                                    <MudRadio T="string" Class="@($"ats-reference-pill {(referenceDetails.Ref3ModeOfContact == "Both" ? "selected" : string.Empty)}")" Value="@("Both")">Both</MudRadio>
                                                </MudRadioGroup>
                                            </MudItem>

                                            <MudItem xs="12" sm="6" Class="ats-reference-datetime-wrap">
                                                <MudDatePicker @bind-Date="Ref3BestDate"
                                                               Class="oneplatform-rounded-input ats-reference-date"
                                                               Placeholder="Date"
                                                               Adornment="Adornment.End"
                                                               Required="@AddAnotherReference"
                                                               Variant="Variant.Outlined"
                                                               Margin="Margin.Dense"
                                                               MinDate="@DateTime.Now"
                                                               Label="Best Date to Contact"
                                                               DateFormat="MM/dd/yyyy" />
                                                <MudTextField @bind-Value="Ref3BestTime"
                                                              Label="Time"
                                                              InputType="InputType.Time"
                                                              Required="@AddAnotherReference"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Class="oneplatform-rounded-input ats-reference-time" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                </MudCollapse>
                            </MudItem>
                            </MudGrid>
                        </div>
                    </MudStep> 
                </ChildContent>

                <ActionContent Context="stepper">
                    <div class="d-flex w-100 pa-2 ats-step-action-bar @(_activeStep == 2 ? "ats-step-three-action-bar" : string.Empty) @(_activeStep == 3 ? "ats-step-four-action-bar" : string.Empty) @(_activeStep == 4 ? "ats-step-five-action-bar" : string.Empty) @(_activeStep == stepper.Steps.Count - 1 ? "ats-final-action-bar" : string.Empty)"
                         style="@(_activeStep == 0 ? "justify-content: flex-end;" : "justify-content: space-between;")">

                            @if (_activeStep != 0)
                            {
                                <MudButton Class="ats-previous-button"
                                           StartIcon="@Icons.Material.Filled.ArrowBack"
                                           OnClick="OnPreviousStepAsync">
                                    Previous
                                </MudButton>
                            }

                            @if (_activeStep == stepper.Steps.Count - 1)
                            {
                                <MudButton Class="theme-button mt-3 theme-button-active mb-4 ats-final-submit-button"
                                           Style="width: 150px; height: 40px; border-radius: 12px;"
                                           Disabled="@isSaving"
                                           OnClick="OnSubmitForm">

                                    @if (isSaving)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />

                                        <span> Saving...</span>
                                    }
                                    else
                                    {
                                        <span>Submit</span>
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="ats-submit-check" />
                                    }
                                    
                                </MudButton>
                            }
                            else
                            {
                                @if (_activeStep == 0)
                                {
                                    <MudButton Class="ats-save-next-button"
                                               Variant="Variant.Filled"
                                               EndIcon="@Icons.Material.Filled.ArrowForward"
                                               Disabled="@isSaving"
                                               OnClick="OnSaveAndNextAsync">
                                        Save &amp; Next
                                    </MudButton>
                                }
                                else if (_activeStep != 1)
                                {
                                    <MudButton Class="ats-save-next-button"
                                                   Variant="Variant.Filled"
                                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                                   Disabled="@isSaving"
                                                   OnClick="OnSaveAndNextAsync">
                                        Save &amp; Next
                                    </MudButton>
                                }
                            }
                    </div>
                </ActionContent>
            </MudStepper>
        </MudForm>
    }

</MudPaper>
