@inject IApplicationFormService ATSService
@inject IDialogService DialogService
@inject IApplicationFormStateService ApplicationFormStateService
@inject HttpClient Http
@inject LocalStorageService LocalStorageService
@inject EmailValidationService EmailValidationService
@inject FileValidationService FileValidationService
@inject MobileNumberValidationService MobileNumberValidationService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudPaper Elevation="0"
          Class="@($"ats-modern-card {(!showPhilSys && !IsSuccess ? "ats-application-card" : string.Empty)}")">
    @if (IsSuccess)
    {
        <SuccessApplicationFormComponent />
    }
    else if (showPhilSys)
    {
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       Class="ml-2 mt-2"
                       OnClick="@(()=> showPhilSys = false)"/>
        <div class="philsys-modern ats-philsys-wrap">
            <PhilSysComponent HashToken="@HashToken"></PhilSysComponent>
        </div>
    }
    else
    {
        <MudForm @ref="ApplicationForm"
                 Disabled="@isSaving"
                 Class="ats-appform-form"
                 FieldChanged="ScheduleDraftSaveFromField"
                 @oninput="ScheduleDraftSaveFromDom"
                 >
            <MudStepper @ref="_stepper"
                        @bind-ActiveIndex="_activeStep"
                        CenterLabels="true"
                        Class="custom-stepper ats-appform-stepper">
                <ChildContent>

                    <!-- STEP 1 -->
                    <MudStep Title="Step 1" Class="ats-step-final" Completed="@(_activeStep > 0)">
                        <div class="ats-consent-step">
                            <MudGrid Class="ats-consent-step-grid">
                            <MudItem xs="12">
                                <MudPaper Elevation="0" Class="ats-consent-copy-section">
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.h6" Align="Align.Center" Class="ats-consent-title">Consent to Collect and Disclose</MudText>
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudPaper Elevation="0" Class="ats-consent-document">
                                            <MudText Typo="Typo.body2">
                                                I hereby give authorization and consent for CIBI Information Inc. ("CIBI"), acting on behalf of the company, to access and disclose information about me as stated below which may be in any national, provincial, regional or city files, including those maintained by both public and private organizations, and all public records, for the purpose of validating my identity, checking on the truthfulness of the declarations made and the authenticity of documents submitted to the Company.
                                            </MudText>

                                            <MudText Typo="Typo.subtitle2" Class="ats-consent-subheading">Employment &amp; Education</MudText>
                                            <MudText Typo="Typo.body2" class="mt-2">
                                                - Consumer credit history inquiry with a government ID verification which will include information about me including any previous bankruptcies, civil legal proceedinas, collection actions
                                                negative banking items and other information reported by my creditors, and I hereby authorize any public or private institution to provide and release to CIBI information related to my credit
                                                record.
                                            </MudText>
                                            <MudText Typo="Typo.body2" class="mt-2">
                                                - Details regarding any academic training, verification of any diplomas or degrees received; and verification of any professional accreditations, and | hereby authorize any public or private
                                                educational institution to provide and release to CIBI information related to my educational/training record.
                                            </MudText>
                                            <MudText Typo="Typo.body2" class="mt-2">
                                                - Details regarding my employment history, including employment data verifications from any employer/position I have previously held, and I hereby authorize former employer to provide
                                                and release to CIBI information related to my employment record.
                                            </MudText>

                                            <MudText Typo="Typo.subtitle2" Class="ats-consent-subheading">References</MudText>
                                            <MudText Typo="Typo.body2" class="mt-2">
                                                - References from any professional and personal associates I have provided or will provide, including information on my attendance, technical skills, interpersonal relations and any other
                                                pertinent information and i hereby authorize any professional associations to provide and release to CIBI information related to my employment record.
                                            </MudText>
                                            <MudText Typo="Typo.body2" class="mt-2">
                                                - Obtain information about myself and actions l am or have been involved in from judicial court, tribunal, regulatory body disciplinary committee of any other legal or quasi-legal authority i
                                                the Philippines and I hereby authorize these judicial or quasi-judicial bodies to provide and release to CIBI information related to my records.
                                            </MudText>

                                            <MudText Typo="Typo.subtitle2" Class="ats-consent-subheading">Release and Discharge</MudText>
                                            <MudText Typo="Typo.body2" class="mt-2">
                                                Purpose of Consent: Background Screening /Credit (Due Diligence) Check
                                            </MudText>
                                            <MudText Typo="Typo.body2" class="mt-4">
                                                I understand that the information obtained because of this authorization and consent will be held in the strictest of confidentiality by CIBi and/or the Company and will be maintained in
                                                accordance with their respective Privacy Policies. The information obtained will only be used in accordance with and to satisfy the scope for which this authorization/consent has been
                                                signed. I release, waives and forever discharge anyone who provides information in relation to this release, from any and all liability for the disclosure of information to CIBI or the Company. I
                                                certify that the information set out by me in this authorization/consent is correct.
                                            </MudText>
                                            <MudText Typo="Typo.body2" class="mt-4">
                                                You may reach out to the DPO at dpo@cibi.com.ph tor any privacy concerns.
                                            </MudText>
                                        </MudPaper>
                                    </MudItem>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12">
                                <MudPaper Elevation="0" Class="ats-signature-section">
                                    <MudGrid>
                                        <MudItem xs="12">
                                            <div class="ats-signature-block">
                                                <SafeSignaturePad Value="signatureDetails.Signature"
                                                                  ValueChanged="OnSignatureChanged"
                                                                  Class="ats-consent-signature-pad"
                                                                  Disabled="@isSaving" />
                                            </div>
                                            @if (_signatureError)
                                            {
                                                <div class="ats-signature-error">
                                                    <MudText Color="Color.Error"
                                                             Typo="Typo.caption"
                                                             Class="mb-2">
                                                        Please provide your signature.
                                                    </MudText>
                                                </div>
                                            }
                                        </MudItem>

                                        <MudItem xs="12" Class="ats-consent-fields-wrap">
                                            <MudGrid Class="ats-consent-fields" Spacing="2">
                                                <MudItem xs="12" sm="6" Class="ats-consent-field">
                                                    <label class="ats-consent-field-label">
                                                        Name <span aria-hidden="true">*</span>
                                                    </label>
                                                    <MudTextField T="string"
                                                                  @bind-Value="signatureDetails.SignerName"
                                                                  Placeholder="Juan Dela Cruz"
                                                                  Required="true"
                                                                  RequiredError="Name is required"
                                                                  Variant="Variant.Outlined"
                                                                  Margin="Margin.Dense"
                                                                  Adornment="Adornment.Start"
                                                                  AdornmentIcon="@Icons.Material.Outlined.PersonOutline"
                                                                  Class="oneplatform-rounded-input ats-consent-input" />
                                                </MudItem>

                                                <MudItem xs="12" sm="6" Class="ats-consent-field">
                                                    <label class="ats-consent-field-label">
                                                        Date <span aria-hidden="true">*</span>
                                                    </label>
                                                    <div class="ats-consent-date-wrap">
                                                        <MudIcon Icon="@Icons.Material.Outlined.CalendarToday"
                                                                 Class="ats-consent-date-leading-icon" />
                                                        <MudDatePicker @bind-Date="SignatureDate"
                                                                       Adornment="Adornment.End"
                                                                       Required="true"
                                                                       RequiredError="Date is required"
                                                                       Variant="Variant.Outlined"
                                                                       Margin="Margin.Dense"
                                                                       Class="oneplatform-rounded-input ats-consent-input ats-consent-date-input"
                                                                       DateFormat="MM/dd/yyyy"
                                                                       ReadOnly />
                                                    </div>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>
                            </MudGrid>
                        </div>
                    </MudStep>

                    <!-- STEP 2 -->
                    <MudStep Title="Step 2" Class="ats-step-one" Completed="@(_activeStep > 1)">
                        <MudPaper Elevation="0" Class="ats-step-one-shell">
                            <MudGrid Class="ats-step-one-grid" Justify="Justify.Center" AlignItems="AlignItems.Center">
                                <MudItem xs="12" md="6" Class="d-flex justify-center align-content-center">
                                    <MudPaper Elevation="0" Class="ats-step-one-hero" Style="width:100%;">
                                        <div class="ats-step-one-hero-content">
                                            <MudText Typo="Typo.h4" Class="ats-step-one-title">Get your identity verified using your PSA's live national ID verification free of charge!</MudText>
                                            <MudImage Src="/images/ats/philippine-id.png" Alt="Philippine Identification System" Class="ats-step-one-logo" />
                                        </div>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12" md="6" Class="d-flex justify-center align-center">
                                    <MudPaper Elevation="0" Class="ats-step-one-notice">
                                        <MudText Typo="Typo.h6" Class="ats-step-one-notice-title">Important Notice</MudText>
                                        <MudText Typo="Typo.body1" Class="ats-step-one-notice-text">
                                            I am a registered PSA National ID member and I voluntarily consent to share my verified information to any prospective employer I am applying for.
                                        </MudText>

                                        <div class="ats-step-one-actions">
                                            <MudRadioGroup T="string"
                                                           @bind-Value="ConsentChoice"
                                                           Class="ats-step-one-choice-group">
                                                <MudRadio T="string"
                                                          Value="@("yes")"
                                                          Class="@($"ats-step-one-choice-card {(ConsentChoice == "yes" ? "selected" : string.Empty)}")">
                                                    Yes, I agree and wish to proceed.
                                                </MudRadio>
                                                <MudRadio T="string"
                                                          Value="@("no")"
                                                          Class="@($"ats-step-one-choice-card {(ConsentChoice == "no" ? "selected" : string.Empty)}")">
                                                    No, I do not wish to proceed.
                                                </MudRadio>
                                            </MudRadioGroup>

                                            <div class="ats-step-one-button-row">
                                                <MudButton Class="ats-step-one-secondary-btn"
                                                           Disabled="@(!declineConsent || consent)"
                                                           OnClick="SkipStep">
                                                    Skip
                                                </MudButton>
                                                <MudButton Disabled="@(!consent || declineConsent)"
                                                           Class="@($"ats-step-one-proceed {(consent ? "theme-button theme-button-active" : "theme-button theme-button-inactive")}")"
                                                           OnClick="ProceedClicked">
                                                    Proceed
                                                </MudButton>
                                                <MudButton Class="ats-step-one-secondary-btn"
                                                           Disabled="@(!declineConsent || consent)"
                                                           OnClick="CancelTransaction">
                                                    Cancel
                                                </MudButton>
                                            </div>
                                        </div>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudStep>

                    <!-- STEP 3 -->
                    <MudStep Title="Step 3" Class="ats-step-two" Completed="@(_activeStep > 2)">
                        <div class="ats-step-three-scope">
                        <MudText Typo="Typo.h6" Align="Align.Center" Class="ats-step-two-title">Personal Information</MudText>
                        <MudGrid Class="ats-step-two-grid" Spacing="1">
                            <!-- Left column: Personal information fields -->
                            <MudItem xs="12" sm="6" Class="ats-step-two-column ats-step-two-fields-column">
                                <MudPaper Class="pa-3 ats-step-two-form-card" Elevation="0">
                                    <MudGrid Class="ats-step-three-fields-grid">
                                        <MudItem xs="12" Class="mt-1">
                                            <MudTextField FullWidth="true"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="personalDetails.PositionAppliedFor"
                                                          Class="name-filter oneplatform-rounded-input"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Outlined.WorkOutline"
                                                          Placeholder="e.g. Software Engineer"
                                                          Required="true"
                                                          RequiredError="Position Applied For is required"
                                                          Label="Position applied for" />
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField FullWidth="true"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="personalDetails.FirstName"
                                                          Required="true"
                                                          RequiredError="First Name is required"
                                                          Class="oneplatform-rounded-input"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Outlined.PersonOutline"
                                                          Placeholder="Juan"
                                                          Label="First name" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField FullWidth="true"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Disabled="@NoMiddleName"
                                                          @bind-Value="personalDetails.MiddleName"
                                                          Class="oneplatform-rounded-input"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Outlined.PersonOutline"
                                                          Placeholder="Santos"
                                                          Label="Middle name" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6" Class="d-flex align-center">
                                            <div class="ats-step-three-middle-check-wrap">
                                                <MudCheckBox T="bool"
                                                             Value="NoMiddleName"
                                                             ValueChanged="NoMiddleNameChange"
                                                             Label="Check if no middle name"
                                                             Class="small-checkbox-label" />
                                            </div>
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField FullWidth="true"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="personalDetails.LastName"
                                                          Required="true"
                                                          RequiredError="Last Name is required"
                                                          Class="oneplatform-rounded-input"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Outlined.PersonOutline"
                                                          Placeholder="Dela Cruz"
                                                          Label="Last name" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudSelect @bind-Value="personalDetails.Suffix"
                                                       Label="Suffix"
                                                       FullWidth="true"
                                                       Required="true"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Class="oneplatform-rounded-input">
                                                <MudSelectItem Value=@("N/A")>None</MudSelectItem>
                                                <MudSelectItem Value=@("Jr.")>Jr.</MudSelectItem>
                                                <MudSelectItem Value=@("Sr.")>Sr.</MudSelectItem>
                                                <MudSelectItem Value=@("III.")>III.</MudSelectItem>
                                                <MudSelectItem Value=@("IV.")>IV.</MudSelectItem>
                                                <MudSelectItem Value=@("V.")>V.</MudSelectItem>
                                                <MudSelectItem Value=@("VI.")>VI.</MudSelectItem>
                                                <MudSelectItem Value=@("VII.")>VII.</MudSelectItem>
                                                <MudSelectItem Value=@("VIII.")>VIII.</MudSelectItem>
                                                <MudSelectItem Value=@("IX.")>IX.</MudSelectItem>
                                                <MudSelectItem Value=@("X.")>X.</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="4" Class="ats-step-three-birthdate-field">
                                            <MudDatePicker @bind-Date="DateOfBirth"
                                                           Label="Birth date"
                                                           Adornment="Adornment.End"
                                                           Placeholder="Date"
                                                           Required="true"
                                                           RequiredError="Birth Date is required"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           MaxDate="@DateTime.Today.AddDays(-1)"
                                                           DateFormat="MM/dd/yyyy"
                                                           Class="oneplatform-rounded-input" />
                                        </MudItem>

                                        <MudItem xs="12" sm="4">
                                            <MudSelect T="string"
                                                       @bind-Value="personalDetails.Sex"
                                                       Class="oneplatform-rounded-input"
                                                       Required="true"
                                                       RequiredError="Sex is required"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Label="Sex"
                                                       FullWidth="true">
                                                <MudSelectItem Value="@("Male")">Male</MudSelectItem>
                                                <MudSelectItem Value="@("Female")">Female</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField FullWidth="true"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="personalDetails.EmailAlternative"
                                                          Required="true"
                                                          RequiredError="Alternate Email Address is required"
                                                          Class="oneplatform-rounded-input"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Outlined.Email"
                                                          Placeholder="juan.delacruz@email.com"
                                                          Validation="@((string value) => EmailValidationService.ValidateEmail(value))"
                                                          Label="Alternate email address" />
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField FullWidth="true"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="personalDetails.MobileNumber"
                                                          Validation="@((string value) => MobileNumberValidationService.ValidateMobileNumber(value))"
                                                          Required="true"
                                                          RequiredError="Phone Number is required"
                                                          Class="oneplatform-rounded-input"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Outlined.PhoneIphone"
                                                          Placeholder="+63 9XX XXX XXXX"
                                                          Label="Phone number"
                                                          Mask="@(new PatternMask("00000000000"))" />
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" sm="6" Class="ats-step-two-column ats-step-two-verification-column">
                                <MudPaper Class="ats-step-two-upload-card" Elevation="0">
                                    <div class="ats-step-two-upload-shell">
                                        <div class="ats-step-two-profile">
                                            <div class="ats-step-two-avatar-frame">
                                                @if (string.IsNullOrWhiteSpace(FaceUrl))
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="ats-step-two-avatar-placeholder" />
                                                }
                                                else
                                                {
                                                    <MudImage Src="@FaceUrl"
                                                              Alt="User Profile"
                                                              Class="ats-step-two-avatar" />
                                                }
                                            </div>

                                            @if (!string.IsNullOrEmpty(philSysId))
                                            {
                                                <div class="ats-step-two-status verified">
                                                    <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" />
                                                    <span>PhilSys verified</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ats-step-two-status not-verified">
                                                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                                                    <span>Not PhilSys verified</span>
                                                </div>
                                            }
                                        </div>

                                        <div class="ats-step-two-upload-list">
                                            <MudFileUpload T="IBrowserFile"
                                                           Validation="@((IBrowserFile file) => FileValidationService.ValidateFileSize(file))"
                                                           Accept=".pdf"
                                                           OnFilesChanged="OnGovtIdUpload"
                                                           RequiredError="Government Id is required">
                                                <CustomContent>
                                                    <MudButton Class="ats-step-two-upload-btn"
                                                               OnClick="@context.OpenFilePickerAsync">
                                                        @if (personalDetails.AdditionalGovtIDFile is not null)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Medium" Class="ats-step-two-upload-btn-icon ats-step-two-upload-pdf-icon" Color="Color.Error" />
                                                            <MudText Class="ats-step-two-upload-file-name">@personalDetails.AdditionalGovtIDFileName</MudText>
                                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                           Color="Color.Default"
                                                                           Size="Size.Small"
                                                                           Class="ats-step-two-upload-remove"
                                                                           OnClick="@(() => RemoveFileFromUploadsAsync(personalDetails.AdditionalGovtIDFile!))" />
                                                        }
                                                        else
                                                        {
                                                            <span class="ats-step-two-upload-icon-shell">
                                                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" Class="ats-step-two-upload-btn-icon" />
                                                            </span>
                                                            <span class="ats-step-two-upload-btn-text">Upload unexpired government ID</span>
                                                        }
                                                    </MudButton>
                                                </CustomContent>
                                                <SelectedTemplate />
                                            </MudFileUpload>

                                            <FileUploadValidationComponent ShowError="_govtIdError"
                                                                           ErrorText="Government ID is required." />

                                            <MudFileUpload T="IBrowserFile"
                                                           Validation="@((IBrowserFile file) => FileValidationService.ValidateFileSize(file))"
                                                           Accept=".pdf"
                                                           OnFilesChanged="OnNbiUpload"
                                                           RequiredError="NBI Clearance is required"
                                                           MaxFileSize="26214400">
                                                <CustomContent>
                                                    <MudButton Class="ats-step-two-upload-btn"
                                                               OnClick="@context.OpenFilePickerAsync">
                                                        @if (personalDetails.NBIClearanceFile is not null)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Medium" Class="ats-step-two-upload-btn-icon ats-step-two-upload-pdf-icon" Color="Color.Error" />
                                                            <MudText Class="ats-step-two-upload-file-name">@personalDetails.NBIClearanceFileName</MudText>
                                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                           Color="Color.Default"
                                                                           Size="Size.Small"
                                                                           Class="ats-step-two-upload-remove"
                                                                           OnClick="@(() => RemoveFileFromUploadsAsync(personalDetails.NBIClearanceFile!))" />
                                                        }
                                                        else
                                                        {
                                                            <span class="ats-step-two-upload-icon-shell">
                                                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" Class="ats-step-two-upload-btn-icon" />
                                                            </span>
                                                            <span class="ats-step-two-upload-btn-text">Upload NBI clearance</span>
                                                        }
                                                    </MudButton>
                                                </CustomContent>
                                                <SelectedTemplate />
                                            </MudFileUpload>

                                            <FileUploadValidationComponent ShowError="_nbiError"
                                                                           ErrorText="NBI ID is required." />

                                            <MudFileUpload T="IBrowserFile"
                                                           Accept=".pdf"
                                                           Validation="@((IBrowserFile file) => FileValidationService.ValidateFileSize(file))"
                                                           OnFilesChanged="OnCvUpload"
                                                           RequiredError="CV/Resume is required">
                                                <CustomContent>
                                                    <MudButton Class="ats-step-two-upload-btn"
                                                               OnClick="@context.OpenFilePickerAsync">
                                                        @if (personalDetails.ResumeFile is not null)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Medium" Class="ats-step-two-upload-btn-icon ats-step-two-upload-pdf-icon" Color="Color.Error" />
                                                            <MudText Class="ats-step-two-upload-file-name">@personalDetails.ResumeFileName</MudText>
                                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                           Color="Color.Default"
                                                                           Size="Size.Small"
                                                                           Class="ats-step-two-upload-remove"
                                                                           OnClick="@(() => RemoveFileFromUploadsAsync(personalDetails.ResumeFile!))" />
                                                        }
                                                        else
                                                        {
                                                            <span class="ats-step-two-upload-icon-shell">
                                                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" Class="ats-step-two-upload-btn-icon" />
                                                            </span>
                                                            <span class="ats-step-two-upload-btn-text">Upload resume file</span>
                                                        }
                                                    </MudButton>
                                                </CustomContent>
                                                <SelectedTemplate />
                                            </MudFileUpload>

                                            <FileUploadValidationComponent ShowError="_resumeError"
                                                                           ErrorText="CV/Resume is required." />
                                        </div>
                                    </div>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                        </div>
                    </MudStep>

                    <!-- STEP 4 -->
                    <MudStep Title="Step 4" Class="ats-step-three" Completed="@(_activeStep > 3)">
                        <div class="ats-step-four-scope">
                        <MudText Typo="Typo.h6" Align="Align.Center" Class="ats-appform-section-title ats-step-four-title">Address</MudText>
                        <MudGrid Class="ats-step-four-grid">
                            <!-- Address section -->
                            <MudItem xs="12" sm="4" Class="ats-step-four-field ats-step-four-address-field ats-step-four-address-main">
                                <label class="ats-step-four-field-label" for="ats-current-address">
                                    Current address <span class="ats-step-four-required" aria-hidden="true">*</span>
                                </label>
                                <MudTextField FullWidth="true"
                                              InputId="ats-current-address"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="oneplatform-rounded-input ats-step-four-control"
                                              Placeholder="No., Street, Village"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Outlined.LocationOn"
                                              @bind-Value="addressDetails.CurrentAddress"
                                              Required="true"
                                              RequiredError="Current address is required" />
                            </MudItem>
                            <MudItem xs="12" sm="2" Class="ats-step-four-field ats-step-four-address-field ats-step-four-address-detail">
                                <label class="ats-step-four-field-label" for="ats-current-city">
                                    City <span class="ats-step-four-required" aria-hidden="true">*</span>
                                </label>
                                <MudTextField FullWidth="true"
                                              InputId="ats-current-city"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="oneplatform-rounded-input ats-step-four-control"
                                              Placeholder="City"
                                              @bind-Value="addressDetails.CurrentCity"
                                              Required="true"
                                              RequiredError="City is required" />
                            </MudItem>
                            <MudItem xs="12" sm="2" Class="ats-step-four-field ats-step-four-address-field ats-step-four-address-detail">
                                <label class="ats-step-four-field-label" for="ats-current-province">
                                    State / Province <span class="ats-step-four-required" aria-hidden="true">*</span>
                                </label>
                                <MudTextField FullWidth="true"
                                              InputId="ats-current-province"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="oneplatform-rounded-input ats-step-four-control"
                                              Placeholder="State / Province"
                                              @bind-Value="addressDetails.CurrentProvince"
                                              Required="true"
                                              RequiredError="State / Province is required" />
                            </MudItem>
                            <MudItem xs="12" sm="2" Class="ats-step-four-field ats-step-four-address-field ats-step-four-address-detail">
                                <label class="ats-step-four-field-label" for="ats-current-country">
                                    Country <span class="ats-step-four-required" aria-hidden="true">*</span>
                                </label>
                                <MudTextField FullWidth="true"
                                              InputId="ats-current-country"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="name-filter oneplatform-rounded-input ats-step-four-control"
                                              Placeholder="Country"
                                              @bind-Value="addressDetails.CurrentCountry"
                                              Required="true"
                                              RequiredError="Country is required" />
                            </MudItem>
                            <MudItem xs="12" sm="2" Class="ats-step-four-field ats-step-four-address-field ats-step-four-address-detail">
                                <label class="ats-step-four-field-label" for="ats-current-postal-code">
                                    Zip / Postal code <span class="ats-step-four-required" aria-hidden="true">*</span>
                                </label>
                                <MudTextField FullWidth="true"
                                              InputId="ats-current-postal-code"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="oneplatform-rounded-input ats-step-four-control"
                                              Placeholder="Zip / Postal code"
                                              @bind-Value="addressDetails.CurrentPostalCode"
                                              Required="true"
                                              Mask="@(new PatternMask("00000000000"))"
                                              RequiredError="Zip / Postal code is required" />
                            </MudItem>

                            <MudItem xs="12" Class="ats-step-four-same-address">
                                <MudCheckBox T="bool"
                                             Class="small-checkbox-label"
                                             Value="SameAsPermanent"
                                             Disabled="@(string.IsNullOrEmpty(addressDetails.CurrentAddress))"
                                             ValueChanged="OnSameAsPermanentChanged"
                                             Label="Check if current address is the same as permanent address" />
                            </MudItem>

                            <MudItem xs="12" sm="4" Class="ats-step-four-field ats-step-four-address-field ats-step-four-address-main">
                                <label class="ats-step-four-field-label" for="ats-permanent-address">
                                    Permanent address <span class="ats-step-four-required" aria-hidden="true">*</span>
                                </label>
                                <MudTextField FullWidth="true"
                                              InputId="ats-permanent-address"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="oneplatform-rounded-input ats-step-four-control"
                                              Placeholder="No., Street, Village"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Outlined.LocationOn"
                                              Disabled="SameAsPermanent"
                                              @bind-Value="addressDetails.PermanentAddress"
                                              Required="true"
                                              RequiredError="Permanent address is required" />
                            </MudItem>
                            <MudItem xs="12" sm="2" Class="ats-step-four-field ats-step-four-address-field ats-step-four-address-detail ats-step-four-permanent-detail">
                                <label class="ats-step-four-field-label" for="ats-permanent-city">
                                    City <span class="ats-step-four-required" aria-hidden="true">*</span>
                                </label>
                                <MudTextField FullWidth="true"
                                              InputId="ats-permanent-city"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="oneplatform-rounded-input ats-step-four-control"
                                              Placeholder="City"
                                              Disabled="SameAsPermanent"
                                              @bind-Value="addressDetails.PermanentCity"
                                              Required="true"
                                              RequiredError="City is required" />
                            </MudItem>
                            <MudItem xs="12" sm="2" Class="ats-step-four-field ats-step-four-address-field ats-step-four-address-detail ats-step-four-permanent-detail">
                                <label class="ats-step-four-field-label" for="ats-permanent-province">
                                    State / Province <span class="ats-step-four-required" aria-hidden="true">*</span>
                                </label>
                                <MudTextField FullWidth="true"
                                              InputId="ats-permanent-province"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="oneplatform-rounded-input ats-step-four-control"
                                              Placeholder="State / Province"
                                              Disabled="SameAsPermanent"
                                              @bind-Value="addressDetails.PermanentProvince"
                                              Required="true"
                                              RequiredError="State / Province is required" />
                            </MudItem>
                            <MudItem xs="12" sm="2" Class="ats-step-four-field ats-step-four-address-field ats-step-four-address-detail ats-step-four-permanent-detail">
                                <label class="ats-step-four-field-label" for="ats-permanent-country">
                                    Country <span class="ats-step-four-required" aria-hidden="true">*</span>
                                </label>
                                <MudTextField FullWidth="true"
                                              InputId="ats-permanent-country"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="name-filter oneplatform-rounded-input ats-step-four-control"
                                              Placeholder="Country"
                                              Disabled="SameAsPermanent"
                                              @bind-Value="addressDetails.PermanentCountry"
                                              Required="true"
                                              RequiredError="Country is required" />
                            </MudItem>
                            <MudItem xs="12" sm="2" Class="ats-step-four-field ats-step-four-address-field ats-step-four-address-detail ats-step-four-permanent-detail">
                                <label class="ats-step-four-field-label" for="ats-permanent-postal-code">
                                    Zip / Postal code <span class="ats-step-four-required" aria-hidden="true">*</span>
                                </label>
                                <MudTextField FullWidth="true"
                                              InputId="ats-permanent-postal-code"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="oneplatform-rounded-input ats-step-four-control"
                                              Placeholder="Zip / Postal code"
                                              Disabled="SameAsPermanent"
                                              @bind-Value="addressDetails.PermanentPostalCode"
                                              Required="true"
                                              Mask="@(new PatternMask("00000000000"))"
                                              RequiredError="Zip / Postal code is required" />
                            </MudItem>

                            <!-- Ownership -->
                            <MudItem xs="12" Class="ats-step-four-ownership">
                                <MudText Typo="Typo.subtitle1" Align="Align.Left">Type of ownership (current address)</MudText>
                                <div class="ats-step-four-ownership-options">
                                    <MudRadioGroup T="string"
                                                   @bind-Value="addressDetails.TypeOfOwnership"
                                                   Required="true"
                                                   RequiredError="Type of Ownership is required"
                                                   Class="ats-ownership-pills">
                                        <MudRadio T="string" Class="@($"ats-ownership-pill {(addressDetails.TypeOfOwnership == "Owned" ? "selected" : string.Empty)}")" Value="@("Owned")">
                                            Owned
                                        </MudRadio>
                                        <MudRadio T="string" Class="@($"ats-ownership-pill {(addressDetails.TypeOfOwnership == "Rent" ? "selected" : string.Empty)}")" Value="@("Rent")">
                                            Rent
                                        </MudRadio>
                                        <MudRadio T="string" Class="@($"ats-ownership-pill {(addressDetails.TypeOfOwnership == "Living with family / relatives" ? "selected" : string.Empty)}")" Value="@("Living with family / relatives")">
                                            Living with family / relatives
                                        </MudRadio>
                                        <MudRadio T="string" Class="@($"ats-ownership-pill {(addressDetails.TypeOfOwnership == "Others" ? "selected" : string.Empty)}")" Value="@("Others")">
                                            Others
                                        </MudRadio>
                                    </MudRadioGroup>
                                </div>
                            </MudItem>

                            @if (addressDetails.TypeOfOwnership == "Others")
                            {
                                <MudItem xs="12" sm="4" Class="ats-step-four-field ats-step-four-other-field">
                                    <label class="ats-step-four-field-label" for="ats-ownership-other">
                                        Please specify <span class="ats-step-four-required" aria-hidden="true">*</span>
                                    </label>
                                    <MudTextField Variant="Variant.Outlined"
                                                  InputId="ats-ownership-other"
                                                  Margin="Margin.Dense"
                                                  Class="oneplatform-rounded-input ats-step-four-control"
                                                  Placeholder="Type of ownership"
                                                  @bind-Value="OwnershipOtherText"
                                                  Required="true"
                                                  RequiredError="Please specify is required" />
                                </MudItem>
                            }

                            <!-- Educational Background -->
                            <MudItem xs="12" Class="ats-step-four-education-heading">
                                <MudText Typo="Typo.h6" Class="ats-appform-section-title ats-step-four-education-title" Align="Align.Center">Educational Background</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6" Class="ats-step-four-field ats-step-four-education-field ats-step-four-education-main">
                                <label class="ats-step-four-field-label" for="ats-highest-attainment">
                                    Highest educational attainment <span class="ats-step-four-required" aria-hidden="true">*</span>
                                </label>
                                <MudSelect T="string"
                                           @bind-Value="HighestEducationalAttainment"
                                           InputId="ats-highest-attainment"
                                           Class="oneplatform-rounded-input ats-step-four-control"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Required="true"
                                           Placeholder="Select attainment"
                                           Adornment="Adornment.Start"
                                           AdornmentIcon="@Icons.Material.Outlined.School"
                                           FullWidth="true">
                                    <MudSelectItem Value="@("None")">None</MudSelectItem>
                                    <MudSelectItem Value="@("Elementary Graduate")">Elementary Graduate</MudSelectItem>
                                    <MudSelectItem Value="@("Junior High School Graduate")">Junior High School Graduate</MudSelectItem>
                                    <MudSelectItem Value="@("Senior High School Graduate")">Senior High School Graduate</MudSelectItem>
                                    <MudSelectItem Value="@("College Graduate")">College Graduate</MudSelectItem>
                                    <MudSelectItem Value="@("Master's Graduate")">Master's Graduate</MudSelectItem>
                                    <MudSelectItem Value="@("Doctorate Graduate")">Doctorate Graduate</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="3" Class="ats-step-four-field ats-step-four-education-field ats-step-four-education-side">
                                <label class="ats-step-four-field-label" for="ats-graduation-date">Graduation date</label>
                                <MudDatePicker InputId="ats-graduation-date"
                                               Adornment="Adornment.End"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Placeholder="Date"
                                               Class="oneplatform-rounded-input ats-step-four-control"
                                               Required="!DisableEducationFieldsForAboveCollege()"
                                               Disabled="DisableEducationFieldsForAboveCollege()"
                                               @bind-Date="GraduationDate"
                                               MaxDate="@DateTime.Now"
                                               DateFormat="MM/dd/yyyy" />
                            </MudItem>

                            <MudItem xs="12" sm="6" Class="ats-step-four-field ats-step-four-education-field ats-step-four-education-main">
                                <label class="ats-step-four-field-label" for="ats-degree-major">Degree with major</label>
                                <MudTextField FullWidth="true"
                                              InputId="ats-degree-major"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Required="!DisableEducationForBelowCollege()"
                                              Disabled="DisableEducationForBelowCollege()"
                                              Class="oneplatform-rounded-input ats-step-four-control"
                                              Placeholder="e.g. BS Computer Science"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Outlined.Description"
                                              @bind-Value="DegreeWithMajor"
                                              />
                            </MudItem>

                            <MudItem xs="12" sm="3" Class="ats-step-four-field ats-step-four-education-field ats-step-four-education-side ats-step-four-education-upload">
                                <span class="ats-step-four-field-label ats-step-four-upload-label" aria-hidden="true">&nbsp;</span>
                                <MudFileUpload T="IBrowserFile"
                                               Validation="@((IBrowserFile file) => FileValidationService.ValidateFileSize(file))"
                                               Accept=".pdf"
                                               Disabled="DisableEducationFieldsForAboveCollege()"
                                               OnFilesChanged="OnDiplomaUpload">
                                    <CustomContent>
                                        <MudButton Class="oneplatform-rounded-input w-100 ats-upload-outline-btn"
                                                   OnClick="@context.OpenFilePickerAsync">
                                            @if (educationalBackground.DiplomaFile is not null)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" Class="ats-step-four-upload-file-icon" Color="Color.Error" />
                                                <MudText Class="ats-step-four-upload-file-name">@educationalBackground.DiplomaFileName</MudText>
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Color="Color.Default"
                                                               Size="Size.Small"
                                                               Class="ats-step-four-upload-remove"
                                                               OnClick="@(() => RemoveFileFromUploadsAsync(educationalBackground.DiplomaFile!))" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" />
                                                <span class="ats-step-four-upload-copy">Upload diploma / TOR</span>
                                            }
                                        </MudButton>
                                    </CustomContent>
                                    <SelectedTemplate />
                                </MudFileUpload>
                                <FileUploadValidationComponent ShowError="_diplomaError"
                                                               ErrorText="Diploma is required." />
                            </MudItem>
                            
                            <MudItem xs="12" sm="6" Class="ats-step-four-field ats-step-four-academic-institution">
                                <label class="ats-step-four-field-label" for="ats-academic-institution">Academic institution</label>
                                <MudTextField FullWidth="true"
                                              InputId="ats-academic-institution"
                                              Variant="Variant.Outlined"
                                              Required="!DisableEducationFieldsForAboveCollege()"
                                              Disabled="DisableEducationFieldsForAboveCollege()"
                                              Margin="Margin.Dense"
                                              Class="oneplatform-rounded-input ats-step-four-control"
                                              Placeholder="University or school name"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Outlined.Apartment"
                                              @bind-Value="AcademicInstitution"
                                              RequiredError="Academic institution is required" />
                            </MudItem>
                        </MudGrid>
                        </div>
                    </MudStep>

                    <!-- STEP 5 -->
                    <MudStep Title="Step 5" Class="ats-step-four" Completed="@(_activeStep > 4)">
                        <div class="ats-step-five-scope">
                        <MudText Typo="Typo.h6" Align="Align.Center" Class="ats-appform-section-title ats-step-five-title">Credentials, Licenses &amp; Professional Experience</MudText>
                        <MudGrid Class="ats-step-five-grid">
                            <MudItem xs="12" Class="ats-license-prompt">
                                <div class="ats-license-prompt-content">

                                    <MudText Typo="Typo.h6" Class="ats-license-question">
                                        Do you have a Professional License?
                                    </MudText>

                                    <div class="ats-license-segment">
                                        <MudButton Class="@(hasProfessionalLicense ? "ats-license-segment-btn active" : "ats-license-segment-btn")"
                                                   OnClick="() => hasProfessionalLicense = true">
                                            Yes
                                        </MudButton>

                                        <MudButton Class="@(!hasProfessionalLicense ? "ats-license-segment-btn active no" : "ats-license-segment-btn")"
                                                   OnClick="() => hasProfessionalLicense = false">
                                            No
                                        </MudButton>
                                    </div>

                                </div>
                            </MudItem>

                            @if (hasProfessionalLicense == true)
                            {
                                <MudItem xs="12" sm="8" Class="ats-license-main-field">
                                    <MudTextField FullWidth="true"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Class="oneplatform-rounded-input ats-step-five-control"
                                                  @bind-Value="licensesDetails.LicenseName"
                                                  Required="@hasProfessionalLicense"
                                                  RequiredError="Professional License is required"
                                                  Placeholder="Professional license"
                                                  Label="Professional license" />
                                </MudItem>

                                <MudItem xs="12" sm="4" Class="ats-license-side-field">
                                    <MudDatePicker Adornment="Adornment.End"
                                                   Required="@hasProfessionalLicense"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Placeholder="Date"
                                                   Class="oneplatform-rounded-input ats-step-five-control"
                                                   @bind-Date="LicenseExpiryDate"
                                                   Label="License expiry date"
                                                   MinDate="@DateTime.Now"
                                                   DateFormat="MM/dd/yyyy" />
                                </MudItem>

                                <MudItem xs="12" sm="8" Class="ats-license-main-field">
                                    <MudTextField FullWidth="true"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Class="oneplatform-rounded-input ats-step-five-control"
                                                  @bind-Value="licensesDetails.LicenseNumber"
                                                  Required="@hasProfessionalLicense"
                                                  Mask="@(new PatternMask("A00-00-000000"))"
                                                  RequiredError="License No. is required"
                                                  Placeholder="License no."
                                                  Label="License no." />
                                </MudItem>

                                <MudItem xs="12" sm="4" Class="ats-license-side-field">
                                    <span class="ats-license-upload-spacer" aria-hidden="true">&nbsp;</span>
                                    <MudFileUpload T="IBrowserFile"
                                                   Validation="@((IBrowserFile file) => FileValidationService.ValidateFileSize(file))"
                                                   Accept=".pdf"
                                                   OnFilesChanged="OnProfessionalLicenseUpload">
                                        <CustomContent>
                                            <MudButton Class="oneplatform-rounded-input w-100 ats-step-five-upload-btn"
                                                       OnClick="@context.OpenFilePickerAsync">
                                                @if (licensesDetails.LicenseUploadFile is not null)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" Class="ats-upload-file-icon" Color="Color.Error" />
                                                    <MudText Class="ats-upload-file-name">@licensesDetails.LicenseUploadFileName</MudText>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                   Color="Color.Default"
                                                                   Size="Size.Small"
                                                                   Class="ats-upload-remove"
                                                                   OnClick="@(() => RemoveFileFromUploadsAsync(licensesDetails.LicenseUploadFile!))" />
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" />
                                                    <span class="ats-upload-copy">Upload professional license</span>
                                                }
                                            </MudButton>
                                        </CustomContent>
                                        <SelectedTemplate />
                                    </MudFileUpload>
                                    <FileUploadValidationComponent ShowError="_licenseError"
                                                                   ErrorText="Professional License is Required." />
                                </MudItem>
                            }
                           

                            <MudItem xs="12">
                                <MudText Typo="Typo.h6" Class="ats-appform-section-title ats-experience-heading" Align="Align.Center">Professional Experience</MudText>
                            </MudItem>

                            <MudItem xs="12">
                                <MudPaper Elevation="0" Class="ats-employer-card">
                                    <MudGrid Class="ats-employer-grid">
                                        <MudItem xs="12" Class="ats-employer-header">
                                            <MudText Typo="Typo.subtitle2" Class="ats-employer-card-title">Employer 1</MudText>
                                        </MudItem>

                                        <MudItem xs="12" Class="ats-employer-company">
                                            <MudTextField FullWidth="true"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Class="oneplatform-rounded-input ats-step-five-control"
                                                          Required="true"
                                                          RequiredError="Company Name is required"
                                                          @bind-Value="professionalExperiences.Emp1CompanyName"
                                                          Placeholder="Company name"
                                                          Label="Company name #1" />
                                        </MudItem>

                            <MudItem xs="12" Class="d-flex ats-employer-checks">
                                <MudCheckBox T="bool" @bind-Value="professionalExperiences.Emp1CurrentlyEmployed" Class="small-checkbox-label" Label="Currently employed?" />
                                <MudCheckBox T="bool" @bind-Value="professionalExperiences.Emp1PermissionToContact" Class="small-checkbox-label" Label="With permission to contact?" />
                            </MudItem>

                            <MudItem xs="12" sm="4" Class="ats-employer-third">
                                <MudTextField FullWidth="true"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Required="true"
                                              RequiredError="Company City / Address is required"
                                              Class="oneplatform-rounded-input ats-step-five-control"
                                              @bind-Value="professionalExperiences.Emp1CompanyCity"
                                              Placeholder="City / address"
                                              Label="Company city / address #1" />
                            </MudItem>
                            <MudItem xs="12" sm="4" Class="ats-employer-third">
                                <MudTextField FullWidth="true"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Required="true"
                                              RequiredError="State / Province / Region is required"
                                              Class="oneplatform-rounded-input ats-step-five-control"
                                              @bind-Value="professionalExperiences.Emp1CompanyProvince"
                                              Placeholder="State / province"
                                              Label="State / province / region #1" />
                            </MudItem>
                            <MudItem xs="12" sm="4" Class="ats-employer-third">
                                <MudTextField FullWidth="true"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="name-filter oneplatform-rounded-input ats-step-five-control"
                                              Required="true"
                                              RequiredError="Country is required"
                                              @bind-Value="professionalExperiences.Emp1CompanyCountry"
                                              Placeholder="Country"
                                              Label="Country #1" />
                            </MudItem>
                            <MudItem xs="12" sm="6" Class="ats-employer-half">
                                <MudTextField FullWidth="true"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Required="true"
                                              Mask="@(new PatternMask("0000000000"))"
                                              RequiredError="Zip Code is required"
                                              Class="oneplatform-rounded-input ats-step-five-control"
                                              @bind-Value="professionalExperiences.Emp1CompanyPostalCode"
                                              Placeholder="Zip code"
                                              Label="Zip code #1" />
                            </MudItem>
                            <MudItem xs="12" sm="6" Class="ats-employer-half">
                                <MudDatePicker @bind-Date="DatePermittedToContact1"
                                               Label="Date permitted to contact #1"
                                               DateFormat="MM/dd/yyyy"
                                               Placeholder="Date"
                                               Required="true"
                                               Adornment="Adornment.End"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               MinDate="@DateTime.Now"
                                               Class="oneplatform-rounded-input ats-step-five-control" />
                            </MudItem>

                            <MudItem xs="12" sm="4" Class="ats-employer-third">
                                <MudTextField FullWidth="true"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Required="true"
                                              RequiredError="Job Title is required"
                                              Class="oneplatform-rounded-input ats-step-five-control"
                                              @bind-Value="professionalExperiences.Emp1JobTitle"
                                              Placeholder="Job title"
                                              Label="Job title #1" />
                            </MudItem>
                            <MudItem xs="12" sm="4" Class="ats-employer-third">
                                <MudDatePicker DateFormat="MM/dd/yyyy"
                                               @bind-Date="StartOfEmployment1"
                                               Adornment="Adornment.End"
                                               Variant="Variant.Outlined"
                                               Placeholder="Date"
                                               Margin="Margin.Dense"
                                               Required="true"
                                               Class="oneplatform-rounded-input ats-step-five-control"
                                               Label="Start date of employment #1" />
