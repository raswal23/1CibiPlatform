@page "/s&i/ats/disputeorder"
@layout ATSLayout
@attribute [RequirePermission(6, 7)]
@inject IDisputeOrderService DisputeOrderService
@inject ISnackbar Snackbar
@inherits CrudPageBase
    <TableComponent TItem="DisputeOrderListDTO"
                    @ref="ordersTable"
                    Title="Dispute orders"
                    EnableSearch="true"
                    ColumnCount="5"
                    RowsPerPage="10"
                    LoadServerData="LoadOrderData"
                    SearchString="@searchString"
                    SearchStringChanged="@((string val) => searchString = val)">

        <HeaderTemplate>
            <MudTh Class="ats-table-cell-center">Subject Name</MudTh>
            <MudTh Class="ats-table-cell-center">Status</MudTh>
            <MudTh Class="ats-table-cell-center">Order Date</MudTh>
            <MudTh Class="ats-table-cell-center">Date Completed</MudTh>
            <MudTh Class="ats-table-cell-center">Send Dispute</MudTh>
        </HeaderTemplate>

        <RowTemplate Context="o">
            @if(_loadingDisputeId == o.EmailInvitationID)
            {
                <MudTd Class="ats-table-cell-center">
                    <MudSkeleton Height="20px" Width="80%" />
                </MudTd>

                <MudTd Class="ats-table-cell-center">
                    <MudSkeleton Height="24px" Width="90px" />
                </MudTd>

                <MudTd Class="ats-table-cell-center">
                    <MudSkeleton Height="20px" Width="120px" />
                </MudTd>

                <MudTd Class="ats-table-cell-center">
                    <MudSkeleton Height="20px" Width="120px" />
                </MudTd>

                <MudTd Class="ats-table-cell-center">
                    <MudSkeleton Height="36px" Width="36px" />
                </MudTd>
            }
            else
            {
                <MudTd Class="ats-table-cell-center" DataLabel="Subject Name">
                    @($"{o.FirstName} {o.LastName}".Trim())
                </MudTd>

                <MudTd Class="ats-table-cell-center " DataLabel="Status">
                    <span class="@ATSStatusBadgeResolver.GetBadgeClass(o.DisputeCategory)">
                        @o.DisputeCategory
                    </span>
                </MudTd>

                <MudTd Class="ats-table-cell-center" DataLabel="Order Date">
                    @o.OrderCreatedAt?.ToString("MMMM dd, yyyy")
                </MudTd>

                <MudTd Class="ats-table-cell-center " DataLabel="Date Completed">
                    @(o.OrderCompletedAt?.ToString("MMMM dd, yyyy") ?? "-")
                </MudTd>

                <MudTd Class="ats-table-cell-center" DataLabel="Send Dispute">
                    <MudIconButton Icon="@Icons.Material.Filled.Send"
                                   Color="Color.Error"
                                   OnClick="@(() => MarkAsDisputed(o.EmailInvitationID, o.OrderCreatedAt, $"{o.FirstName} {o.LastName}"))" />
                </MudTd>
            }
        
        </RowTemplate>

        <NoRecordsTemplate>
            <div class="ats-console-empty-state">
                <div class="ats-console-empty-icon">⚠</div>
                <div class="ats-console-empty-title">No dispute orders</div>
                <div class="ats-console-empty-sub">Completed orders eligible for dispute within the allowed window will appear here.</div>
            </div>
        </NoRecordsTemplate>
    </TableComponent>

    <MudGrid Class="mt-3" Justify="Justify.Center">
        <MudItem xs="12" md="8">
            <div class="ats-console-notice">
                <strong>Dispute window applies</strong>
                Disputes can only be filed for orders completed within the allowed window. Submit a new order if that window has closed or reverification is needed.
            </div>
        </MudItem>
    </MudGrid>

