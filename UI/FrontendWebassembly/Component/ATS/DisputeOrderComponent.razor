@inject IDisputeOrderService DisputeOrderService
@inject ISnackbar Snackbar
@inherits CrudPageBase

<TableComponent TItem="DisputeOrderListDTO"
                @ref="ordersTable"
                Title="Dispute Orders"
                EnableSearch="true"
                ColumnCount="5"
                RowsPerPage="10"
                LoadServerData="LoadOrderData"
                SearchString="@searchString"
                SearchStringChanged="@((string val) => searchString = val)">

    <HeaderTemplate>
        <MudTh>Subject Name</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Date Completed</MudTh>
        <MudTh>Dispute</MudTh>
    </HeaderTemplate>

    <RowTemplate Context="o">
        <MudTd DataLabel="Subject Name">@($"{o.FirstName} {o.LastName}".Trim())</MudTd>
        <MudTd DataLabel="Status">@o.OrderStatus</MudTd>
        <MudTd DataLabel="Date Completed">@(o.OrdeCompletedAt?.ToString("MMMM dd, yyyy") ?? "-")</MudTd>
        <MudTd>
            <div style="display:flex; justify-content:center; align-items:center;">
                <MudCheckBox T="bool" Checked="@o.IsDiputed" Disabled="true" Color="Color.Primary" />
            </div>
        </MudTd>
    </RowTemplate>

    <NoRecordsTemplate>
        <MudText Typo="Typo.body2">No dispute orders found.</MudText>
    </NoRecordsTemplate>
</TableComponent>

<MudGrid Class="mt-0" Justify="Justify.Center">
    <MudItem xs="12" md="5" Class="d-flex justify-center">
        <MudText Align="Align.Center" Typo="Typo.caption">
            <b class="gradient-text">IMPORTANT NOTICE!</b><br />
            To preserve data and result integrity, dispute process can only be submitted for orders completed within the allowed dispute window.
            <MudSpacer/>
            Please submit a new order if dispute is no longer eligible or if reverification is required for the selected individual.
        </MudText>
    </MudItem>

</MudGrid>

