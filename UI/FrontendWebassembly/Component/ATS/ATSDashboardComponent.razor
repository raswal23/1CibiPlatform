@page "/s&i/ats/dashboard"
@layout ATSLayout
@inherits SecurePageBase
@attribute [RequirePermission(6, 7)]
@attribute [RequireATSModule(1)]
@inject IDashboardService DashboardService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>ATS - Dashboard</PageTitle>

<MudPaper Elevation="0" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       Label="Requester"
                       Value="_selectedRequester"
                       ValueChanged="OnRequesterChanged"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="IsAnyDashboardSectionLoading">
                <MudSelectItem T="string" Value="@AllRequesters">All</MudSelectItem>
                @foreach (var requester in _dashboard.Requesters)
                {
                    <MudSelectItem T="string" Value="@requester">@requester</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

<div class="ats-dashboard-grid mb-4">
        <MudPaper Elevation="0"
                  Class="ats-dashboard-chart-card ats-dashboard-chart-card-clickable"
                  role="button"
                  tabindex="0"
                  aria-label="Open User YTD Hire chart in a larger view"
                  @onclick="@(() => OpenChartDetailDialogAsync(ATSDashboardChartKeys.UserYtdHire))"
                  @onkeydown="@(eventArgs => OnChartCardKeyDown(eventArgs, ATSDashboardChartKeys.UserYtdHire))">
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="ats-dashboard-chart-title">
                User YTD Hire
            </MudText>
            @if (_isYtdHireLoading)
            {
                <div class="ats-dashboard-section-loading" role="status" aria-label="Loading User YTD Hire chart">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (HasYtdHireData)
            {
                <div class="ats-chart-legend">
                    @for (var index = 0; index < _dashboard.YtdHireSeries.Count; index++)
                    {
                        var series = _dashboard.YtdHireSeries[index];
                        <span class="ats-chart-legend-item">
                            <span class="ats-chart-legend-dot" style="background-color: @GetAreaLegendColor(index)"></span>
                            @series.Name
                        </span>
                    }
                    <span class="ats-chart-total">YTD Total: @_ytdHireGrandTotal</span>
                </div>
                <div class="ats-stacked-area-shell">
                    <svg class="ats-stacked-area-chart"
                         viewBox="0 0 400 245"
                         preserveAspectRatio="none"
                         role="img"
                         aria-label="Monthly hires by requester">
                        @foreach (var tick in _ytdHireYAxisTicks)
                        {
                            <line class="ats-stacked-area-grid-line"
                                  x1="@FormatSvgNumber(StackedChartLeft)"
                                  x2="@FormatSvgNumber(StackedChartWidth - StackedChartRight)"
                                  y1="@tick.Position"
                                  y2="@tick.Position" />
                        }
                        @foreach (var layer in _ytdHireLayers)
                        {
                            <polygon points="@layer.PolygonPoints"
                                     fill="@layer.Color"
                                     fill-opacity="0.20">
                                <title>@layer.Name</title>
                            </polygon>
                        }
                        @foreach (var layer in _ytdHireLayers)
                        {
                            <polyline points="@layer.LinePoints"
                                      fill="none"
                                      stroke="@layer.Color"
                                      stroke-width="2" />
                            @foreach (var point in layer.Points)
                            {
                                <circle class="ats-stacked-area-hover-target"
                                        cx="@FormatSvgNumber(point.X)"
                                        cy="@FormatSvgNumber(point.Y)"
                                        r="6"
                                        tabindex="0"
                                        focusable="true"
                                        aria-label="@($"{layer.Name}, {point.Month}: {point.Value}")"
                                        @onmouseenter="@(() => ShowYtdHireHover(layer, point))"
                                        @onmouseleave="ClearYtdHireHover"
                                        @onfocus="@(() => ShowYtdHireHover(layer, point))"
                                        @onblur="ClearYtdHireHover">
                                    <title>@layer.Name - @point.Month: @point.Value</title>
                                </circle>
                            }
                        }
                        @if (_ytdHireHover is not null)
                        {
                            <circle class="ats-stacked-area-hover-marker"
                                    cx="@FormatSvgNumber(_ytdHireHover.X)"
                                    cy="@FormatSvgNumber(_ytdHireHover.Y)"
                                    r="5"
                                    fill="@_ytdHireHover.Color" />
                        }
                        <line class="ats-stacked-area-axis-line"
                              x1="@FormatSvgNumber(StackedChartLeft)"
                              x2="@FormatSvgNumber(StackedChartWidth - StackedChartRight)"
                              y1="@FormatSvgNumber(StackedChartHeight - StackedChartBottom)"
                              y2="@FormatSvgNumber(StackedChartHeight - StackedChartBottom)" />
                    </svg>
                    @if (_ytdHireHover is not null)
                    {
                        <div class="@GetYtdHireTooltipClass(_ytdHireHover)"
                             style="@GetYtdHireTooltipStyle(_ytdHireHover)"
                             role="status">
                            <span class="ats-stacked-area-tooltip-dot"
                                  style="background-color: @_ytdHireHover.Color"></span>
                            <span>
                                <strong>@_ytdHireHover.SeriesName</strong>
                                <span>@_ytdHireHover.Month: @_ytdHireHover.Value</span>
                            </span>
                        </div>
                    }
                    @foreach (var tick in _ytdHireYAxisTicks)
                    {
                        <span class="ats-stacked-area-y-label" style="top: @(tick.Position)px">@tick.Label</span>
                    }
                    <div class="ats-stacked-area-x-labels">
                    @foreach (var tick in _ytdHireXAxisTicks)
                    {
                        <span>@tick.Label</span>
                    }
                    </div>
                </div>
            }
            else
            {
                <MudText Color="Color.Secondary" Align="Align.Center" Class="ats-dashboard-empty">No hire data is available for this period.</MudText>
            }
        </MudPaper>

        <MudPaper Elevation="0"
                  Class="ats-dashboard-chart-card ats-dashboard-chart-card-clickable"
                  role="button"
                  tabindex="0"
                  aria-label="Open Candidate Response Rate chart in a larger view"
                  @onclick="@(() => OpenChartDetailDialogAsync(ATSDashboardChartKeys.CandidateResponseRate))"
                  @onkeydown="@(eventArgs => OnChartCardKeyDown(eventArgs, ATSDashboardChartKeys.CandidateResponseRate))">
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="ats-dashboard-chart-title">
                Candidate Response Rate
            </MudText>
            @if (_isCandidateResponseLoading)
            {
                <div class="ats-dashboard-section-loading" role="status" aria-label="Loading Candidate Response Rate chart">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (HasCandidateResponseData)
            {
                <div class="ats-donut-shell ats-candidate-donut">
                    <div class="ats-donut-chart">
                        <MudChart ChartType="ChartType.Donut"
                                  Width="210px"
                                  Height="210px"
                                  ChartOptions="@_donutChartOptions"
                                  ChartSeries="@_candidateResponseData.AsChartDataSet()"
                                  ChartLabels="@_candidateResponseLabels" />
                    </div>
                    @for (var index = 0; index < _dashboard.CandidateResponseRate.Categories.Count; index++)
                    {
                        var category = _dashboard.CandidateResponseRate.Categories[index];
                        <div class="@($"ats-donut-label ats-candidate-label-{index}")">
                            <span>@category.Name</span>
                            <strong>@category.Percentage.ToString("0.#")%</strong>
                        </div>
                    }
                </div>
            }
            else
            {
                <MudText Color="Color.Secondary" Align="Align.Center" Class="ats-dashboard-empty">No sent invitation data is available.</MudText>
            }
        </MudPaper>

        <MudPaper Elevation="0"
                  Class="ats-dashboard-chart-card ats-dashboard-chart-card-clickable"
                  role="button"
                  tabindex="0"
                  aria-label="Open Turnaround Time Trend chart in a larger view"
                  @onclick="@(() => OpenChartDetailDialogAsync(ATSDashboardChartKeys.TurnaroundTimeTrend))"
                  @onkeydown="@(eventArgs => OnChartCardKeyDown(eventArgs, ATSDashboardChartKeys.TurnaroundTimeTrend))">
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="ats-dashboard-chart-title">
                Turnaround Time Trend
            </MudText>
            @if (_isTurnaroundTimeLoading)
            {
                <div class="ats-dashboard-section-loading" role="status" aria-label="Loading Turnaround Time Trend chart">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (HasTurnaroundTimeData)
            {
                <div class="ats-chart-legend">
                    @for (var index = 0; index < _dashboard.TurnaroundTimeTrend.Count; index++)
                    {
                        var series = _dashboard.TurnaroundTimeTrend[index];
                        <span class="ats-chart-legend-item">
                            <span class="ats-chart-legend-dot" style="background-color: @GetAreaLegendColor(index)"></span>
                            @series.Name
                        </span>
                    }
                </div>
                <div class="ats-line-chart-shell">
                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@_turnaroundTimeSeries"
                              ChartLabels="@_turnaroundTimeLabels"
                              ChartOptions="@_lineChartOptions"
                              Width="100%"
                              Height="227px" />
                </div>
            }
            else
            {
                <MudText Color="Color.Secondary" Align="Align.Center" Class="ats-dashboard-empty">No report-volume data is available for the last seven reporting days.</MudText>
            }
        </MudPaper>

        <MudPaper Elevation="0"
                  Class="ats-dashboard-chart-card ats-dashboard-chart-card-clickable"
                  role="button"
                  tabindex="0"
                  aria-label="Open Completion Rate chart in a larger view"
                  @onclick="@(() => OpenChartDetailDialogAsync(ATSDashboardChartKeys.CompletionRate))"
                  @onkeydown="@(eventArgs => OnChartCardKeyDown(eventArgs, ATSDashboardChartKeys.CompletionRate))">
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="ats-dashboard-chart-title">
                Completion Rate
            </MudText>
            @if (_isCompletionRateLoading)
            {
                <div class="ats-dashboard-section-loading" role="status" aria-label="Loading Completion Rate chart">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (HasCompletionRateData)
            {
                <div class="ats-donut-shell ats-completion-donut">
                    <div class="ats-donut-chart">
                        <MudChart ChartType="ChartType.Donut"
                                  Width="210px"
                                  Height="210px"
                                  ChartOptions="@_donutChartOptions"
                                  ChartSeries="@_completionRateData.AsChartDataSet()"
                                  ChartLabels="@_completionRateLabels" />
                    </div>
                    @for (var index = 0; index < _dashboard.CompletionRate.Categories.Count; index++)
                    {
                        var category = _dashboard.CompletionRate.Categories[index];
                        <div class="@($"ats-donut-label ats-completion-label-{index}")">
                            <span>@category.Name</span>
                            <strong>@category.Percentage.ToString("0.#")%</strong>
                        </div>
                    }
                </div>
            }
            else
            {
                <MudText Color="Color.Secondary" Align="Align.Center" Class="ats-dashboard-empty">No report completion data is available.</MudText>
            }
        </MudPaper>
    </div>

<div class="ats-dashboard-table-shell" aria-busy="@_isRecentOrdersLoading">
    <div class="search-report-results-scope">
        <TableComponent TItem="TransactionRow"
                        @ref="transactionsTable"
                        Title="Recent Orders"
                        ContainerClass="ats-management-card search-report-results"
                        EnableSearch="false"
                        ColumnCount="6"
                        RowsPerPage="10"
						PageSizeOptions="@(new[] { 10, 25, 50, 100 })"
                        LoadServerData="LoadTransactionData">

            <HeaderTemplate>
                <MudTh>Ticket Number</MudTh>
                <MudTh>Subject Name</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Result</MudTh>
                <MudTh>Date Endorsed</MudTh>
                <MudTh>Completion Date</MudTh>
            </HeaderTemplate>

            <RowTemplate Context="tx">
                <MudTd DataLabel="Ticket Number">
                    <span class="report-ticket">@tx.DummyTicketNumber</span>
                </MudTd>
                <MudTd DataLabel="Subject Name">
                    <div class="report-subject">
                        <span class="report-avatar">@GetRecentOrderInitials(tx.Subject)</span>
                        <span class="report-name">@(tx.Subject ?? "-")</span>
                    </div>
                </MudTd>
                <MudTd DataLabel="Status">
                    <span class="report-status @GetRecentOrderStatusClass(tx.Status)">@(tx.Status ?? "-")</span>
                </MudTd>
                <MudTd DataLabel="Result">
                    <span class="report-hit @GetRecentOrderResultClass(tx.Result)">@(tx.Result ?? "-")</span>
                </MudTd>
                <MudTd Class="report-date" DataLabel="Date Endorsed">@(tx.DateEndorsed?.ToString("MMMM dd, yyyy") ?? "-")</MudTd>
                <MudTd Class="report-date" DataLabel="Completion Date">@(tx.CompletionDate?.ToString("MMMM dd, yyyy") ?? "-")</MudTd>
            </RowTemplate>

            <NoRecordsTemplate>
                <div class="ats-console-empty-state">
                    <div class="ats-console-empty-icon">📄</div>
                    <div class="ats-console-empty-title">No recent orders are available</div>
                    <div class="ats-console-empty-sub">New orders will appear here when they become available.</div>
                </div>
            </NoRecordsTemplate>
        </TableComponent>
    </div>
    @if (_isRecentOrdersLoading)
    {
        <div class="ats-dashboard-table-loading-overlay"
             role="status"
             aria-label="Loading Recent Orders table">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
</div>
