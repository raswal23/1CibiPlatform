@inject FileValidationService FileValidationService
@inject IReportService ReportUploadService
@inject ISnackbar Snackbar

<MudDialog Class="um-dialog ats-upload-report-dialog ats-scroll-dialog" Style="padding: 0; width: min(520px, calc(100vw - 24px)); max-width: 520px;">
    <DialogContent>
<div class="ats-upload-report-shell ats-dialog-shell">
                <div class="ats-upload-report-shell-header ats-dialog-header">
                    <div class="ats-upload-report-header-left">
                        <span class="ats-upload-report-header-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 4v12M12 16l-4.5-4.5M12 16l4.5-4.5" /><path d="M4 18v1.5A1.5 1.5 0 005.5 21h13a1.5 1.5 0 001.5-1.5V18" /></svg>
                        </span>
                        <div>
                            <MudText Typo="Typo.h5" Class="ats-upload-report-shell-title">Upload report</MudText>
                            <MudText Typo="Typo.body1" Class="ats-upload-report-shell-subtitle">Attach the final report and update its status</MudText>
                        </div>
                    </div>
                    <button type="button" class="ats-upload-report-shell-close" aria-label="Close" @onclick="CloseDialog">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                    </button>
                </div>
<MudForm @ref="uploadReportForm" Class="ats-dialog-form">
    <div class="ats-upload-report-body ats-dialog-body">
        <section class="ats-upload-report-section">
            <div class="ats-upload-report-section-head"><span>1</span><h2>Screening result</h2></div>
            <div class="ats-upload-report-section-body ats-upload-report-fields">
                <div class="ats-upload-report-field">
                    <label>Hit status <b>*</b></label>
                <MudSelect @bind-Value="reportDetails.HitStatus"
                           Placeholder="Select hit status"
                           FullWidth="true"
                           Required="true"
                           RequiredError="Hit Status is required"
                           Variant="Variant.Outlined"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Outlined.CheckCircleOutline"
                           Margin="Margin.Dense"
                           Class="ats-upload-report-select">
                    <MudSelectItem Value=@(HitStatusDisplay.Clear)>Clear</MudSelectItem>
                    <MudSelectItem Value=@(HitStatusDisplay.NotClear)>Not Clear</MudSelectItem>
                </MudSelect>
                </div>

                <div class="ats-upload-report-field">
                    <label>Report status <b>*</b></label>
                <MudSelect @bind-Value="reportDetails.ReportStatus"
                           Placeholder="Select report status"
                           FullWidth="true"
                           Required="true"
                           RequiredError="Report Status is required"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Outlined.Article"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="ats-upload-report-select">
                    <MudSelectItem Value=@("Initial Report")>Initial Report</MudSelectItem>
                    <MudSelectItem Value=@("Complete Final Report")>Complete Final Report</MudSelectItem>
                    <MudSelectItem Value=@("Closed Final Report")>Closed Final Report</MudSelectItem>
                    <MudSelectItem Value=@("Supplementary Report")>Supplementary Report</MudSelectItem>
                </MudSelect>
                </div>
            </div>
        </section>

        <section class="ats-upload-report-section">
            <div class="ats-upload-report-section-head"><span>2</span><h2>Report file</h2></div>
            <div class="ats-upload-report-section-body">
                <MudFileUpload T="IBrowserFile"
                               MaxFileSize="26214400"
                               Accept=".pdf"
                               @ref="reportFileUpload"
                               OnFilesChanged="OnReportFileUpload"
                               RequiredError="Report File is required">
                    <CustomContent>
                        <MudPaper Elevation="0" Class="ats-upload-dropzone" @onclick="context.OpenFilePickerAsync">
                            <span class="ats-upload-dropzone-icon"><MudIcon Icon="@Icons.Material.Outlined.FileUpload" Size="Size.Small" /></span>
                            <MudText Class="ats-upload-dropzone-title">Upload report file</MudText>
                            <MudText Class="ats-upload-dropzone-subtitle">PDF · drag and drop or click to browse</MudText>
                        </MudPaper>
                    </CustomContent>
                    <SelectedTemplate />
                </MudFileUpload>

                @if (reportDetails.ReportFile is not null)
                {
                    <MudPaper Elevation="0" Class="ats-upload-selected-file mt-2">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Class="ats-upload-selected-file-icon" />
                        <MudText Class="ats-upload-selected-file-name">@reportFileName</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       Class="ats-upload-selected-file-remove"
                                       OnClick="@(() => RemoveFileFromUploadsAsync(reportDetails.ReportFile))" />
                    </MudPaper>
                }
            </div>
        </section>
    </div>

                <div class="ats-upload-report-actions ats-dialog-footer">
                    <MudButton Variant="Variant.Outlined" Class="ats-upload-report-cancel" OnClick="CloseDialog">Cancel</MudButton>
                    <MudButton OnClick="SubmitUploadReport"
                               Disabled="@isUploading"
                               StartIcon="@Icons.Material.Outlined.FileUpload"
                               Class="ats-upload-report-submit">
                        @if (isUploading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Uploading...</span>
                        }
                        else
                        {
                            <span>Upload</span>
                        }
                    </MudButton>
                </div>
</MudForm>
</div>
    </DialogContent>
</MudDialog>
