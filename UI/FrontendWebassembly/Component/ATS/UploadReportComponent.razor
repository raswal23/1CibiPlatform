@inject FileValidationService FileValidationService
@inject IReportService ReportUploadService
@inject IDialogService DialogService
@inject ISnackbar Snackbar


<MudForm @ref="uploadReportForm">
    <MudPaper Elevation="0" Class="oneplatform-surface-card ats-upload-report-card">
        <div class="ats-upload-report-header">
            <div>
                <MudText Typo="Typo.h5" Class="ats-upload-report-title">Upload report</MudText>
                <MudText Typo="Typo.body1" Class="ats-upload-report-subtitle">Attach the final report and update its status</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Class="ats-upload-report-close"
                           OnClick="GoBack" />
        </div>

        <MudDivider />

        <MudGrid Spacing="2" Class="pa-4">
            <MudItem xs="12">
                <MudText Class="ats-upload-report-label">Hit status <span class="ats-upload-required">*</span></MudText>
                <MudSelect @bind-Value="reportDetails.HitStatus"
                           FullWidth="true"
                           Required="true"
                           RequiredError="Hit Status is required"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="oneplatform-rounded-input">
                    <MudSelectItem Value=@("Clear")>Clear</MudSelectItem>
                    <MudSelectItem Value=@("Not Clear")>Not Clear</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudText Class="ats-upload-report-label">Report status <span class="ats-upload-required">*</span></MudText>
                <MudSelect @bind-Value="reportDetails.ReportStatus"
                           FullWidth="true"
                           Required="true"
                           RequiredError="Report Status is required"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="oneplatform-rounded-input">
                    <MudSelectItem Value=@("Initial Report")>Initial Report</MudSelectItem>
                    <MudSelectItem Value=@("Complete Final Report")>Complete Final Report</MudSelectItem>
                    <MudSelectItem Value=@("Closed Final Report")>Closed Final Report</MudSelectItem>
                    <MudSelectItem Value=@("Supplementary Report")>Supplementary Report</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudText Class="ats-upload-report-label">Report file <span class="ats-upload-required">*</span></MudText>

                <MudFileUpload T="IBrowserFile"
                               MaxFileSize="26214400"
                               Accept=".pdf"
                               @ref="reportFileUpload"
                               OnFilesChanged="OnReportFileUpload"
                               RequiredError="Report File is required">
                    <CustomContent>
                        <MudPaper Elevation="0" Class="ats-upload-dropzone" @onclick="context.OpenFilePickerAsync">
                            <MudIcon Icon="@Icons.Material.Filled.North" Size="Size.Medium" Class="ats-upload-dropzone-icon" />
                            <MudText Class="ats-upload-dropzone-title">Upload report file</MudText>
                            <MudText Class="ats-upload-dropzone-subtitle">PDF, drag and drop or click to browse</MudText>
                        </MudPaper>
                    </CustomContent>
                    <SelectedTemplate />
                </MudFileUpload>

                @if (reportDetails.ReportFile is not null)
                {
                    <MudPaper Elevation="0" Class="ats-upload-selected-file mt-2">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Class="ats-upload-selected-file-icon" />
                        <MudText Class="ats-upload-selected-file-name">@reportFileName</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       Class="ats-upload-selected-file-remove"
                                       OnClick="@(() => RemoveFileFromUploadsAsync(reportDetails.ReportFile))" />
                    </MudPaper>
                }
            </MudItem>

            <MudItem xs="12" Class="mt-2">
                <div class="ats-upload-report-actions">
                    <MudButton Variant="Variant.Outlined"
                               Class="ats-upload-report-back"
                               OnClick="GoBack">Go back</MudButton>

                    <MudButton OnClick="SubmitUploadReport"
                               Disabled="@isUploading"
                               Class="theme-button theme-button-active ats-upload-report-submit">
                        @if (isUploading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Uploading...</span>
                        }
                        else
                        {
                            <span>Upload</span>
                        }
                    </MudButton>
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudForm>
