@page "/s&i/ats/neworder"
@layout ATSLayout
@attribute [RequirePermission(6, 7)]
@attribute [RequireATSModule(2)]
@inject IJSRuntime JS
@inject IEndorsementSubmissionService EndorsementSubmissionService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject EmailValidationService EmailValidationService
@inject FileValidationService FileValidationService
@inject MobileNumberValidationService MobileNumberValidationService
@inherits CrudPageBase

<PageTitle>ATS - New Order</PageTitle>

<div class="ats-neworder-page">
    <div class="ats-segmented">
        <button class="@GetSegmentClass(false)" type="button" @onclick="() => SetOrderMode(false)">Single candidate</button>
        <button class="@GetSegmentClass(true)" type="button" @onclick="() => SetOrderMode(true)">Bulk upload</button>
    </div>

    @if (!isBulkMode)
    {
        <MudPaper Class="pa-5 mb-5" Elevation="0">
            <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight:700; color:#0B1F3A;">Candidate details</MudText>

            <MudForm @ref="candidateForm" Disabled="@isSavingCandidate">
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="subject.LastName"
                                      Label="Last name"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="oneplatform-rounded-input"
                                      Required="true"
                                      RequiredError="Last Name is required" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="subject.FirstName"
                                      Label="First name"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="oneplatform-rounded-input"
                                      Required="true"
                                      RequiredError="First Name is required" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="subject.MiddleInitial"
                                      Label="Middle Initial"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="name-filter soneplatform-rounded-input" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="subject.EmailAddress"
                                      Label="Email address"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="oneplatform-rounded-input"
                                      Required="true"
                                      RequiredError="Email Address is required"
                                      Validation="@((string value) => EmailValidationService.ValidateEmail(value))" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="subject.MobileNumber"
                                      Label="Mobile number"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="oneplatform-rounded-input"
                                      Required="true"
                                      Mask="@(new PatternMask("00000000000"))"
                                      RequiredError="Mobile Number is required"
                                      Validation="@((string value) => MobileNumberValidationService.ValidateMobileNumber(value))" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudSelect @bind-Value="subject.SelectPackage"
                                   Label="Select package"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="oneplatform-rounded-input"
                                   Required="true"
                                   RequiredError="Package is required">
                            <MudSelectItem Value="@("Basic")">Basic</MudSelectItem>
                            <MudSelectItem Value="@("Basic 2")">Basic 2</MudSelectItem>
                            <MudSelectItem Value="@("Lite")">Lite</MudSelectItem>
                            <MudSelectItem Value="@("Package 1")">Package 1</MudSelectItem>
                            <MudSelectItem Value="@("AirBNB")">AirBNB</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color:#1E2A3C; font-weight:600;">Processing speed</MudText>
                        <div class="ats-speed-row">
                            <div class="@GetCandidateNormalCardClass()" @onclick="SelectCandidateNormal">
                                <div class="ats-speed-top">
                                    <span class="ats-speed-name">Normal</span>
                                    <span class="ats-speed-tag ats-speed-tag-standard">Standard</span>
                                </div>
                                <div class="ats-speed-sub">Results in 3-5 business days</div>
                            </div>
                            <div class="@GetCandidateRushCardClass()" @onclick="SelectCandidateRush">
                                <div class="ats-speed-top">
                                    <span class="ats-speed-name">Rush</span>
                                    <span class="ats-speed-tag ats-speed-tag-fee">+ fee</span>
                                </div>
                                <div class="ats-speed-sub">Results in 24 hours</div>
                            </div>
                        </div>
                        <MudRadioGroup @bind-Value="subject.RushNormal" Class="ats-hidden-radio-group">
                            <MudRadio Color="Color.Primary" Value="@("Normal")">Normal</MudRadio>
                            <MudRadio Color="Color.Primary" Value="@("Rush")">Rush</MudRadio>
                        </MudRadioGroup>
                    </MudItem>

                    <MudItem xs="12">
                        <div class="ats-actions-right">
                            @* <MudButton Variant="Variant.Outlined" Class="ats-ghost-btn">Save as draft</MudButton> *@
                            <MudButton Class="theme-button theme-button-active" Style="width:140px;" OnClick="OnSubmitCandidate">
                                @if (isSavingCandidate)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    <span> Saving...</span>
                                }
                                else
                                {
                                    <span>Send invite</span>
                                }
                            </MudButton>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-5 mb-5" Elevation="0">
            <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight:700; color:#0B1F3A;">Bulk invite</MudText>

            <MudForm @ref="bulkForm" Disabled="@isUploadingBulk">
                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudSelect @bind-Value="bulkUploadFileDetailsDTO.PackageType"
                                   Label="Select package"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="oneplatform-rounded-input"
                                   Required="true"
                                   RequiredError="Package is required">
                            <MudSelectItem Value="@("Basic")">Basic</MudSelectItem>
                            <MudSelectItem Value="@("Basic 2")">Basic 2</MudSelectItem>
                            <MudSelectItem Value="@("Lite")">Lite</MudSelectItem>
                            <MudSelectItem Value="@("Package 1")">Package 1</MudSelectItem>
                            <MudSelectItem Value="@("AirBNB")">AirBNB</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color:#1E2A3C; font-weight:600;">Processing speed</MudText>
                        <div class="ats-speed-row">
                            <div class="@GetBulkNormalCardClass()" @onclick="SelectBulkNormal">
                                <div class="ats-speed-top">
                                    <span class="ats-speed-name">Normal</span>
                                    <span class="ats-speed-tag ats-speed-tag-standard">Standard</span>
                                </div>
                                <div class="ats-speed-sub">Results in 3-5 business days</div>
                            </div>
                            <div class="@GetBulkRushCardClass()" @onclick="SelectBulkRush">
                                <div class="ats-speed-top">
                                    <span class="ats-speed-name">Rush</span>
                                    <span class="ats-speed-tag ats-speed-tag-fee">+ fee</span>
                                </div>
                                <div class="ats-speed-sub">Results in 24 hours</div>
                            </div>
                        </div>
                        <MudRadioGroup @bind-Value="bulkUploadFileDetailsDTO.OrderType" Class="ats-hidden-radio-group">
                            <MudRadio Color="Color.Primary" Value="@("Normal")">Normal</MudRadio>
                            <MudRadio Color="Color.Primary" Value="@("Rush")">Rush</MudRadio>
                        </MudRadioGroup>
                    </MudItem>

                    <MudItem xs="12">
                        <MudFileUpload T="IBrowserFile"
                                       Validation="@((IBrowserFile file) => FileValidationService.ValidateFileSize(file))"
                                       @ref="@bulkFileUpload"
                                       OnFilesChanged="OnBulkFileUpload"
                                       Accept=".csv"
                                       DragAndDrop="true"
                                       Class="ats-bulk-upload-control">
                            <CustomContent>
                                <div class="ats-upload-box" @onclick="async () => await context.OpenFilePickerAsync()">
                                    <div class="ats-upload-icon">↑</div>
                                    <div class="ats-upload-title">Upload a CSV file</div>
                                    <div class="ats-upload-sub">Drag and drop, or click to browse</div>
                                </div>
                            </CustomContent>
                            <SelectedTemplate />
                        </MudFileUpload>
                    </MudItem>

                    <MudItem xs="12">
                        <div class="ats-template-link">
                            Don't have a file?
                            <MudLink OnClick="DownloadTemplate" Class="ml-1">Download template</MudLink>
                        </div>
                    </MudItem>

                    @if (bulkUploadFileDetailsDTO.BulkFile is not null)
                    {
                        <MudItem xs="12">
                            <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #E3E9F1; border-radius:10px;">
                                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 88%;">
                                        @bulkUploadFileDetailsDTO.BulkFile!.Name (@($"{bulkUploadFileDetailsDTO.BulkFile!.Size / 1024d:N1} kB"))
                                    </MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Color="Color.Default"
                                                   Size="Size.Small"
                                                   OnClick="@(() => RemoveFileFromUploadsAsync(bulkUploadFileDetailsDTO.BulkFile!))" />
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }

                    <MudItem xs="12">
                        <div class="ats-actions-right">
                            <MudButton Variant="Variant.Outlined" Class="ats-ghost-btn" OnClick="ResetBulkFormAsync">Cancel</MudButton>
                            <MudButton Class="theme-button theme-button-active" Style="width:170px;" OnClick="OnSubmitBulk">
                                @if (isUploadingBulk)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    <span> Uploading...</span>
                                }
                                else if (isPreview)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <span>Upload and send</span>
                                }
                            </MudButton>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudPaper>
    }
</div>
