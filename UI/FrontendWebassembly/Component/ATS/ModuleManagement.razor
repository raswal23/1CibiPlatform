@page "/s&i/ats/modulemanagement"
@layout ATSLayout
@attribute [RequirePermission(6, 7)]
@inject IModuleManagementService ModuleManagementService
@inject ISnackbar Snackbar
@inherits CrudPageBase

<PageTitle>ATS - Module Management</PageTitle>

<div style="margin-bottom: 20px; display: flex; justify-content: flex-end;">
    <MudButton Class="theme-button theme-button-active" OnClick="AddNewModule">
        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" /> Add Module
    </MudButton>
</div>

<TableComponent TItem="ModuleDetailsDTO"
                @ref="modulesTable"
                Title="Modules"
                EnableSearch="true"
                ColumnCount="6"
                RowsPerPage="10"
                LoadServerData="LoadModuleData"
                SearchString="@searchString"
                SearchStringChanged="@((string val) => searchString = val)">

    <HeaderTemplate>
        <MudTh Class="ats-table-cell-center">Module Name</MudTh>
        <MudTh Class="ats-table-cell-center">Module Description</MudTh>
        <MudTh Class="ats-table-cell-center">Status</MudTh>
        <MudTh Class="ats-table-cell-center">Created Date</MudTh>
        <MudTh Class="ats-table-cell-center">Updated Date</MudTh>
        <MudTh Class="ats-table-cell-center">Actions</MudTh>
    </HeaderTemplate>

    <RowTemplate Context="m">
        <MudTd Class="ats-table-cell-center" DataLabel="Module Name">
            @m.ModuleName
        </MudTd>

        <MudTd Class="ats-table-cell-center" DataLabel="Module Description">
            @m.ModuleDescription
        </MudTd>

        <MudTd Class="ats-table-cell-center" DataLabel="Status">
            <span class="@(m.IsActive ? "ats-status-badge ats-status-success" : "ats-status-badge ats-status-error")">
                @(m.IsActive ? "Active" : "Disabled")
            </span>
        </MudTd>

        <MudTd Class="ats-table-cell-center" DataLabel="Created Date">
            @m.CreatedAt.ToString("MMMM dd, yyyy")
        </MudTd>

        <MudTd Class="ats-table-cell-center" DataLabel="Updated Date">
            @m.UpdatedAt.ToString("MMMM dd, yyyy")
        </MudTd>

        <MudTd Class="ats-table-cell-center" DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="@(() => EditModule(m))" />
        </MudTd>
    </RowTemplate>

    <NoRecordsTemplate>
        <div class="ats-console-empty-state">
            <div class="ats-console-empty-icon">▦</div>
            <div class="ats-console-empty-title">No modules</div>
            <div class="ats-console-empty-sub">Create a new module to get started.</div>
        </div>
    </NoRecordsTemplate>
</TableComponent>

@code {
    private string searchString = string.Empty;
    private TableComponent<ModuleDetailsDTO>? modulesTable;

    private async Task<TableData<ModuleDetailsDTO>> LoadModuleData(TableState state, CancellationToken cancellationToken)
        => await LoadPagedDataAsync(state, (page, pageSize) =>
            ModuleManagementService.GetModulesAsync(page, pageSize, searchString, cancellationToken));

    private async Task AddNewModule()
    {
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddModuleComponent>("Add Module", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var moduleDTO = (AddATSModuleDTO)result.Data!;
                await ModuleManagementService.AddModuleAsync(moduleDTO);
                Snackbar.Add("Module added successfully", Severity.Success);
                if (modulesTable?.TableRef != null)
                    await modulesTable.TableRef.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task EditModule(ModuleDetailsDTO module)
    {
        var parameters = new DialogParameters<EditModuleComponent> { { x => x.Module, module } };
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<EditModuleComponent>("Edit Module", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var editModuleDTO = (EditATSModuleDTO)result.Data!;
                await ModuleManagementService.EditModuleAsync(editModuleDTO);
                Snackbar.Add("Module updated successfully", Severity.Success);
                if (modulesTable?.TableRef != null)
                    await modulesTable.TableRef.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}
