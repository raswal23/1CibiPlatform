@namespace FrontendWebassembly.Component.ATS
<section class="ats-success-card" aria-labelledby="ats-success-title" role="status">
    <div class="ats-success-icon-badge" aria-hidden="true">
        <svg viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2.6"
             stroke-linecap="round"
             stroke-linejoin="round">
            <path d="M5 12l5 5L20 7" />
        </svg>
    </div>

    <h1 id="ats-success-title">
        <span>Submission</span> <span>Complete</span>
    </h1>
    <p class="ats-success-thanks">Thank you!</p>
    <p class="ats-success-description">
        You will receive a notification confirming that your form has been completed. Please don't hesitate to reach out to us or your designated HR/Recruiter if you have any questions.
    </p>
</section>
