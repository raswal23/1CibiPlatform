@page "/s&i/ats/usermanagement"
@layout ATSLayout
@attribute [RequirePermission(6, 7)]
@attribute [RequireATSModule(10)]
@inject IATSUserManagementService UserManagementService
@inject IClientManagementService ClientManagementService
@inject IRoleManagementService RoleManagementService
@inject IModuleManagementService ModuleManagementService
@inject ISnackbar Snackbar
@inherits CrudPageBase

<PageTitle>ATS - User Management</PageTitle>

<div class="ats-users-page ats-management-page">
    <div class="ats-users-actions">
        <button type="button" class="ats-users-button ats-users-button-outline" @onclick="AssignClient">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 20V6.5A1.5 1.5 0 0 1 5.5 5h5A1.5 1.5 0 0 1 12 6.5V20" />
                <path d="M12 11h6.5a1.5 1.5 0 0 1 1.5 1.5V20" />
                <path d="M7 9h1M7 12h1M7 15h1" stroke-linecap="round" />
            </svg>
            Assign client
        </button>
        <button type="button" class="ats-users-button ats-users-button-primary" @onclick="AddNewUser">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Add user
        </button>
    </div>

    <section class="ats-users-table-scope">
        <TableComponent TItem="UserManagementViewModel"
                        @ref="usersTable"
                        Title="Users"
                        TitleId="ats-users-heading"
                        ContainerClass="ats-management-card ats-users-card"
                        TableClass="ats-users-table"
                        EnableSearch="true"
                        SearchLabel=""
                        SearchPlaceholder="Search users"
                        ColumnCount="10"
                        RowsPerPage="10"
                        PageSizeOptions="@(new[] { 10, 25, 50 })"
                        LoadServerData="LoadUserData"
                        SearchString="@searchString"
                        SearchStringChanged="@((string value) => searchString = value)">

            <HeaderTemplate>
                <MudTh Class="ats-users-user-column">User</MudTh>
                <MudTh Class="ats-users-email-column">Email</MudTh>
                <MudTh>Client</MudTh>
                <MudTh>Site</MudTh>
                <MudTh>Role</MudTh>
                <MudTh Class="ats-users-modules-column">Modules</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Created date</MudTh>
                <MudTh>Updated date</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderTemplate>

            <RowTemplate Context="user">
                <MudTd DataLabel="User">
                    <div class="ats-users-user-cell">
                        <span class="ats-users-avatar">@GetUserInitials(user.UserName)</span>
                        <span class="ats-users-name">@user.UserName</span>
                    </div>
                </MudTd>
                <MudTd DataLabel="Email" Class="ats-users-muted">
                    @if (!string.IsNullOrWhiteSpace(user.UserEmail))
                    {
                        <a href="@($"mailto:{user.UserEmail}")">@user.UserEmail</a>
                    }
                    else
                    {
                        <span>Auth user unavailable</span>
                    }
                </MudTd>
                <MudTd DataLabel="Client">@user.ClientName</MudTd>
                <MudTd DataLabel="Site">@user.Site</MudTd>
                <MudTd DataLabel="Role">@user.RoleName</MudTd>
                <MudTd DataLabel="Modules">
                    <div class="ats-users-chips">
                        @foreach (var module in user.Modules.Take(4))
                        {
                            <span class="ats-users-chip">@module.ModuleName</span>
                        }
                        @if (user.Modules.Count > 4)
                        {
                            <span class="ats-users-chip ats-users-chip-more">+@(user.Modules.Count - 4) more</span>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="Status">
                    <span class="ats-users-status @(user.IsActive ? string.Empty : "is-disabled")">
                        @(user.IsActive ? "Active" : "Disabled")
                    </span>
                </MudTd>
                <MudTd DataLabel="Created date" Class="ats-users-date">
                    @user.CreatedAt.ToString("MMMM dd, yyyy")
                </MudTd>
                <MudTd DataLabel="Updated date" Class="ats-users-date">
                    @user.UpdatedAt.ToString("MMMM dd, yyyy")
                </MudTd>
                <MudTd DataLabel="Actions">
                    <button type="button"
                            class="ats-users-edit"
                            aria-label="Edit @user.UserName"
                            @onclick="() => EditUser(user)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 20h9" />
                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                        </svg>
                    </button>
                </MudTd>
            </RowTemplate>

            <NoRecordsTemplate>
                <div class="ats-users-empty">
                    <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" />
                    <strong>No users</strong>
                    <span>Create a new user to get started.</span>
                </div>
            </NoRecordsTemplate>
        </TableComponent>
    </section>
</div>

@code {
    private const string SuperAdminEmail = "admin@cibi.com";
    private string searchString = string.Empty;
    private TableComponent<UserManagementViewModel>? usersTable;
    private IReadOnlyList<ATSUserLookupDTO> authUsers = Array.Empty<ATSUserLookupDTO>();
    private IReadOnlyList<ClientDetailsDTO> clients = Array.Empty<ClientDetailsDTO>();
    private IReadOnlyList<RoleDetailsDTO> roles = Array.Empty<RoleDetailsDTO>();
    private IReadOnlyList<ModuleDetailsDTO> modules = Array.Empty<ModuleDetailsDTO>();
    private IReadOnlyList<UserClientDetailsDTO> userClientAssignments = Array.Empty<UserClientDetailsDTO>();
    private Dictionary<int, ClientDetailsDTO> clientLookup = new();
    private Dictionary<int, RoleDetailsDTO> roleLookup = new();
    private Dictionary<int, ModuleDetailsDTO> moduleLookup = new();
    private Dictionary<Guid, ATSUserLookupDTO> authUserLookup = new();
    private Dictionary<Guid, UserClientDetailsDTO> userClientAssignmentLookup = new();
    private Task? referenceDataLoadTask;
    private bool referenceDataLoaded;

    private static string GetUserInitials(string? userName)
    {
        if (string.IsNullOrWhiteSpace(userName))
            return "?";

        var nameParts = userName.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (nameParts.Length == 1)
            return nameParts[0][..Math.Min(2, nameParts[0].Length)].ToUpperInvariant();

        return $"{nameParts[0][0]}{nameParts[1][0]}".ToUpperInvariant();
    }

    private async Task<TableData<UserManagementViewModel>> LoadUserData(TableState state, CancellationToken cancellationToken)
        => await LoadPagedDataAsync(state, async (page, pageSize) =>
        {
            var referenceTask = EnsureReferenceDataLoadedAsync(cancellationToken);
            var usersTask = UserManagementService.GetUsersAsync(page, pageSize, searchString, cancellationToken);
            await Task.WhenAll(referenceTask, usersTask);

            var result = await usersTask;
            var groupedUsers = result.Items
                .GroupBy(user => user.UserId)
                .Select(group =>
                {
                    var user = group.First();
                    var authUser = authUserLookup.GetValueOrDefault(user.UserId);
                    var clientId = userClientAssignmentLookup.GetValueOrDefault(user.UserId)?.ClientId ?? user.ClientId;
                    var client = clientId.HasValue ? clientLookup.GetValueOrDefault(clientId.Value) : null;
                    var role = roleLookup.GetValueOrDefault(user.RoleId);
                    var moduleIds = group.Select(assignment => assignment.ModuleId).Distinct().ToHashSet();

                    return new UserManagementViewModel
                    {
                        UserId = user.UserId,
                        UserName = authUser?.UserName ?? "Auth user unavailable",
                        UserEmail = authUser?.UserEmail ?? string.Empty,
                        IsActive = user.IsActive,
                        ClientId = clientId,
                        ClientName = client?.ClientName ?? (clientId.HasValue ? $"Client #{clientId}" : "All Clients"),
                        Site = user.Site,
                        RoleId = user.RoleId,
                        RoleName = role?.RoleName ?? $"Role #{user.RoleId}",
                        ModuleIds = moduleIds,
                        Modules = moduleIds
                            .Select(moduleId => moduleLookup.GetValueOrDefault(moduleId))
                            .Where(module => module is not null)
                            .Cast<ModuleDetailsDTO>()
                            .OrderBy(module => module.ModuleName)
                            .ToList(),
                        CreatedAt = group.Min(assignment => assignment.CreatedAt),
                        UpdatedAt = group.Max(assignment => assignment.UpdatedAt)
                    };
                })
                .OrderBy(user => user.UserName)
                .ThenBy(user => user.UserEmail)
                .ToArray();

            return new PaginatedResult<UserManagementViewModel>(
                result.PageIndex,
                result.PageSize,
                result.TotalRecords,
                groupedUsers);
        });

    private async Task EnsureReferenceDataLoadedAsync(CancellationToken cancellationToken)
    {
        if (referenceDataLoaded)
            return;

        referenceDataLoadTask ??= LoadReferenceDataAsync(cancellationToken);

        try
        {
            await referenceDataLoadTask.WaitAsync(cancellationToken);
            referenceDataLoaded = true;
        }
        catch
        {
            if (referenceDataLoadTask.IsCanceled || referenceDataLoadTask.IsFaulted)
                referenceDataLoadTask = null;
            throw;
        }
    }

    private async Task LoadReferenceDataAsync(CancellationToken cancellationToken)
    {
        var authUsersTask = UserManagementService.GetAuthUsersAsync(cancellationToken);
        var clientsTask = ClientManagementService.GetAllClientsAsync(cancellationToken);
        var rolesTask = RoleManagementService.GetAllRolesAsync(cancellationToken);
        var modulesTask = ModuleManagementService.GetAllModulesAsync(cancellationToken);
        var assignmentsTask = UserManagementService.GetUserClientAssignmentsAsync(cancellationToken);
        await Task.WhenAll(authUsersTask, clientsTask, rolesTask, modulesTask, assignmentsTask);

        authUsers = (await authUsersTask).OrderBy(user => user.UserName).ToArray();
        clients = (await clientsTask)
            .GroupBy(client => client.ClientId)
            .Select(group => group.First())
            .OrderBy(client => client.ClientName)
            .ToArray();
        roles = (await rolesTask).OrderBy(role => role.RoleName).ToArray();
        modules = (await modulesTask).OrderBy(module => module.ModuleName).ToArray();
        userClientAssignments = (await assignmentsTask).ToArray();

        clientLookup = clients.ToDictionary(client => client.ClientId);
        roleLookup = roles.ToDictionary(role => role.RoleId);
        moduleLookup = modules.ToDictionary(module => module.ModuleId);
        authUserLookup = authUsers.ToDictionary(user => user.UserId);
        userClientAssignmentLookup = userClientAssignments.ToDictionary(assignment => assignment.UserId);
    }

    private async Task AddNewUser()
    {
        if (!await EnsureReferencesForDialogAsync())
            return;

        var eligibleAuthUsers = authUsers
            .Where(user =>
                userClientAssignmentLookup.ContainsKey(user.UserId) ||
                string.Equals(user.UserEmail, SuperAdminEmail, StringComparison.OrdinalIgnoreCase))
            .ToArray();
        if (eligibleAuthUsers.Length == 0)
        {
            Snackbar.Add("Assign a client to an ATS user before adding user access.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters<AddUserComponent>
        {
            { component => component.AuthUsers, eligibleAuthUsers },
            { component => component.Roles, roles },
            { component => component.Modules, modules },
            { component => component.Assignments, userClientAssignments }
        };
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            BackdropClick = true
        };

        var dialog = await DialogService.ShowAsync<AddUserComponent>("Add User", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var addedUser = (AddATSUserDTO)result.Data!;
                await UserManagementService.AddUserAsync(addedUser);
                Snackbar.Add("User added successfully", Severity.Success);
                if (usersTable is not null)
                    await usersTable.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task AssignClient()
    {
        if (!await EnsureReferencesForDialogAsync())
            return;

        var parameters = new DialogParameters<AssignUserClientComponent>
        {
            { component => component.AuthUsers, authUsers },
            { component => component.Clients, clients },
            { component => component.Assignments, userClientAssignments }
        };
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AssignUserClientComponent>("Assign Client", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var assignment = await UserManagementService.AssignUserClientAsync(
                    (AssignATSUserClientDTO)result.Data!);
                userClientAssignments = userClientAssignments
                    .Where(item => item.UserId != assignment.UserId)
                    .Append(assignment)
                    .OrderBy(item => item.UserId)
                    .ToArray();
                userClientAssignmentLookup[assignment.UserId] = assignment;

                Snackbar.Add("Client assignment saved successfully", Severity.Success);
                if (usersTable is not null)
                    await usersTable.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task EditUser(UserManagementViewModel user)
    {
        if (!await EnsureReferencesForDialogAsync())
            return;

        var parameters = new DialogParameters<EditUserComponent>
        {
            { component => component.User, user },
            { component => component.AuthUsers, authUsers },
            { component => component.Clients, clients },
            { component => component.Roles, roles },
            { component => component.Modules, modules }
        };
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            BackdropClick = true
        };

        var dialog = await DialogService.ShowAsync<EditUserComponent>("Edit User", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                await UserManagementService.EditUserAsync((EditATSUserDTO)result.Data!);
                Snackbar.Add("User updated successfully", Severity.Success);
                if (usersTable is not null)
                    await usersTable.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task<bool> EnsureReferencesForDialogAsync()
    {
        try
        {
            await EnsureReferenceDataLoadedAsync(CancellationToken.None);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return false;
        }
    }
}
