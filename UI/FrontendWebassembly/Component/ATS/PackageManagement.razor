@page "/s&i/ats/packagemanagement"
@layout ATSLayout
@attribute [RequirePermission(6, 7)]
@attribute [RequireATSModule(6)]
@inject IPackageManagementService PackageManagementService
@inject ISnackbar Snackbar
@inherits CrudPageBase

<PageTitle>ATS - Package Management</PageTitle>

<div class="ats-management-page">
<div class="ats-management-actions">
    <button type="button" class="ats-management-button" @onclick="AddNewPackage">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
        </svg>
        Add package
    </button>
</div>

<TableComponent TItem="PackageDetailsDTO"
                @ref="packagesTable"
                Title="Packages"
                ContainerClass="ats-management-card"
                EnableSearch="true"
                SearchLabel=""
                SearchPlaceholder="Search packages"
                ColumnCount="7"
                RowsPerPage="10"
                LoadServerData="LoadPackageData"
                SearchString="@searchString"
                SearchStringChanged="@((string val) => searchString = val)">

    <HeaderTemplate>
        <MudTh Class="ats-table-cell-center">Package Name</MudTh>
        <MudTh Class="ats-table-cell-center">Description</MudTh>
        <MudTh Class="ats-table-cell-center">Follow Up Email</MudTh>
        <MudTh Class="ats-table-cell-center">Status</MudTh>
        <MudTh Class="ats-table-cell-center">Created Date</MudTh>
        <MudTh Class="ats-table-cell-center">Updated Date</MudTh>
        <MudTh Class="ats-table-cell-center">Actions</MudTh>
    </HeaderTemplate>

    <RowTemplate Context="p">
        <MudTd Class="ats-management-primary" DataLabel="Package Name">
            @p.PackageName
        </MudTd>

        <MudTd Class="ats-management-description" DataLabel="Description">
            @p.PackageDescription
        </MudTd>

        <MudTd Class="ats-management-description" DataLabel="Follow Up Email">
            @p.FollowUpEmail
        </MudTd>

        <MudTd Class="ats-table-cell-center" DataLabel="Status">
            <span class="ats-management-status @(!p.IsActive ? "is-disabled" : string.Empty)">
                @(p.IsActive ? "Active" : "Disabled")
            </span>
        </MudTd>

        <MudTd Class="ats-management-date" DataLabel="Created Date">
            @p.CreatedAt.ToString("MMMM dd, yyyy")
        </MudTd>

        <MudTd Class="ats-management-date" DataLabel="Updated Date">
            @p.UpdatedAt.ToString("MMMM dd, yyyy")
        </MudTd>

        <MudTd Class="ats-table-cell-center" DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Class="ats-management-edit"
                           Size="Size.Small"
                           OnClick="@(() => EditPackage(p))" />
        </MudTd>
    </RowTemplate>

    <NoRecordsTemplate>
        <div class="ats-management-empty">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
            <strong>No packages</strong>
            <span>Create a new package to get started.</span>
        </div>
    </NoRecordsTemplate>
</TableComponent>
</div>

@code {
    private string searchString = string.Empty;
    private TableComponent<PackageDetailsDTO>? packagesTable;

    private async Task<TableData<PackageDetailsDTO>> LoadPackageData(TableState state, CancellationToken cancellationToken)
    => await LoadPagedDataAsync(state, (page, pageSize) =>
                PackageManagementService.GetPackagesAsync(page, pageSize, searchString, cancellationToken));

    private async Task AddNewPackage()
    {
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddPackageComponent>("Add Package", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var packageDTO = (AddPackageDTO)result.Data!;
                await PackageManagementService.AddPackageAsync(packageDTO!);
                Snackbar.Add("Package added successfully", Severity.Success);
                if (packagesTable?.TableRef != null)
                    await packagesTable.TableRef.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task EditPackage(PackageDetailsDTO package)
    {
        var parameters = new DialogParameters<EditPackageComponent> { { x => x.Package, package } };
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<EditPackageComponent>("Edit Package", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var editPackageDTO = (EditPackageDTO)result.Data!;
                await PackageManagementService.EditPackageAsync(editPackageDTO);
                Snackbar.Add("Package updated successfully", Severity.Success);
                if (packagesTable?.TableRef != null)
                    await packagesTable.TableRef.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}
