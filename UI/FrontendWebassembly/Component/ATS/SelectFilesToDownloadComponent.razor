@inject IReportService ReportService
@inject IJSRuntime JS

<MudDialog Style="padding: 8px;">
     <DialogContent>
        <MudStack Spacing="2" AlignItems="AlignItems.Center">
               <MudStack Spacing="2" Style="width: 100%; max-width: 500px;">

                <MudCheckBox @bind-Value="ResumeSelected"
                             Disabled="@(string.IsNullOrEmpty(ReportResult!.ResumeFileName))"
                             Label="@(string.IsNullOrEmpty(ReportResult!.ResumeFileName) ? "No resume uploaded" : ReportResult.ResumeFileName)" />

                <MudCheckBox @bind-Value="GovernmentIdSelected"
                             Disabled="@(string.IsNullOrEmpty(ReportResult!.IdUploadedFileName))"
                             Label="@(string.IsNullOrEmpty(ReportResult!.IdUploadedFileName) ? "No government ID uploaded" : ReportResult.IdUploadedFileName)" />

                <MudCheckBox @bind-Value="DiplomaSelected"
                             Disabled="@(string.IsNullOrEmpty(ReportResult!.DiplomaFileName))"
                             Label="@(string.IsNullOrEmpty(ReportResult!.DiplomaFileName) ? "No diploma uploaded" : ReportResult.DiplomaFileName)" />

                <MudCheckBox @bind-Value="CoeSelected"
                             Disabled="@(string.IsNullOrEmpty(ReportResult!.CoeFileName))"
                             Label="@(string.IsNullOrEmpty(ReportResult!.CoeFileName) ? "No certificate of employment uploaded" : ReportResult.CoeFileName)" />

                <MudCheckBox @bind-Value="ConsentSelected"
                             Disabled="@(string.IsNullOrEmpty(ReportResult!.ConsentFormFileName))"
                             Label="@(string.IsNullOrEmpty(ReportResult!.ConsentFormFileName) ? "No consent form uploaded" : ReportResult.ConsentFormFileName)" />

                <MudCheckBox @bind-Value="ReportSelected"
                             Disabled="@(string.IsNullOrEmpty(ReportResult!.UploadedReportFileName))"
                             Label="@(string.IsNullOrEmpty(ReportResult!.UploadedReportFileName) ? "No report uploaded" : ReportResult.UploadedReportFileName)" />

            </MudStack>
        </MudStack>

        <MudDivider Class="my-4" />

        <MudGrid>
            <MudItem xs="6">
                <MudButton FullWidth="true"
                           Variant="Variant.Filled"
                           Style="border: 2px solid gray;"
                           OnClick="Cancel">
                    Cancel
                </MudButton>
            </MudItem>

            <MudItem xs="6">
                <MudButton FullWidth="true"
                           Variant="Variant.Filled"
                           Class="theme-button theme-button-active"
                           OnClick="DownloadDocumentsAsync">
                    Download
                </MudButton>
            </MudItem>
        </MudGrid>
     </DialogContent>
</MudDialog>