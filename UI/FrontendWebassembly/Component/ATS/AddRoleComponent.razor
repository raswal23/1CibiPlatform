<div class="um-dialog-shell">
    <div class="um-dialog-header">
        <div>
            <MudText Typo="Typo.h5" Class="um-dialog-title">Add role</MudText>
            <MudText Typo="Typo.body1" Class="um-dialog-subtitle">Create a new role</MudText>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Class="um-dialog-close" OnClick="Cancel" />
    </div>

    <MudDivider />

    <MudPaper Elevation="0" Class="um-dialog-body">
        <MudForm @ref="AddRoleForm">
            <MudStack Spacing="2">
                <MudTextField @bind-Value="Role.RoleName"
                              Label="Role Name"
                              Required="true"
                              RequiredError="Role Name is required"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="100"
                              Class="oneplatform-rounded-input" />

                <MudTextField @bind-Value="Role.RoleDescription"
                              Label="Role Description"
                              Required="true"
                              RequiredError="Role Description is required"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="3"
                              MaxLength="500"
                              Class="oneplatform-rounded-input" />

                <MudSelect T="bool"
                           @bind-Value="Role.IsActive"
                           Label="Status"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="oneplatform-rounded-input">
                    <MudSelectItem Value="true">Active</MudSelectItem>
                    <MudSelectItem Value="false">Inactive</MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudForm>
    </MudPaper>

    <div class="um-dialog-footer">
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Class="um-secondary-button">Cancel</MudButton>
        <MudButton OnClick="Submit" Class="theme-button theme-button-active um-primary-button">Save</MudButton>
    </div>
</div>
