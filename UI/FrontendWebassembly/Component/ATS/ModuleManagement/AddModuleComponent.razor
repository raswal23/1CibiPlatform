@namespace FrontendWebassembly.Component.ATS
<MudDialog Class="um-dialog am-dialog ats-scroll-dialog" Style="padding: 0; width: min(520px, calc(100vw - 24px)); max-width: 520px;">
    <DialogContent>
        <div class="am-shell ats-dialog-shell">
            <header class="am-header ats-dialog-header">
                <div class="am-header-row">
                    <div class="am-header-left">
                        <div class="am-icon-badge" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="3" y="3" width="7.5" height="7.5" rx="1.6" />
                                <rect x="13.5" y="3" width="7.5" height="7.5" rx="1.6" />
                                <rect x="3" y="13.5" width="7.5" height="7.5" rx="1.6" />
                                <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.6" />
                            </svg>
                        </div>
                        <div class="am-header-text">
                            <h1>Add module</h1>
                            <p>Create a new module</p>
                        </div>
                    </div>

                    <button type="button" class="am-close" aria-label="Close add module dialog" @onclick="Cancel">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                            <path d="M6 6l12 12M18 6 6 18" />
                        </svg>
                    </button>
                </div>
            </header>

            <main class="am-body ats-dialog-body">
                <MudForm @ref="AddModuleForm">
                    <section class="am-section" aria-labelledby="add-module-details-heading">
                        <div class="am-section-head">
                            <span class="am-section-number">1</span>
                            <h2 id="add-module-details-heading">Module details</h2>
                            <span class="am-section-helper">Name and describe the module</span>
                        </div>

                        <div class="am-section-body">
                            <div class="am-field">
                                <label for="am-module-name">Module name <span class="am-required">*</span></label>
                                <div class="am-input-wrap am-autocomplete-wrap">
                                    <MudAutocomplete T="string"
                                                     @bind-Value="Module.ModuleName"
                                                     InputId="am-module-name"
                                                     Placeholder="Select a module name"
                                                     Required="true"
                                                     RequiredError="Module name is required"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     MaxLength="100"
                                                     MaxItems="50"
                                                     SearchFunc="SearchModules"
                                                     ToStringFunc="@(value => value)"
                                                     ResetValueOnEmptyText="false"
                                                     Clearable="false"
                                                     Dense="true"
                                                     OpenOnFocus="true"
                                                     Adornment="Adornment.Start"
                                                     AdornmentIcon="@Icons.Material.Outlined.Apps"
                                                     OpenIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                                     CloseIcon="@Icons.Material.Filled.KeyboardArrowUp"
                                                     Class="am-control" />
                                </div>
                            </div>

                            <div class="am-field">
                                <label for="am-module-description">Module description <span class="am-required">*</span></label>
                                <div class="am-input-wrap am-description-wrap">
                                    <MudTextField @bind-Value="Module.ModuleDescription"
                                                  InputId="am-module-description"
                                                  Placeholder="What does this module let users do?"
                                                  Required="true"
                                                  RequiredError="Module description is required"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Lines="4"
                                                  Immediate="true"
                                                  MaxLength="240"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Outlined.Article"
                                                  Class="am-control am-description-control" />
                                </div>
                                <div class="am-character-count" aria-live="polite">@DescriptionLength / 240</div>
                            </div>
                        </div>
                    </section>

                    <section class="am-section" aria-labelledby="add-module-availability-heading">
                        <div class="am-section-head">
                            <span class="am-section-number">2</span>
                            <h2 id="add-module-availability-heading">Availability</h2>
                            <span class="am-section-helper">Turn the module on or off</span>
                        </div>

                        <div class="am-section-body">
                            <div class="am-field">
                                <label>Status</label>
                                <div class="am-status-row">
                                    <div class="am-status-copy">
                                        <p>Module @(Module.IsActive ? "active" : "inactive")</p>
                                        <span>Available to assign to roles once saved</span>
                                    </div>
                                    <div class="am-status-control">
                                        <span class="am-status-badge @(Module.IsActive ? string.Empty : "is-off")">
                                            @(Module.IsActive ? "Active" : "Inactive")
                                        </span>
                                        <button type="button"
                                                class="am-toggle @(Module.IsActive ? string.Empty : "is-off")"
                                                role="switch"
                                                aria-checked="@Module.IsActive.ToString().ToLowerInvariant()"
                                                aria-label="Toggle module status"
                                                @onclick="ToggleStatus">
                                            <span></span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </MudForm>
            </main>

            <footer class="am-footer ats-dialog-footer">
                <button type="button" class="am-button am-button-cancel" @onclick="Cancel">Cancel</button>
                <button type="button" class="am-button am-button-save" @onclick="Submit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5" />
                    </svg>
                    Save
                </button>
            </footer>
        </div>
    </DialogContent>
</MudDialog>
