@page "/s&i/ats/clientmanagement"
@layout ATSLayout
@attribute [RequirePermission(6, 7)]
@attribute [RequireATSModule(7)]
@inject IClientManagementService ClientManagementService
@inject IPackageManagementService PackageManagementService
@inject ISnackbar Snackbar
@inherits CrudPageBase

<PageTitle>ATS - Client Management</PageTitle>

<div class="ats-management-page">
<div class="ats-management-actions">
    <button type="button" class="ats-management-button" @onclick="AddNewClient">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
        </svg>
        Add client
    </button>
</div>


<TableComponent TItem="ClientManagementViewModel"
                @ref="clientsTable"
                Title="Clients"
                ContainerClass="ats-management-card ats-client-card"
                EnableSearch="true"
                SearchLabel=""
                SearchPlaceholder="Search clients"
                ColumnCount="7"
                RowsPerPage="10"
                LoadServerData="LoadClientData"
                SearchString="@searchString"
                SearchStringChanged="@((string val) => searchString = val)">

    <HeaderTemplate>
        <MudTh Class="ats-table-cell-center">Client Name</MudTh>
        <MudTh Class="ats-table-cell-center">Description</MudTh>
        <MudTh Class="ats-table-cell-center">Packages</MudTh>
        <MudTh Class="ats-table-cell-center">Status</MudTh>
        <MudTh Class="ats-table-cell-center">Created Date</MudTh>
        <MudTh Class="ats-table-cell-center">Updated Date</MudTh>
        <MudTh Class="ats-table-cell-center">Actions</MudTh>
    </HeaderTemplate>

    <RowTemplate Context="c">
        <MudTd Class="ats-management-primary" DataLabel="Client Name">
            <div class="ats-management-client-cell">
                <span class="ats-management-client-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" />
                    </svg>
                </span>
                <span style="font-weight: 600;">@c.ClientName</span>
            </div>
        </MudTd>

        <MudTd Class="ats-management-description" DataLabel="Description">
            @c.ClientDescription
        </MudTd>

        <MudTd Class="ats-table-cell-center" DataLabel="Packages">
            <div class="ats-management-chips">
                @foreach (var package in c.Packages.Take(4))
                {
                    <span class="ats-management-chip">@package.PackageName</span>
                }
                @if (c.Packages.Count > 4)
                {
                    <span class="ats-management-chip ats-management-chip-more">+@(c.Packages.Count - 4) more</span>
                }
            </div>
        </MudTd>

        <MudTd Class="ats-table-cell-center" DataLabel="Status">
            <span class="ats-management-status @(!c.IsActive ? "is-disabled" : string.Empty)">
                @(c.IsActive ? "Active" : "Disabled")
            </span>
        </MudTd>

        <MudTd Class="ats-management-date" DataLabel="Created Date">
            @c.CreatedAt.ToString("MMMM dd, yyyy")
        </MudTd>

        <MudTd Class="ats-management-date" DataLabel="Updated Date">
            @c.UpdatedAt.ToString("MMMM dd, yyyy")
        </MudTd>

        <MudTd Class="ats-table-cell-center" DataLabel="Actions">
            <button type="button"
                    class="ats-management-edit ats-management-edit-button"
                    aria-label="Edit @c.ClientName"
                    @onclick="@(() => EditClient(c))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                </svg>
            </button>
        </MudTd>
    </RowTemplate>

    <NoRecordsTemplate>
        <div class="ats-management-empty">
            <MudIcon Icon="@Icons.Material.Filled.Business" />
            <strong>No clients</strong>
            <span>Create a new client to get started.</span>
        </div>
    </NoRecordsTemplate>
</TableComponent>
</div>

@code {
    private string searchString = string.Empty;
    private TableComponent<ClientManagementViewModel>? clientsTable;
    private IReadOnlyList<PackageDetailsDTO> packages = Array.Empty<PackageDetailsDTO>();
    private Dictionary<int, PackageDetailsDTO> packageLookup = new();
    private Task<IReadOnlyList<PackageDetailsDTO>>? packagesLoadTask;
    private bool packagesLoaded;

    private async Task<TableData<ClientManagementViewModel>> LoadClientData(TableState state, CancellationToken cancellationToken)
    => await LoadPagedDataAsync(state, async (page, pageSize) =>
    {
        var packagesTask = EnsurePackagesLoadedAsync(cancellationToken);
        var clientsTask = ClientManagementService.GetClientsAsync(page, pageSize, searchString, cancellationToken);
        await Task.WhenAll(packagesTask, clientsTask);

        var result = await clientsTask;
        var groupedClients = result.Items
            .GroupBy(client => client.ClientId)
            .Select(group =>
            {
                var client = group.First();
                return new ClientManagementViewModel
                {
                    ClientId = client.ClientId,
                    ClientName = client.ClientName,
                    ClientDescription = client.ClientDescription,
                    IsActive = client.IsActive,
                    Packages = group
                        .Select(assignment => packageLookup.GetValueOrDefault(assignment.PackageId))
                        .Where(package => package is not null)
                        .Cast<PackageDetailsDTO>()
                        .DistinctBy(package => package.PackageId)
                        .OrderBy(package => package.PackageName)
                        .ToList(),
                    CreatedAt = group.Min(assignment => assignment.CreatedAt),
                    UpdatedAt = group.Max(assignment => assignment.UpdatedAt)
                };
            })
            .OrderBy(client => client.ClientName)
            .ToArray();

        return new PaginatedResult<ClientManagementViewModel>(
            result.PageIndex,
            result.PageSize,
            result.TotalRecords,
            groupedClients);
    });

    private async Task EnsurePackagesLoadedAsync(CancellationToken cancellationToken)
    {
        if (packagesLoaded)
            return;

        packagesLoadTask ??= PackageManagementService.GetAllPackagesAsync(cancellationToken);

        try
        {
            packages = await packagesLoadTask.WaitAsync(cancellationToken);
            packageLookup = packages.ToDictionary(package => package.PackageId);
            packagesLoaded = true;
        }
        catch
        {
            if (packagesLoadTask.IsCanceled || packagesLoadTask.IsFaulted)
                packagesLoadTask = null;
            throw;
        }
    }

    private async Task AddNewClient()
    {
        try
        {
            await EnsurePackagesLoadedAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        var parameters = new DialogParameters<AddClientComponent>
        {
            { component => component.Packages, packages }
        };
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = true
        };

        var dialog = await DialogService.ShowAsync<AddClientComponent>("Add Client", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var clientDTO = (AddClientDTO)result.Data!;
                await ClientManagementService.AddClientAsync(clientDTO!);
                Snackbar.Add("Client added successfully", Severity.Success);
                if (clientsTable?.TableRef != null)
                    await clientsTable.TableRef.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task EditClient(ClientManagementViewModel client)
    {
        var parameters = new DialogParameters<EditClientComponent>
        {
            { component => component.Client, client },
            { component => component.Packages, packages }
        };
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = true
        };

        var dialog = await DialogService.ShowAsync<EditClientComponent>("Edit Client", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var editClientDTO = (EditClientDTO)result.Data!;
                await ClientManagementService.EditClientAsync(editClientDTO!);
                Snackbar.Add("Client updated successfully", Severity.Success);
                if (clientsTable?.TableRef != null)
                    await clientsTable.TableRef.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}
