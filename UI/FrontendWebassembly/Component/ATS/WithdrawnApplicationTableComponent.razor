@inject IEndorsementSubmissionService EndorsementService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inherits CrudPageBase  

@if (isResending)
{
    <div class="d-flex justify-center align-center" style="height:300px;">
        <LoaderComponent />
    </div>
}
else
{
    <TableComponent @ref="lockedUsersTable"
                    TItem="FrontendWebassembly.DTO.ATS.EmailInvitationRequestListDTO"
                    Title="Withdrawn Applications"
                    EnableSearch="true"
                    LoadServerData="LoadWithdrawnServerData"
                    SearchString="@searchString"
                    ColumnCount="8"
                    SearchStringChanged="@((string val) => searchString = val)">
        <HeaderTemplate>
            <MudTh>Email</MudTh>
            <MudTh>First Name</MudTh>
            <MudTh>Last Name</MudTh>
            <MudTh>Mobile</MudTh>
            <MudTh>Ticket Status</MudTh>
            <MudTh>Application Status</MudTh>
            <MudTh>Email Status</MudTh>
            <MudTh>Action</MudTh>
        </HeaderTemplate>

        <RowTemplate Context="item">
            <MudTd DataLabel="Email">@item.EmailAddress</MudTd>
            <MudTd DataLabel="First Name">@item.FirstName</MudTd>
            <MudTd DataLabel="Last Name">@item.LastName</MudTd>
            <MudTd DataLabel="Mobile">@item.MobileNumber</MudTd>
            <MudTd DataLabel="Ticket Status">@item.OrderStatus</MudTd>
            <MudTd DataLabel="App Status">@item.ApplicationFormStatus</MudTd>
            <MudTd DataLabel="Email Status">@item.EmailSentStatus</MudTd>
            <MudTd DataLabel="Action">
                <MudIconButton Icon="@Icons.Material.Filled.Send"
                               Color="Color.Primary"
                               Size="Size.Medium"
                               OnClick="@(() => ConfirmResendApplicationForm(item.EmailInvitationID))"
                               Title="Resend Application Form" />
            </MudTd>
        </RowTemplate>

        <NoRecordsTemplate>
            <MudText Typo="Typo.body2">No withdrawn application forms found.</MudText>
        </NoRecordsTemplate>
    </TableComponent>

}
