@inject IReportService ReportService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog Class="um-dialog ats-result-modal-dialog ats-scroll-dialog" Style="padding: 0; width: min(820px, calc(100vw - 24px)); max-width: 820px;">
    <DialogContent>
<div class="ats-result-shell ats-dialog-shell">
    <div class="ats-result-top-header ats-dialog-header">
        <div>
            <MudText Typo="Typo.h5" Class="ats-result-title">Uploaded files &amp; report</MudText>
            <MudText Typo="Typo.body1" Class="ats-result-subtitle">View the submitted documents and screening report</MudText>
        </div>
        <button type="button" class="ats-result-close" aria-label="Close" @onclick="CloseDialog">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
    </div>
    <div class="ats-result-scroll-body ats-dialog-body">
    <MudPaper Elevation="0" Class="ats-result-hero">
        <div>
            <MudText Typo="Typo.h5" Class="ats-result-hero-name">@ReportResult!.SubjectName</MudText>
            <MudText Typo="Typo.body2" Class="ats-result-hero-subtitle">@ReportResult!.SelectedPackage</MudText>
        </div>
        <div class="ats-result-hero-status">@GetOrderStatusText()</div>
    </MudPaper>

    <div class="ats-result-body">
        <div>
            <MudPaper Elevation="0" Class="oneplatform-surface-card ats-result-summary-card">
                <MudText Typo="Typo.h6" Class="ats-result-section-title">Screening summary</MudText>

                <div class="ats-result-summary-item">
                    <MudText Typo="Typo.caption" Class="ats-result-label">Status</MudText>
                    <span class="ats-result-summary-status">@GetOrderStatusText()</span>
                </div>

                <div class="ats-result-summary-item">
                    <MudText Typo="Typo.caption" Class="ats-result-label">Result</MudText>
                    <MudText Typo="Typo.body1" Class="@($"ats-result-value {GetResultValueClass()}")">@GetResultText()</MudText>
                </div>

                <div class="ats-result-summary-item">
                    <MudText Typo="Typo.caption" Class="ats-result-label">Report type</MudText>
                    <MudText Typo="Typo.body1" Class="ats-result-value">@ReportResult!.SelectedPackage</MudText>
                </div>

                <MudButton Class="ats-result-download"
                           StartIcon="@Icons.Material.Outlined.Download"
                           OnClick="SelecFilesToDownload">Download</MudButton>
            </MudPaper>
        </div>

        <div>
            <MudPaper Elevation="0" Class="oneplatform-surface-card ats-result-docs-card">
                <MudText Typo="Typo.h6" Class="ats-result-section-title">Submitted documents</MudText>

                <div class="ats-result-doc-list mt-2">
                    <div class="ats-result-doc-row">
                        <div class="ats-result-doc-icon @(string.IsNullOrWhiteSpace(ReportResult!.ResumeFileName) ? "missing" : "uploaded")">
                            <MudIcon Icon="@(string.IsNullOrWhiteSpace(ReportResult.ResumeFileName) ? Icons.Material.Filled.Remove : Icons.Material.Filled.Check)" Size="Size.Small" />
                        </div>
                        <div class="ats-result-doc-details">
                            <MudText Class="ats-result-doc-title">Resume / CV</MudText>
                            <MudText Class="ats-result-doc-sub">@(string.IsNullOrWhiteSpace(ReportResult.ResumeFileName) ? "Not yet uploaded" : $"{ReportResult.ResumeFileName} · uploaded {ReportResult.FilledFormAt}")</MudText>
                        </div>
                    </div>

                    <div class="ats-result-doc-row">
                        <div class="ats-result-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.IdUploadedFileName) ? "missing" : "uploaded")">
                            <MudIcon Icon="@(string.IsNullOrWhiteSpace(ReportResult.IdUploadedFileName) ? Icons.Material.Filled.Remove : Icons.Material.Filled.Check)" Size="Size.Small" />
                        </div>
                        <div class="ats-result-doc-details">
                            <MudText Class="ats-result-doc-title">Government ID</MudText>
                            <MudText Class="ats-result-doc-sub">@(string.IsNullOrWhiteSpace(ReportResult.IdUploadedFileName) ? "Not yet uploaded" : $"{ReportResult.IdUploadedFileName} · uploaded {ReportResult.FilledFormAt}")</MudText>
                        </div>
                    </div>

                    <div class="ats-result-doc-row">
                        <div class="ats-result-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.CoeFileName) ? "missing" : "uploaded")">
                            <MudIcon Icon="@(string.IsNullOrWhiteSpace(ReportResult.CoeFileName) ? Icons.Material.Filled.Remove : Icons.Material.Filled.Check)" Size="Size.Small" />
                        </div>
                        <div class="ats-result-doc-details">
                            <MudText Class="ats-result-doc-title">Certificate of employment</MudText>
                            <MudText Class="ats-result-doc-sub">@(string.IsNullOrWhiteSpace(ReportResult.CoeFileName) ? "Not yet uploaded" : $"{ReportResult.CoeFileName} · uploaded {ReportResult.FilledFormAt}")</MudText>
                        </div>
                    </div>

                    <div class="ats-result-doc-row">
                        <div class="ats-result-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.DiplomaFileName) ? "missing" : "uploaded")">
                            <MudIcon Icon="@(string.IsNullOrWhiteSpace(ReportResult.DiplomaFileName) ? Icons.Material.Filled.Remove : Icons.Material.Filled.Check)" Size="Size.Small" />
                        </div>
                        <div class="ats-result-doc-details">
                            <MudText Class="ats-result-doc-title">Diploma / TOR</MudText>
                            <MudText Class="ats-result-doc-sub">@(string.IsNullOrWhiteSpace(ReportResult.DiplomaFileName) ? "Not yet uploaded" : $"{ReportResult.DiplomaFileName} · uploaded {ReportResult.UploadDiplomaAt}")</MudText>
                        </div>
                        @*                                  @if (string.IsNullOrWhiteSpace(ReportResult.DiplomaFileName))
                        {
                            <MudText Class="ats-result-doc-request">Request</MudText>
                        } *@
                    </div>

                    <div class="ats-result-doc-row">
                        <div class="ats-result-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.BiometricPhotoFileName) ? "missing" : "uploaded")">
                            <MudIcon Icon="@(string.IsNullOrWhiteSpace(ReportResult.BiometricPhotoFileName) ? Icons.Material.Filled.Remove : Icons.Material.Filled.Check)" Size="Size.Small" />
                        </div>
                        <div class="ats-result-doc-details">
                            <MudText Class="ats-result-doc-title">Biometric photo</MudText>
                            <MudText Class="ats-result-doc-sub">@(string.IsNullOrWhiteSpace(ReportResult.BiometricPhotoFileName) ? "Not yet uploaded" : $"{ReportResult.BiometricPhotoFileName} · uploaded {ReportResult.UploadBiometricPhotoAt}")</MudText>
                        </div>
                    </div>

                    <div class="ats-result-doc-row">
                        <div class="ats-result-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.ConsentFormFileName) ? "missing" : "uploaded")">
                            <MudIcon Icon="@(string.IsNullOrWhiteSpace(ReportResult.ConsentFormFileName) ? Icons.Material.Filled.Remove : Icons.Material.Filled.Check)" Size="Size.Small" />
                        </div>
                        <div class="ats-result-doc-details">
                            <MudText Class="ats-result-doc-title">Consent form</MudText>
                            <MudText Class="ats-result-doc-sub">@(string.IsNullOrWhiteSpace(ReportResult.ConsentFormFileName) ? "Not yet uploaded" : $"{ReportResult.ConsentFormFileName} · uploaded {ReportResult.FilledFormAt}")</MudText>
                        </div>
                    </div>

                    <div class="ats-result-doc-row">
                        <div class="ats-result-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.UploadedReportFileName) ? "missing" : "uploaded")">
                            <MudIcon Icon="@(string.IsNullOrWhiteSpace(ReportResult.UploadedReportFileName) ? Icons.Material.Filled.Remove : Icons.Material.Filled.Check)" Size="Size.Small" />
                        </div>
                        <div class="ats-result-doc-details">
                            <MudText Class="ats-result-doc-title">Report file</MudText>
                            <MudText Class="ats-result-doc-sub">@(string.IsNullOrWhiteSpace(ReportResult.UploadedReportFileName) ? "Not yet uploaded" : $"{ReportResult.UploadedReportFileName} · uploaded {ReportResult.ReportUploadedAt}")</MudText>
                        </div>
                    </div>
                </div>
            </MudPaper>
        </div>
    </div>
    </div>
</div>
    </DialogContent>
</MudDialog>
