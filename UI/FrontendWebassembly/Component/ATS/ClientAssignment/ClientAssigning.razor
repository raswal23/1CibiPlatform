@page "/s&i/ats/clientassigning"
@namespace FrontendWebassembly.Component.ATS
@layout ATSLayout
@attribute [RequirePermission(6, 7)]
@attribute [RequireATSModule(11)]
@inject IClientAssignmentService ClientAssignmentService
@inherits CrudPageBase

<PageTitle>ATS - Client Assigning</PageTitle>

<div class="ats-client-assigning ats-management-page">
    <section class="ats-client-assigning-table-scope">
        <TableComponent TItem="ClientAssignmentDetailsDTO"
                        @ref="assignmentsTable"
                        Title="Client Assigning"
                        EnableReload="true"
                        TitleId="ats-client-assigning-heading"
                        ContainerClass="ats-management-card ats-client-assigning-card"
                        TableClass="ats-client-assigning-table"
                        EnableSearch="true"
                        SearchLabel=""
                        SearchPlaceholder="Search users by name or email"
                        SearchDebounceInterval="350"
                        ColumnCount="6"
                        RowsPerPage="10"
                        PageSizeOptions="@(new[] { 10, 25, 50 })"
                        LoadServerData="LoadAssignmentData"
                        CursorPagerState="_assignmentsLoader"
                        SearchString="@searchString"
                        SearchStringChanged="@((string value) => searchString = value)">

            <HeaderTemplate>
                <MudTh>User</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Assigned client</MudTh>
                <MudTh>Assigned date</MudTh>
                <MudTh>Updated date</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderTemplate>

            <RowTemplate Context="assignment">
                <MudTd DataLabel="User">
                    <div class="ats-client-assigning-user-cell">
                        <span class="ats-client-assigning-avatar">@GetUserInitials(assignment.UserName)</span>
                        <span class="ats-client-assigning-name">@assignment.UserName</span>
                    </div>
                </MudTd>
                <MudTd DataLabel="Email" Class="ats-client-assigning-muted">
                    <a href="@($"mailto:{assignment.UserEmail}")">@assignment.UserEmail</a>
                </MudTd>
                <MudTd DataLabel="Assigned client">
                    @if (assignment.ClientId.HasValue)
                    {
                        <span class="ats-client-assigning-client">@assignment.ClientName</span>
                    }
                    else
                    {
                        <span class="ats-client-assigning-unassigned">Unassigned</span>
                    }
                </MudTd>
                <MudTd DataLabel="Assigned date" Class="ats-client-assigning-date">
                    @FormatDate(assignment.AssignedAt)
                </MudTd>
                <MudTd DataLabel="Updated date" Class="ats-client-assigning-date">
                    @FormatDate(assignment.UpdatedAt)
                </MudTd>
                <MudTd DataLabel="Actions">
                    <button type="button"
                            class="ats-client-assigning-edit"
                            aria-label="Assign client for @assignment.UserName"
                            @onclick="() => EditAssignment(assignment)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 20h9" />
                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                        </svg>
                    </button>
                </MudTd>
            </RowTemplate>

            <NoRecordsTemplate>
                <div class="ats-client-assigning-empty">
                    <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" />
                    <strong>No users found</strong>
                    <span>Try a different name or email.</span>
                </div>
            </NoRecordsTemplate>
        </TableComponent>
    </section>
</div>
