<MudDialog Class="um-dialog eu-dialog ats-scroll-dialog" Style="padding: 0; width: min(640px, calc(100vw - 24px)); max-width: 640px;">
    <DialogContent>
        <div class="eu-shell ats-dialog-shell">
            <header class="eu-header ats-dialog-header">
                <div class="eu-header-row">
                    <div class="eu-header-left">
                        <div class="eu-icon-badge" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M12 20h9" />
                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                            </svg>
                        </div>
                        <div class="eu-header-text">
                            <h1>Edit user</h1>
                            <p>Update ATS role and module access</p>
                        </div>
                    </div>
                    <button type="button" class="eu-close" aria-label="Close edit user dialog" @onclick="Cancel">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                            <path d="M6 6l12 12M18 6 6 18" />
                        </svg>
                    </button>
                </div>
            </header>

            <main class="eu-body ats-dialog-body">
                <MudForm @ref="UserForm">
                    <section class="eu-section" aria-labelledby="edit-user-identity-heading">
                        <div class="eu-section-head">
                            <span class="eu-section-number">1</span>
                            <h2 id="edit-user-identity-heading">User identity</h2>
                            <span class="eu-section-helper">Who this account belongs to</span>
                        </div>

                        <div class="eu-section-body">
                            <div class="eu-avatar-row">
                                <div class="eu-avatar">@UserInitials</div>
                                <div class="eu-who">
                                    <p>@DisplayUserName</p>
                                    <span>@DisplayUserEmail</span>
                                </div>
                            </div>

                            <div class="eu-field">
                                <label for="eu-user">User</label>
                                <div class="eu-input-wrap">
                                    <MudAutocomplete T="ATSUserLookupDTO"
                                                     InputId="eu-user"
                                                     Value="SelectedAuthUser"
                                                     SearchFunc="SearchAuthUsers"
                                                     ToStringFunc="GetAuthUserText"
                                                     Placeholder="Select a user"
                                                     Disabled="true"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Adornment="Adornment.Start"
                                                     AdornmentIcon="@Icons.Material.Outlined.PersonOutline"
                                                     Class="eu-control" />
                                </div>
                                @if (!string.IsNullOrWhiteSpace(AuthUserError))
                                {
                                    <span class="eu-error" role="alert">@AuthUserError</span>
                                }
                            </div>

                            <div class="eu-grid-two">
                                <div class="eu-field">
                                    <label for="eu-user-name">User name</label>
                                    <div class="eu-input-wrap">
                                        <MudTextField @bind-Value="EditUser.UserName"
                                                      InputId="eu-user-name"
                                                      Placeholder="User name"
                                                      Disabled="true"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Outlined.PersonOutline"
                                                      Class="eu-control" />
                                    </div>
                                </div>
                                <div class="eu-field">
                                    <label for="eu-user-email">User email</label>
                                    <div class="eu-input-wrap">
                                        <MudTextField @bind-Value="EditUser.UserEmail"
                                                      InputId="eu-user-email"
                                                      Placeholder="user@company.com"
                                                      InputType="InputType.Email"
                                                      Disabled="true"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Outlined.MailOutline"
                                                      Class="eu-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="eu-section" aria-labelledby="edit-assignment-heading">
                        <div class="eu-section-head">
                            <span class="eu-section-number">2</span>
                            <h2 id="edit-assignment-heading">Assignment</h2>
                            <span class="eu-section-helper">Where they'll work</span>
                        </div>

                        <div class="eu-section-body">
                            <div class="eu-field">
                                <label for="eu-client">Client</label>
                                <div class="eu-input-wrap">
                                    <MudSelect T="int?"
                                               @bind-Value="EditUser.ClientId"
                                               InputId="eu-client"
                                               Placeholder="All Clients"
                                               Disabled="true"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Adornment="Adornment.Start"
                                               AdornmentIcon="@Icons.Material.Outlined.Apartment"
                                               Class="eu-control">
                                        <MudSelectItem T="int?" Value="@((int?)null)">All Clients</MudSelectItem>
                                        @foreach (var client in Clients)
                                        {
                                            var isAssigned = client.ClientId == EditUser.ClientId;
                                            <MudSelectItem T="int?" Value="@((int?)client.ClientId)" Disabled="@(!client.IsActive && !isAssigned)">
                                                @client.ClientName@(!client.IsActive ? " (Inactive)" : string.Empty)
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                </div>
                            </div>

                            <div class="eu-info-banner">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <circle cx="12" cy="12" r="9.5" />
                                    <path d="M12 11v5.5" stroke-linecap="round" />
                                    <circle cx="12" cy="7.7" r="0.9" fill="currentColor" stroke="none" />
                                </svg>
                                <p>Use <strong>Assign client</strong> on the User Management page to change this user's client.</p>
                            </div>

                            <div class="eu-grid-two">
                                <div class="eu-field">
                                    <label for="eu-site">Site <span class="eu-required">*</span></label>
                                    <div class="eu-input-wrap">
                                        <MudTextField @bind-Value="EditUser.Site"
                                                      InputId="eu-site"
                                                      Placeholder="Enter site name"
                                                      Required="true"
                                                      RequiredError="Site is required"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      MaxLength="100"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Outlined.LocationOn"
                                                      Class="eu-control" />
                                    </div>
                                </div>
                                <div class="eu-field">
                                    <label for="eu-role">Role <span class="eu-required">*</span></label>
                                    <div class="eu-input-wrap">
                                        <MudSelect T="int"
                                                   @bind-Value="EditUser.RoleId"
                                                   InputId="eu-role"
                                                   Placeholder="Select a role"
                                                   Required="true"
                                                   RequiredError="Role is required"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Adornment="Adornment.Start"
                                                   AdornmentIcon="@Icons.Material.Outlined.Shield"
                                                   Class="eu-control">
                                            @foreach (var role in Roles)
                                            {
                                                var isAssigned = role.RoleId == EditUser.RoleId;
                                                <MudSelectItem T="int" Value="@role.RoleId" Disabled="@(!role.IsActive && !isAssigned)">
                                                    @role.RoleName@(!role.IsActive ? " (Inactive)" : string.Empty)
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="eu-section" aria-labelledby="edit-access-heading">
                        <div class="eu-section-head">
                            <span class="eu-section-number">3</span>
                            <h2 id="edit-access-heading">Access</h2>
                            <span class="eu-section-helper">Modules and account state</span>
                        </div>

                        <div class="eu-section-body">
                            <div class="eu-field">
                                <label>Modules</label>
                                <div class="eu-chip-box @(ModuleError is not null ? "has-error" : string.Empty)">
                                    @foreach (var module in SelectedModules)
                                    {
                                        <span class="eu-chip">
                                            @module.ModuleName@(!module.IsActive ? " (Inactive)" : string.Empty)
                                            <button type="button" aria-label="Remove @module.ModuleName" @onclick="() => RemoveModule(module.ModuleId)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                                                    <path d="M7 7l10 10M17 7 7 17" />
                                                </svg>
                                            </button>
                                        </span>
                                    }

                                    <MudMenu Label="Add module"
                                             StartIcon="@Icons.Material.Filled.Add"
                                             Variant="Variant.Text"
                                             Dense="true"
                                             Class="eu-module-menu">
                                        @foreach (var module in Modules)
                                        {
                                            var isSelected = SelectedModuleIds.Contains(module.ModuleId);
                                            <MudMenuItem Disabled="@(!module.IsActive && !isSelected)" OnClick="@(() => ToggleModule(module.ModuleId))">
                                                <MudIcon Icon="@(isSelected ? Icons.Material.Filled.CheckBox : Icons.Material.Outlined.CheckBoxOutlineBlank)" Size="Size.Small" />
                                                <span>@module.ModuleName@(!module.IsActive ? " (Inactive)" : string.Empty)</span>
                                            </MudMenuItem>
                                        }
                                    </MudMenu>
                                </div>
                                @if (ModuleError is not null)
                                {
                                    <span class="eu-error" role="alert">@ModuleError</span>
                                }
                            </div>

                            <div class="eu-field">
                                <label>Status</label>
                                <div class="eu-status-row">
                                    <div class="eu-status-copy">
                                        <p>Account @(EditUser.IsActive ? "active" : "inactive")</p>
                                        <span>User can sign in and access assigned modules</span>
                                    </div>
                                    <div class="eu-status-control">
                                        <span class="eu-status-badge @(EditUser.IsActive ? string.Empty : "is-off")">@(EditUser.IsActive ? "Active" : "Inactive")</span>
                                        <button type="button"
                                                class="eu-toggle @(EditUser.IsActive ? string.Empty : "is-off")"
                                                role="switch"
                                                aria-checked="@EditUser.IsActive.ToString().ToLowerInvariant()"
                                                aria-label="Toggle account status"
                                                @onclick="ToggleStatus">
                                            <span></span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </MudForm>
            </main>

            <footer class="eu-footer ats-dialog-footer">
                <button type="button" class="eu-button eu-button-cancel" @onclick="Cancel">Cancel</button>
                <button type="button" class="eu-button eu-button-save" @onclick="Submit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5" />
                    </svg>
                    Save
                </button>
            </footer>
        </div>
    </DialogContent>
</MudDialog>
