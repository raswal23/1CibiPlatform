@inject IJSRuntime JS
@inject IDialogService DialogService
@inject IReportService ReportService
@inject ISnackbar Snackbar

<MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mb-3">
    <MudPaper Style="padding: 15px; width: 100%; max-width: 500px; border-radius: 12px; box-shadow: 0 0 10px rgba(42,119,174,0.8);">
        <MudDateRangePicker @bind-DateRange="@_dateRange"
                            Margin="Margin.Dense"
                            ReadOnly="false"
                            Clearable="true"
                            PlaceholderStart="Start Date"
                            PlaceholderEnd="End Date"
                            Label="Date Range" />
    </MudPaper>
</MudStack>

<TableComponent TItem="ReportListDTO"
                @ref="reportsTable"
                Title="Query Results"
                EnableSearch="true"
                ColumnCount="7"
                RowsPerPage="10"
                LoadServerData="LoadReportData"
                SearchString="@searchString"
                SearchStringChanged="@((string val) => searchString = val)">

    <HeaderTemplate>
        <MudTh> Selected</MudTh>
        <MudTh>
            <MudTableSortLabel T="ReportListDTO" SortLabel="SubjectName">Subject Name</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="ReportListDTO" SortLabel="OrderStatus">Status</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="ReportListDTO" SortLabel="OrderCompletedAt">Date Completed</MudTableSortLabel>
        </MudTh>
        <MudTh>Selected Package</MudTh>
        <MudTh>Hit Status</MudTh>
        <MudTh>Directory</MudTh>
    </HeaderTemplate>

    <RowTemplate Context="r">
        <MudTd DataLabel="Selected">
            <div style="display:flex; justify-content:center; align-items:center;">
                <MudCheckBox T="bool" @bind-Checked="r.Selected" 
                             Color="Color.Primary" 
                             ValueChanged="@(value =>
                             {
                                r.Selected = value;
                                StateHasChanged();
                             })" />
            </div>
        </MudTd>
        <MudTd DataLabel="Subject Name">@r.SubjectName</MudTd>
        <MudTd DataLabel="Status">@r.OrderStatus</MudTd>
        <MudTd DataLabel="Date Completed">@(r.OrderCompletedAt?.ToString("MMMM dd, yyyy") ?? "-")</MudTd>
        <MudTd DataLabel="Selected Package">@r.SelectedPackage</MudTd>
        <MudTd DataLabel="Hit Status">@r.HitStatus</MudTd>
        <MudTd DataLabel="Report Directory">
            <MudIconButton Icon="@Icons.Material.Filled.Folder" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenResultTriggerDialog(r.EmailInvitationRequestId))" />
        </MudTd>
    </RowTemplate>

    <NoRecordsTemplate>
        <MudText Typo="Typo.body2">No reports found.</MudText>
    </NoRecordsTemplate>

</TableComponent>

<MudGrid Class="mt-0">
    <MudItem xs="12" md="8">
        <MudButton Class="@($"theme-button {(currentPageData.Any(r => r.Selected) ? "theme-button-active " : "theme-button-inactive")}")"
                   Style="width: 120px; border-radius: 12px;"
                   Disabled="@(!currentPageData.Any(r => r.Selected))"
                   OnClick="DownloadSelected">Download</MudButton>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudText Typo="Typo.caption" Class="text-right">
            <b style-="color: #102247;">IMPORTANT NOTICE!</b><br />
            For security purposes, all reports downloaded are password protected and in PDF format. Please reach out to your account manager for your quarterly passwords.
        </MudText>
    </MudItem>
</MudGrid>
