@page "/s&i/ats/searchreport"
@layout ATSLayout
@attribute [RequirePermission(6, 7)]
@attribute [RequireATSModule(3)]
@inherits SecurePageBase
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject IReportService ReportService
@inject ISnackbar Snackbar

<PageTitle>ATS - Search Report</PageTitle>

<div class="ats-management-page">
    <div class="search-report-warning">
        <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" />
        <div>
            <p class="search-report-warning-title">Select at least one order</p>
            <p class="search-report-warning-text">Choose one or more orders from the list before downloading the report(s).</p>
        </div>
    </div>

    <div class="search-report-results-scope">
    <TableComponent TItem="ReportListDTO"
                    @ref="reportsTable"
                    Title="Query results"
                    ContainerClass="ats-management-card search-report-results"
                    EnableSearch="true"
                    SearchLabel=""
                    SearchPlaceholder="Search query results"
                    ColumnCount="8"
                    RowsPerPage="10"
                    LoadServerData="LoadReportData"
                    SearchString="@searchString"
                    RowClassFunc="GetRowClass"
                    SearchStringChanged="@((string val) => searchString = val)">
        <ToolBarLeft>
            <div class="search-report-date-field">
                <label>Date range</label>
                <MudDateRangePicker Class="search-report-date-range"
                                    Variant="Variant.Outlined"
                                    Margin="Margin.Dense"
                                    ReadOnly="false"
                                    Clearable="true"
                                    DateRangeChanged="OnDateRangeChanged"
                                    PlaceholderStart="Start Date"
                                    PlaceholderEnd="End Date" />
            </div>
        </ToolBarLeft>
        <HeaderTemplate>
            <MudTh> Action</MudTh>
            <MudTh>
                <MudTableSortLabel T="ReportListDTO" SortLabel="SubjectName">Subject Name</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="ReportListDTO" SortLabel="OrderStatus">Status</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="ReportListDTO" SortLabel="OrderCompletedAt">Date Completed</MudTableSortLabel>
            </MudTh>
            <MudTh>Selected Package</MudTh>
            <MudTh>Hit Status</MudTh>
            <MudTh>Upload Report</MudTh>
            <MudTh>Directory</MudTh>
        </HeaderTemplate>

        <RowTemplate Context="r">
            <MudTd DataLabel="Action">
                <button type="button" class="report-checkbox @(r.Selected ? "checked" : null)"
                        role="checkbox" aria-checked="@r.Selected.ToString().ToLowerInvariant()"
                        aria-label="@($"Select {r.SubjectName}")"
                        @onclick="@(() => OnCheckboxChanged(r, !r.Selected))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
                </button>
            </MudTd>
            <MudTd DataLabel="Subject Name"><div class="report-subject"><span class="report-avatar">@GetInitials(r.SubjectName)</span><span class="report-name">@r.SubjectName</span></div></MudTd>
            <MudTd DataLabel="Status"><span class="report-status @GetOrderStatusClass(r.OrderStatus)">@GetOrderStatusText(r.OrderStatus)</span></MudTd>
            <MudTd Class="report-date" DataLabel="Date Completed">@(r.OrderCompletedAt?.ToString("MMMM dd, yyyy") ?? "—")</MudTd>
            <MudTd DataLabel="Selected Package"><span class="report-package">@r.SelectedPackage</span></MudTd>
            <MudTd DataLabel="Hit Status"><span class="report-hit @GetHitStatusClass(r.HitStatus)">@GetHitStatusText(r.HitStatus)</span></MudTd>
            <MudTd DataLabel="Upload Report">
                <button type="button" class="report-icon-action" aria-label="@($"Upload report for {r.SubjectName}")" @onclick="@(() => OpenUploadReportDialog(r.EmailInvitationRequestId))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M12 4l-4.5 4.5M12 4l4.5 4.5" /><path d="M4 16v2.5A1.5 1.5 0 005.5 20h13a1.5 1.5 0 001.5-1.5V16" /></svg>
                </button>
            </MudTd>
            <MudTd DataLabel="Directory">
                <button type="button" class="report-icon-action" aria-label="@($"Open directory for {r.SubjectName}")" @onclick="@(() => OpenResultTriggerDialog(r.EmailInvitationRequestId))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 014.5 6h4.4l1.8 2h8.8A1.5 1.5 0 0121 9.5v8A1.5 1.5 0 0119.5 19h-15A1.5 1.5 0 013 17.5v-10z" /></svg>
                </button>
            </MudTd>
        </RowTemplate>

        <NoRecordsTemplate>
            <div class="ats-console-empty-state">
                <div class="ats-console-empty-icon">📄</div>
                <div class="ats-console-empty-title">No reports match these filters</div>
                <div class="ats-console-empty-sub">Try widening the date range, or clear filters to see everything.</div>
            </div>
        </NoRecordsTemplate>

    </TableComponent>
    </div>
</div>

    <div class="ats-actions-right mt-3 mb-3" style="justify-content:space-between; align-items:center;">
        <MudButton Variant="Variant.Outlined"
                   Class="ats-ghost-btn"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="DownloadSelected">Download selected</MudButton>
    </div>

    @* <div class="ats-console-notice">
        <strong>Reports are password protected</strong>
        Downloaded PDFs require this quarter's password. Please contact your account manager if you do not have it.
    </div> *@
