@page "/s&i/ats/searchreport"
@layout ATSLayout
@attribute [RequirePermission(6, 7)]
@attribute [RequireATSModule(3)]
@inherits SecurePageBase
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject IReportService ReportService
@inject ISnackbar Snackbar

<PageTitle>ATS - Search Report</PageTitle>

<MudPaper Class="pa-4" Elevation="0">
    <div class="ats-console-notice mb-3">
        <strong>Select at least one order.</strong>
        Choose one or more orders from the list before downloading the report(s).
    </div>

    <TableComponent TItem="ReportListDTO"
                    @ref="reportsTable"
                    Title="Query results"
                    EnableSearch="true"
                    ColumnCount="8"
                    RowsPerPage="10"
                    LoadServerData="LoadReportData"
                    SearchString="@searchString"
                    RowClassFunc="GetRowClass"
                    SearchStringChanged="@((string val) => searchString = val)">
        <ToolBarLeft>
            <MudDateRangePicker Margin="Margin.Dense"
                                ReadOnly="false"
                                Clearable="true"
                                DateRangeChanged="OnDateRangeChanged"
                                PlaceholderStart="Start Date"
                                PlaceholderEnd="End Date"
                                Label="Date range" />
        </ToolBarLeft>
        <HeaderTemplate>
            <MudTh> Action</MudTh>
            <MudTh>
                <MudTableSortLabel T="ReportListDTO" SortLabel="SubjectName">Subject Name</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="ReportListDTO" SortLabel="OrderStatus">Status</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="ReportListDTO" SortLabel="OrderCompletedAt">Date Completed</MudTableSortLabel>
            </MudTh>
            <MudTh>Selected Package</MudTh>
            <MudTh>Hit Status</MudTh>
            <MudTh>Upload Report</MudTh>
            <MudTh>Directory</MudTh>
        </HeaderTemplate>

        <RowTemplate Context="r">
            <MudTd DataLabel="Action">
                <div style="display:flex; justify-content:left;">
                    <MudCheckBox T="bool" 
                                 @bind-value="r.Selected"
                                 CheckedChanged="@((bool value) => OnCheckboxChanged(r, value))"
                                 Color="Color.Primary" />
                </div>
            </MudTd>
            <MudTd DataLabel="Subject Name">@r.SubjectName</MudTd>
            <MudTd DataLabel="Status"><span class="@ATSStatusBadgeResolver.GetBadgeClass(r.OrderStatus)">@r.OrderStatus</span></MudTd>
            <MudTd DataLabel="Date Completed">@(r.OrderCompletedAt?.ToString("MMMM dd, yyyy") ?? "-")</MudTd>
            <MudTd DataLabel="Selected Package">@r.SelectedPackage</MudTd>
            <MudTd DataLabel="Hit Status"><span class="@ATSStatusBadgeResolver.GetBadgeClass(r.HitStatus)">@r.HitStatus</span></MudTd>
            <MudTd DataLabel="Report Directory">
                <MudIconButton Icon="@Icons.Material.Filled.Upload" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenUploadReportDialog(r.EmailInvitationRequestId))" />
            </MudTd>
            <MudTd DataLabel="Report Directory">
                <MudIconButton Icon="@Icons.Material.Filled.Folder" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenResultTriggerDialog(r.EmailInvitationRequestId))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsTemplate>
            <div class="ats-console-empty-state">
                <div class="ats-console-empty-icon">📄</div>
                <div class="ats-console-empty-title">No reports match these filters</div>
                <div class="ats-console-empty-sub">Try widening the date range, or clear filters to see everything.</div>
            </div>
        </NoRecordsTemplate>

    </TableComponent>

    <div class="ats-actions-right mt-3 mb-3" style="justify-content:space-between; align-items:center;">
        <MudButton Variant="Variant.Outlined"
                   Class="ats-ghost-btn"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="DownloadSelected">Download selected</MudButton>
    </div>

    @* <div class="ats-console-notice">
        <strong>Reports are password protected</strong>
        Downloaded PDFs require this quarter's password. Please contact your account manager if you do not have it.
    </div> *@
</MudPaper>
