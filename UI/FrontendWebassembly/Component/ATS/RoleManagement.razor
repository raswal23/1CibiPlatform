@page "/s&i/ats/rolemanagement"
@layout ATSLayout
@attribute [RequirePermission(6, 7)]
@attribute [RequireATSModule(8)]
@inject IRoleManagementService RoleManagementService
@inject ISnackbar Snackbar
@inherits CrudPageBase

<PageTitle>ATS - Role Management</PageTitle>

<div class="ats-management-page">
<div class="ats-management-actions">
    <button type="button" class="ats-management-button" @onclick="AddNewRole">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
        </svg>
        Add role
    </button>
</div>

<TableComponent TItem="RoleDetailsDTO"
                @ref="rolesTable"
                Title="Roles"
                ContainerClass="ats-management-card ats-role-card"
                EnableSearch="true"
                SearchLabel=""
                SearchPlaceholder="Search roles"
                ColumnCount="6"
                RowsPerPage="10"
                LoadServerData="LoadRoleData"
                SearchString="@searchString"
                SearchStringChanged="@((string val) => searchString = val)">

    <HeaderTemplate>
        <MudTh Class="ats-table-cell-center">Role Name</MudTh>
        <MudTh Class="ats-table-cell-center">Role Description</MudTh>
        <MudTh Class="ats-table-cell-center">Status</MudTh>
        <MudTh Class="ats-table-cell-center">Created Date</MudTh>
        <MudTh Class="ats-table-cell-center">Updated Date</MudTh>
        <MudTh Class="ats-table-cell-center">Actions</MudTh>
    </HeaderTemplate>

    <RowTemplate Context="r">
        <MudTd Class="ats-management-primary" DataLabel="Role Name">
            <div class="ats-management-role-cell">
                <span class="ats-management-role-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 3l7 3v5c0 4.6-3 7.9-7 10-4-2.1-7-5.4-7-10V6l7-3Z" />
                    </svg>
                </span>
                    <span style="font-weight: 600;">@r.RoleName</span>
            </div>
        </MudTd>

        <MudTd Class="ats-management-description" DataLabel="Role Description">
            @r.RoleDescription
        </MudTd>

        <MudTd Class="ats-table-cell-center" DataLabel="Status">
            <span class="ats-management-status @(!r.IsActive ? "is-disabled" : string.Empty)">
                @(r.IsActive ? "Active" : "Disabled")
            </span>
        </MudTd>

        <MudTd Class="ats-management-date" DataLabel="Created Date">
            @r.CreatedAt.ToString("MMMM dd, yyyy")
        </MudTd>

        <MudTd Class="ats-management-date" DataLabel="Updated Date">
            @r.UpdatedAt.ToString("MMMM dd, yyyy")
        </MudTd>

        <MudTd Class="ats-table-cell-center" DataLabel="Actions">
            <button type="button"
                    class="ats-management-edit ats-management-edit-button"
                    aria-label="Edit @r.RoleName role"
                    @onclick="@(() => EditRole(r))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                </svg>
            </button>
        </MudTd>
    </RowTemplate>

    <NoRecordsTemplate>
        <div class="ats-management-empty">
            <MudIcon Icon="@Icons.Material.Filled.Group" />
            <strong>No roles</strong>
            <span>Create a new role to get started.</span>
        </div>
    </NoRecordsTemplate>
</TableComponent>
</div>

@code {
    private string searchString = string.Empty;
    private TableComponent<RoleDetailsDTO>? rolesTable;

    private async Task<TableData<RoleDetailsDTO>> LoadRoleData(TableState state, CancellationToken cancellationToken)
        => await LoadPagedDataAsync(state, (page, pageSize) =>
            RoleManagementService.GetRolesAsync(page, pageSize, searchString, cancellationToken));

    private async Task AddNewRole()
    {
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<AddRoleComponent>("Add Role", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var roleDTO = (AddATSRoleDTO)result.Data!;
                await RoleManagementService.AddRoleAsync(roleDTO);
                Snackbar.Add("Role added successfully", Severity.Success);
                if (rolesTable?.TableRef != null)
                    await rolesTable.TableRef.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task EditRole(RoleDetailsDTO role)
    {
        var parameters = new DialogParameters<EditRoleComponent> { { x => x.Role, role } };
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<EditRoleComponent>("Edit Role", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                var editRoleDTO = (EditATSRoleDTO)result.Data!;
                await RoleManagementService.EditRoleAsync(editRoleDTO);
                Snackbar.Add("Role updated successfully", Severity.Success);
                if (rolesTable?.TableRef != null)
                    await rolesTable.TableRef.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}
