@namespace FrontendWebassembly.Component.ATS
<MudDialog Class="um-dialog dd-dialog ats-scroll-dialog" Style="padding: 0; width: min(500px, calc(100vw - 24px)); max-width: 500px;">
    <DialogContent>
        <div class="dd-shell ats-dialog-shell">
            <header class="dd-header ats-dialog-header">
                <div class="dd-header-row">
                    <div class="dd-header-left">
                        <div class="dd-icon-badge" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M12 9v4M12 17h.01" />
                                <path d="M10.3 3.9 2.8 17.1a1.8 1.8 0 0 0 1.6 2.7h15.2a1.8 1.8 0 0 0 1.6-2.7L13.7 3.9a1.8 1.8 0 0 0-3.4 0Z" />
                            </svg>
                        </div>

                        <div class="dd-header-text">
                            <h1>Reason for dispute</h1>
                            <p>Tell us what's wrong with this result</p>
                        </div>
                    </div>

                    <button type="button" class="dd-close" aria-label="Close dispute dialog" @onclick="Cancel">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                            <path d="M6 6l12 12M18 6 6 18" />
                        </svg>
                    </button>
                </div>
            </header>

            <main class="dd-body ats-dialog-body">
                <MudForm @ref="disputeForm">
                    <section class="dd-section" aria-labelledby="dd-category-heading">
                        <div class="dd-section-head">
                            <span class="dd-section-number">1</span>
                            <h2 id="dd-category-heading">Dispute category</h2>
                        </div>

                        <div class="dd-section-body">
                            <div class="dd-pills-wrap">
                                <MudRadioGroup T="string"
                                               @bind-Value="SelectedDisputeCategory"
                                               Required="true"
                                               RequiredError="Dispute category is required"
                                               Class="dd-pills">
                                    <MudRadio T="string"
                                              Value="@("Billing")"
                                              Class="@($"dd-pill {(SelectedDisputeCategory == "Billing" ? "is-selected" : string.Empty)}")">
                                        Billing
                                    </MudRadio>
                                    <MudRadio T="string"
                                              Value="@("Report")"
                                              Class="@($"dd-pill {(SelectedDisputeCategory == "Report" ? "is-selected" : string.Empty)}")">
                                        Report
                                    </MudRadio>
                                    <MudRadio T="string"
                                              Value="@("Others")"
                                              Class="@($"dd-pill {(SelectedDisputeCategory == "Others" ? "is-selected" : string.Empty)}")">
                                        Others
                                    </MudRadio>
                                </MudRadioGroup>
                            </div>

                            @* Always rendered; usable once ANY category is selected. All three
                               categories require their own description, so Required is
                               unconditional - the field is only gated on having a category
                               to describe. *@
                            <div class="dd-field">
                                <label for="dd-specify-reason">Please specify <span class="dd-required">*</span></label>
                                @* A disabled input swallows clicks entirely, so the wrapper
                                   takes them (is-locked strips pointer events from the field)
                                   and blinks the note below when the field is still locked. *@
                                <div class="dd-input-wrap @(IsCategorySelected ? string.Empty : "is-locked")"
                                     @onclick="OnSpecifyFieldClickedAsync">
                                    <MudTextField @bind-Value="specifyReason"
                                                  InputId="dd-specify-reason"
                                                  Placeholder="Briefly describe the reason for this dispute"
                                                  FullWidth="true"
                                                  Disabled="@(!IsCategorySelected)"
                                                  Required="true"
                                                  RequiredError="Please specify a reason"
                                                  MaxLength="255"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Outlined.Article"
                                                  Class="dd-input" />
                                </div>

                                <p class="dd-field-note @(isSpecifyNoteBlinking ? "is-blinking" : string.Empty)"
                                   id="dd-specify-reason-note"
                                   role="note"
                                   aria-live="polite">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <circle cx="12" cy="12" r="9" />
                                        <path d="M12 8h.01M12 11v5" />
                                    </svg>
                                    You can only type here after selecting a <strong>category</strong> above.
                                </p>
                            </div>
                        </div>
                    </section>
                </MudForm>

                <div class="dd-warning" role="note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M10.3 3.9 2.8 17.1a1.8 1.8 0 0 0 1.6 2.7h15.2a1.8 1.8 0 0 0 1.6-2.7L13.7 3.9a1.8 1.8 0 0 0-3.4 0Z" />
                        <path d="M12 9v4M12 17h.01" />
                    </svg>
                    <p>Review the reason provided for disputing the screening result before submitting.</p>
                </div>
            </main>

            <footer class="dd-footer ats-dialog-footer">
                <button type="button" class="dd-button dd-button-cancel" @onclick="Cancel">Cancel</button>
                <button type="button"
                        class="dd-button dd-button-send"
                        disabled="@isUploading"
                        @onclick="SendDisputeAsync">
                    @if (isMarkingAsDisputed)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="dd-progress" />
                        <span>Sending...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z" />
                        </svg>
                        <span>Send dispute</span>
                    }
                </button>
            </footer>
        </div>
    </DialogContent>
</MudDialog>
