@page "/s&i/ats/disputeorder"
@namespace FrontendWebassembly.Component.ATS
@layout ATSLayout
@attribute [RequirePermission(6, 7)]
@attribute [RequireATSModule(4)]
@inject IDisputeOrderService DisputeOrderService
@inherits CrudPageBase

<PageTitle>ATS - Dispute Order</PageTitle>

<div class="ats-management-page">
    <div class="dispute-warning">
        <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" />
        <div>
            <p class="dispute-warning-title">Dispute window applies</p>
            <p class="dispute-warning-text">Disputes can only be filed for orders completed within the allowed window. Submit a new order if that window has closed or reverification is needed.</p>
        </div>
    </div>
     

    <div class="dispute-orders-scope">
    <TableComponent TItem="DisputeOrderListDTO"
                    @ref="ordersTable"
                    Title="Dispute orders"
                    EnableReload="true"
                    ContainerClass="ats-management-card dispute-orders"
                    EnableSearch="true"
                    SearchLabel=""
                    SearchPlaceholder="Search dispute orders"
                    ColumnCount="7"
                    RowsPerPage="10"
                    LoadServerData="LoadOrderData"
                    CursorPagerState="_ordersLoader"
                    SearchString="@searchString"
                    SearchStringChanged="@((string val) => searchString = val)">

        <HeaderTemplate>
            <MudTh>Ticket No.</MudTh>
            <MudTh>Subject Name</MudTh>
            <MudTh>Requestor</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Order Date</MudTh>
            <MudTh>Date Completed</MudTh>
            <MudTh>Send Dispute</MudTh>
        </HeaderTemplate>

        <RowTemplate Context="o">
            @if(_loadingDisputeId == o.EmailInvitationID)
            {
                <MudTd DataLabel="Ticket No." Class="ats-table-cell-center">
                    <MudSkeleton Height="20px" Width="80px" />
                </MudTd>

                <MudTd DataLabel="Subject Name" Class="ats-table-cell-center">
                    <MudSkeleton Height="20px" Width="80%" />
                </MudTd>

                <MudTd DataLabel="Requestor" Class="ats-table-cell-center">
                    <MudSkeleton Height="20px" Width="80%" />
                </MudTd>

                <MudTd DataLabel="Status" Class="ats-table-cell-center">
                    <MudSkeleton Height="24px" Width="90px" />
                </MudTd>

                <MudTd DataLabel="Order Date" Class="ats-table-cell-center">
                    <MudSkeleton Height="20px" Width="120px" />
                </MudTd>

                <MudTd DataLabel="Date Completed" Class="ats-table-cell-center">
                    <MudSkeleton Height="20px" Width="120px" />
                </MudTd>

                <MudTd DataLabel="Send Dispute" Class="ats-table-cell-center">
                    <MudSkeleton Height="36px" Width="36px" />
                </MudTd>
            }
            else
            {
                <MudTd DataLabel="Ticket No.">
                    @if (!string.IsNullOrWhiteSpace(o.TicketNumber))
                    {
                        <span class="dispute-ticket-number">@o.TicketNumber</span>
                    }
                    else
                    {
                        <span class="dispute-ticket-empty" title="OMS has not issued a ticket for this order yet">—</span>
                    }
                </MudTd>

                <MudTd DataLabel="Subject Name">
                    <div class="dispute-subject">
                        <span class="dispute-avatar">@GetInitials(o.FirstName, o.LastName)</span>
                        <span class="dispute-name">@($"{o.FirstName} {o.LastName}".Trim())</span>
                    </div>
                </MudTd>

                <MudTd DataLabel="Requestor">@o.Requestor</MudTd>

                <MudTd DataLabel="Status">
                    @if (string.IsNullOrWhiteSpace(o.DisputeCategory))
                    {
                        <span class="dispute-chip muted">Not set</span>
                    }
                    else
                    {
                        <span class="dispute-chip">@o.DisputeCategory</span>
                    }
                </MudTd>

                <MudTd Class="dispute-date" DataLabel="Order Date">
                    @o.OrderCreatedAt?.ToString("MMMM dd, yyyy")
                </MudTd>

                <MudTd Class="dispute-date" DataLabel="Date Completed">
                    @(o.OrderCompletedAt?.ToString("MMMM dd, yyyy") ?? "-")
                </MudTd>

                <MudTd DataLabel="Send Dispute">
                    <button type="button"
                            class="dispute-action"
                            aria-label="@($"Send dispute for {o.FirstName} {o.LastName}")"
                            @onclick="@(() => MarkAsDisputed(o.EmailInvitationID))">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
                        </svg>
                    </button>
                </MudTd>
            }
        
        </RowTemplate>

        <NoRecordsTemplate>
            <div class="ats-console-empty-state">
                <div class="ats-console-empty-icon">⚠</div>
                <div class="ats-console-empty-title">No dispute orders</div>
                <div class="ats-console-empty-sub">Completed orders eligible for dispute within the allowed window will appear here.</div>
            </div>
        </NoRecordsTemplate>
    </TableComponent>
    </div>
</div>

    
