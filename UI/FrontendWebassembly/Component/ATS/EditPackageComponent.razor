<MudDialog Class="um-dialog" Style="padding: 0;">
    <DialogContent>
        <div class="um-dialog-shell">
            <div class="um-dialog-header">
                <div>
                    <MudText Typo="Typo.h5" Class="um-dialog-title">Edit package</MudText>
                    <MudText Typo="Typo.body1" Class="um-dialog-subtitle">Update package details</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Class="um-dialog-close" OnClick="Cancel" />
            </div>

            <MudDivider />

            <MudPaper Elevation="0" Class="um-dialog-body">
                <MudForm @ref="EditPackageForm">
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="EditPackage.PackageId"
                                      Label="Package Id"
                                      ReadOnly
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="oneplatform-rounded-input" />

                        <MudTextField @bind-Value="EditPackage.PackageName"
                                      Label="Package Name"
                                      Required="true"
                                      RequiredError="Package Name is required"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="255"
                                      Class="oneplatform-rounded-input" />

                        <div class="um-switch-row">
                            <MudText Class="um-dialog-label">Is active</MudText>
                            <MudCheckBox T="bool" @bind-Value="EditPackage.IsActive" />
                        </div>
                    </MudStack>
                </MudForm>
            </MudPaper>

            <div class="um-dialog-footer">
                <MudButton OnClick="Cancel" Variant="Variant.Outlined" Class="um-secondary-button">Cancel</MudButton>
                <MudButton OnClick="Submit" Class="theme-button theme-button-active um-primary-button">Save</MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>
