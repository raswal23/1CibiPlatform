@namespace FrontendWebassembly.Component.ATS
<MudDialog Class="um-dialog eo-dialog ats-scroll-dialog" Style="padding: 0; width: min(460px, calc(100vw - 24px)); max-width: 460px;">
    <DialogContent>
        <div class="eo-shell ats-dialog-shell">
            <header class="eo-header ats-dialog-header">
                <div class="eo-header-row">
                    <div class="eo-header-left">
                        <div class="eo-icon-badge" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="3" y="5.5" width="18" height="13" rx="2.4" />
                                <path d="M4 7l8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <div class="eo-header-text">
                            <h1>@HeaderTitle</h1>
                            <p>@HeaderSubtitle</p>
                        </div>
                    </div>

                    <button type="button"
                            class="eo-close"
                            aria-label="Close verification dialog"
                            @onclick="Cancel">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                            <path d="M6 6l12 12M18 6 6 18" />
                        </svg>
                    </button>
                </div>
            </header>

            <main class="eo-body ats-dialog-body">
                <p class="eo-lead">
                    We sent a 6-digit code to
                    <strong>@OtpSent.EmailAddress</strong>, from that mailbox itself.
                    It expires in @OtpSent.ExpiryInMinutes minutes.
                </p>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="eo-banner error" role="alert">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 7.5v5.5M12 16.2v.1" />
                        </svg>
                        <span>@errorMessage</span>
                    </div>
                }

                @if (isResendSuccess)
                {
                    <div class="eo-banner success" role="status">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12l5 5L20 7" />
                        </svg>
                        <span>A new code is on its way.</span>
                    </div>
                }

                <div class="eo-field-label">
                    Verification code <span>*</span>
                </div>

                <div class="@OtpBoxesClass" role="group" aria-label="Six-digit verification code">
                    @for (var index = 0; index < otpDigits.Length; index++)
                    {
                        var position = index;

                        <input @ref="otpInputs[position]"
                               value="@otpDigits[position]"
                               @oninput="@(args => UpdateOtpDigitAsync(position, args))"
                               @onkeydown="@(args => HandleOtpKeyDownAsync(position, args))"
                               class="eo-box"
                               maxlength="1"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               autocomplete="@(position == 0 ? "one-time-code" : "off")"
                               aria-label="Verification code digit @(position + 1)"
                               disabled="@isBusy" />
                    }
                </div>

                @if (remainingAttempts is int attempts && attempts > 0)
                {
                    <p class="eo-attempts" aria-live="polite">
                        @attempts @(attempts == 1 ? "attempt" : "attempts") left before this code is used up.
                    </p>
                }

                <div class="eo-resend">
                    <span>Didn't get it?</span>
                    <button type="button"
                            class="eo-resend-button"
                            disabled="@isBusy"
                            @onclick="ResendAsync">
                        Send a new code
                    </button>
                </div>
            </main>

            <footer class="eo-footer ats-dialog-footer">
                <button type="button" class="eo-button eo-button-cancel" disabled="@isBusy" @onclick="Cancel">
                    Cancel
                </button>
                <button type="button"
                        class="eo-button eo-button-verify @(IsOtpComplete ? "is-ready" : null)"
                        disabled="@(isBusy || !IsOtpComplete)"
                        @onclick="VerifyAsync">
                    @if (isBusy)
                    {
                        <MudProgressCircular Class="eo-spinner" Size="Size.Small" Indeterminate="true" />
                        <span>Verifying</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 6 9 17l-5-5" />
                        </svg>
                        <span>@ConfirmLabel</span>
                    }
                </button>
            </footer>
        </div>
    </DialogContent>
</MudDialog>
