@page "/s&i/ats/withdrawn"
@namespace FrontendWebassembly.Component.ATS
@layout ATSLayout
@attribute [RequirePermission(6, 7)]
@attribute [RequireATSModule(5)]
@inject IEndorsementSubmissionService EndorsementSubmissionService
@inherits CrudPageBase

<PageTitle>ATS - Withdrawn</PageTitle>

<div class="ats-management-page withdrawn-applications-scope">
<TableComponent @ref="lockedUsersTable"
                TItem="FrontendWebassembly.DTO.ATS.EmailInvitationRequestListDTO"
                Title="Withdrawn applications"
                EnableReload="true"
                ContainerClass="ats-management-card withdrawn-applications"
                EnableSearch="true"
                SearchLabel=""
                SearchPlaceholder="Search withdrawn applications"
                LoadServerData="LoadWithdrawnServerData"
                CursorPagerState="_withdrawnLoader"
                SearchString="@searchString"
                ColumnCount="8"
                SearchStringChanged="@((string val) => searchString = val)">
    <HeaderTemplate>
        <MudTh>Ticket No.</MudTh>
        <MudTh>Candidate</MudTh>
        <MudTh>Requestor</MudTh>
        <MudTh>First Name</MudTh>
        <MudTh>Last Name</MudTh>
        <MudTh>Date Created</MudTh>
        <MudTh>Ticket Status</MudTh>
        <MudTh>Action</MudTh>
    </HeaderTemplate>

    <RowTemplate Context="item">
        @if(_loadingEmailInvitationId == item.EmailInvitationID)
        {
            <MudTd DataLabel="Ticket No."><MudSkeleton Height="20px" Width="80px" /></MudTd>
            <MudTd DataLabel="Candidate"><MudSkeleton Height="20px" Width="90%" /></MudTd>
            <MudTd DataLabel="Requestor"><MudSkeleton Height="20px" Width="80%" /></MudTd>
            <MudTd DataLabel="First Name"><MudSkeleton Height="20px" Width="80%" /></MudTd>
            <MudTd DataLabel="Last Name"><MudSkeleton Height="20px" Width="80%" /></MudTd>
            <MudTd DataLabel="Date Created"><MudSkeleton Height="20px" Width="120px" /></MudTd>
            <MudTd DataLabel="Ticket Status"><MudSkeleton Height="24px" Width="100px" /></MudTd>
            <MudTd DataLabel="Action">
                <MudSkeleton Height="36px" Width="36px" />
            </MudTd>
        }
        else
        {
            <MudTd DataLabel="Ticket No.">
                @if (!string.IsNullOrWhiteSpace(item.TicketNumber))
                {
                    <span class="withdrawn-ticket-number">@item.TicketNumber</span>
                }
                else
                {
                    <span class="withdrawn-ticket-empty" title="OMS has not issued a ticket for this order yet">—</span>
                }
            </MudTd>
            <MudTd DataLabel="Candidate">
                <div class="withdrawn-candidate">
                    <span class="withdrawn-avatar">@GetInitials(item.FirstName, item.LastName)</span>
                    <span class="withdrawn-email">@item.EmailAddress</span>
                </div>
            </MudTd>
            <MudTd DataLabel="Requestor">@item.Requestor</MudTd>
            <MudTd DataLabel="First Name" Class="withdrawn-name">@item.FirstName</MudTd>
            <MudTd DataLabel="Last Name" Class="withdrawn-name">@item.LastName</MudTd>
            <MudTd DataLabel="Date Created">@(item.OrderCreatedAt?.ToString("MMMM dd, yyyy") ?? "—")</MudTd>
            <MudTd DataLabel="Ticket Status"><span class="withdrawn-status">Application withdrawn</span></MudTd>
            <MudTd DataLabel="Action">
                <button type="button"
                        class="withdrawn-action"
                        aria-label="@($"Send follow up to {item.FirstName} {item.LastName}")"
                        @onclick="@(() => ConfirmResendApplicationForm(item.EmailInvitationID))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
                    </svg>
                </button>
            </MudTd>
        }

    </RowTemplate>

    <NoRecordsTemplate>
        <div class="ats-management-empty">
            <MudIcon Icon="@Icons.Material.Filled.PersonOff" />
            <strong>No withdrawn applications</strong>
            <span>Withdrawn candidate applications will appear here.</span>
        </div>
    </NoRecordsTemplate>
</TableComponent>
</div>

