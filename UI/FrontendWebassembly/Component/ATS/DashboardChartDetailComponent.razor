<MudDialog Class="ats-chart-detail-dialog philsys-shadow-box"
           Style="padding: 0; width: min(1200px, calc(100vw - 32px)); max-width: 1200px; border-radius: 14px;">
    <DialogContent>
        <div class="ats-chart-detail-shell">
            <div class="ats-chart-detail-header">
                <div class="ats-chart-detail-header-spacer" aria-hidden="true"></div>
                <div class="ats-chart-detail-heading">
                    <MudText Typo="Typo.h5" Align="Align.Center" Class="ats-chart-detail-title">
                        @ChartTitle
                    </MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Requester: @RequesterDisplayName
                    </MudText>
                </div>
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Close"
                           OnClick="CloseDialog">
                    Close
                </MudButton>
            </div>

            <div class="ats-chart-detail-card">
    @if (!_isSupportedChart)
    {
        <div class="ats-chart-detail-state">
            <MudText Typo="Typo.h6" Align="Align.Center">Dashboard chart not found.</MudText>
            <MudText Color="Color.Secondary" Align="Align.Center">
                Return to the dashboard and select one of the available charts.
            </MudText>
        </div>
    }
    else
    {
        @switch (_normalizedChartKey)
        {
            case ATSDashboardChartKeys.UserYtdHire:
                @if (HasYtdHireData)
                {
                    <div class="ats-detail-chart-legend">
                        @for (var index = 0; index < _dashboard.YtdHireSeries.Count; index++)
                        {
                            var series = _dashboard.YtdHireSeries[index];
                            <span class="ats-detail-chart-legend-item">
                                <span class="ats-detail-chart-legend-dot"
                                      style="background-color: @GetAreaLegendColor(index)"></span>
                                @series.Name
                            </span>
                        }
                        <span class="ats-detail-chart-total">YTD Total: @_ytdHireGrandTotal</span>
                    </div>
                    <div class="ats-detail-area-shell">
                        <svg class="ats-detail-area-chart"
                             viewBox="0 0 900 480"
                             preserveAspectRatio="none"
                             role="img"
                             aria-label="Monthly hires by requester">
                            @foreach (var tick in _ytdHireYAxisTicks)
                            {
                                <line class="ats-detail-area-grid-line"
                                      x1="64"
                                      x2="882"
                                      y1="@FormatSvgNumber(tick.Position)"
                                      y2="@FormatSvgNumber(tick.Position)" />
                            }
                            @foreach (var layer in _ytdHireLayers)
                            {
                                <polygon points="@layer.PolygonPoints"
                                         fill="@layer.Color"
                                         fill-opacity="0.20">
                                    <title>@layer.Name</title>
                                </polygon>
                            }
                            @foreach (var layer in _ytdHireLayers)
                            {
                                <polyline points="@layer.LinePoints"
                                          fill="none"
                                          stroke="@layer.Color"
                                          stroke-width="3" />
                                @foreach (var point in layer.Points)
                                {
                                    <circle class="ats-detail-area-hover-target"
                                            cx="@FormatSvgNumber(point.X)"
                                            cy="@FormatSvgNumber(point.Y)"
                                            r="10"
                                            tabindex="0"
                                            focusable="true"
                                            aria-label="@($"{layer.Name}, {point.Month}: {point.Value}")"
                                            @onmouseenter="@(() => ShowYtdHireHover(layer, point))"
                                            @onmouseleave="ClearYtdHireHover"
                                            @onfocus="@(() => ShowYtdHireHover(layer, point))"
                                            @onblur="ClearYtdHireHover">
                                        <title>@layer.Name - @point.Month: @point.Value</title>
                                    </circle>
                                }
                            }
                            @if (_ytdHireHover is not null)
                            {
                                <circle class="ats-detail-area-hover-marker"
                                        cx="@FormatSvgNumber(_ytdHireHover.X)"
                                        cy="@FormatSvgNumber(_ytdHireHover.Y)"
                                        r="7"
                                        fill="@_ytdHireHover.Color" />
                            }
                            <line class="ats-detail-area-axis-line"
                                  x1="64"
                                  x2="882"
                                  y1="432"
                                  y2="432" />
                        </svg>
                        @if (_ytdHireHover is not null)
                        {
                            <div class="@GetYtdHireTooltipClass(_ytdHireHover)"
                                 style="@GetYtdHireTooltipStyle(_ytdHireHover)"
                                 role="status">
                                <span class="ats-detail-area-tooltip-dot"
                                      style="background-color: @_ytdHireHover.Color"></span>
                                <span>
                                    <strong>@_ytdHireHover.SeriesName</strong>
                                    <span>@_ytdHireHover.Month: @_ytdHireHover.Value</span>
                                </span>
                            </div>
                        }
                        @foreach (var tick in _ytdHireYAxisTicks)
                        {
                            <span class="ats-detail-area-y-label"
                                  style="@GetYAxisLabelStyle(tick.Position)">@tick.Label</span>
                        }
                        <div class="ats-detail-area-x-labels">
                            @foreach (var tick in _ytdHireXAxisTicks)
                            {
                                <span>@tick.Label</span>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <MudText Color="Color.Secondary" Align="Align.Center" Class="ats-chart-detail-state">
                        No hire data is available for this period.
                    </MudText>
                }
                break;

            case ATSDashboardChartKeys.CandidateResponseRate:
                @if (HasCandidateResponseData)
                {
                    <div class="ats-detail-donut-chart">
                        <MudChart ChartType="ChartType.Donut"
                                  Width="100%"
                                  Height="500px"
                                  ChartOptions="@_donutChartOptions"
                                  ChartSeries="@_candidateResponseData.AsChartDataSet()"
                                  ChartLabels="@_candidateResponseLabels" />
                    </div>
                    <div class="ats-detail-category-legend ats-detail-candidate-category-legend">
                        @for (var index = 0; index < _dashboard.CandidateResponseRate.Categories.Count; index++)
                        {
                            var category = _dashboard.CandidateResponseRate.Categories[index];
                            <div class="ats-detail-category-item ats-detail-candidate-category-item">
                                <span class="ats-detail-chart-legend-dot"
                                      style="background-color: @GetCategoryLegendColor(index)"></span>
                                <span>@category.Name</span>
                                <strong>@category.Percentage.ToString("0.#")%</strong>
                                <small>@category.Count candidate(s)</small>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <MudText Color="Color.Secondary" Align="Align.Center" Class="ats-chart-detail-state">
                        No sent invitation data is available.
                    </MudText>
                }
                break;

            case ATSDashboardChartKeys.TurnaroundTimeTrend:
                @if (HasTurnaroundTimeData)
                {
                    <div class="ats-detail-chart-legend">
                        @for (var index = 0; index < _dashboard.TurnaroundTimeTrend.Count; index++)
                        {
                            var series = _dashboard.TurnaroundTimeTrend[index];
                            <span class="ats-detail-chart-legend-item">
                                <span class="ats-detail-chart-legend-dot"
                                      style="background-color: @GetAreaLegendColor(index)"></span>
                                @series.Name
                            </span>
                        }
                    </div>
                    <div class="ats-detail-line-chart">
                        <MudChart ChartType="ChartType.Line"
                                  ChartSeries="@_turnaroundTimeSeries"
                                  ChartLabels="@_turnaroundTimeLabels"
                                  ChartOptions="@_lineChartOptions"
                                  Width="100%"
                                  Height="520px" />
                    </div>
                }
                else
                {
                    <MudText Color="Color.Secondary" Align="Align.Center" Class="ats-chart-detail-state">
                        No report-volume data is available for the last seven reporting days.
                    </MudText>
                }
                break;

            case ATSDashboardChartKeys.CompletionRate:
                @if (HasCompletionRateData)
                {
                    <div class="ats-detail-donut-chart">
                        <MudChart ChartType="ChartType.Donut"
                                  Width="100%"
                                  Height="500px"
                                  ChartOptions="@_donutChartOptions"
                                  ChartSeries="@_completionRateData.AsChartDataSet()"
                                  ChartLabels="@_completionRateLabels" />
                    </div>
                    <div class="ats-detail-category-legend">
                        @for (var index = 0; index < _dashboard.CompletionRate.Categories.Count; index++)
                        {
                            var category = _dashboard.CompletionRate.Categories[index];
                            <div class="ats-detail-category-item">
                                <span class="ats-detail-chart-legend-dot"
                                      style="background-color: @GetCategoryLegendColor(index)"></span>
                                <span>@category.Name</span>
                                <strong>@category.Percentage.ToString("0.#")%</strong>
                                <small>@category.Count report(s)</small>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <MudText Color="Color.Secondary" Align="Align.Center" Class="ats-chart-detail-state">
                        No report completion data is available.
                    </MudText>
                }
                break;
        }
    }
            </div>
        </div>
    </DialogContent>
</MudDialog>
