<MudDialog Class="um-dialog" Style="padding: 0;">
    <DialogContent>
        <div class="um-dialog-shell">
            <div class="um-dialog-header">
                <div>
                    <MudText Typo="Typo.h5" Class="um-dialog-title">Edit client</MudText>
                    <MudText Typo="Typo.body1" Class="um-dialog-subtitle">Update client details</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Class="um-dialog-close" OnClick="Cancel" />
            </div>

            <MudDivider />

            <MudPaper Elevation="0" Class="um-dialog-body">
                <MudForm @ref="EditClientForm">
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="EditClient.ClientName"
                                      Label="Client Name"
                                      Required="true"
                                      RequiredError="Client Name is required"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="100"
                                      Class="oneplatform-rounded-input philsys-uppercase-input" />

                        <MudTextField @bind-Value="EditClient.ClientDescription"
                                      Label="Client Description"
                                      Required="true"
                                      RequiredError="Client Description is required"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="3"
                                      MaxLength="500"
                                      Class="oneplatform-rounded-input" />

                        <MudSelect T="int"
                                   MultiSelection="true"
                                   SelectedValues="SelectedPackageIds"
                                   SelectedValuesChanged="OnSelectedPackageIdsChanged"
                                   MultiSelectionTextFunc="GetSelectedPackagesText"
                                   Label="Packages"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Error="@(!string.IsNullOrEmpty(PackageError))"
                                   ErrorText="@PackageError"
                                   Class="oneplatform-rounded-input">
                            @foreach (var package in Packages)
                            {
                                var isAssigned = SelectedPackageIds.Contains(package.PackageId);
                                <MudSelectItem T="int"
                                               Value="@package.PackageId"
                                               Disabled="@(!package.IsActive && !isAssigned)">
                                    @package.PackageName@(!package.IsActive ? " (Inactive)" : string.Empty)
                                </MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="bool"
                                   @bind-Value="EditClient.IsActive"
                                   Label="Status"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="oneplatform-rounded-input">
                            <MudSelectItem Value="true">Active</MudSelectItem>
                            <MudSelectItem Value="false">Inactive</MudSelectItem>
                        </MudSelect>
                    </MudStack>
                </MudForm>
            </MudPaper>

            <div class="um-dialog-footer">
                <MudButton OnClick="Cancel" Variant="Variant.Outlined" Class="um-secondary-button">Cancel</MudButton>
                <MudButton OnClick="Submit" Class="theme-button theme-button-active um-primary-button">Save</MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>
