<MudDialog Class="um-dialog ec-dialog ats-scroll-dialog" Style="padding: 0; width: min(540px, calc(100vw - 24px)); max-width: 540px;">
    <DialogContent>
        <div class="ec-shell ats-dialog-shell">
            <header class="ec-header ats-dialog-header">
                <div class="ec-header-row">
                    <div class="ec-header-left">
                        <div class="ec-icon-badge" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M12 20h9" />
                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                            </svg>
                        </div>
                        <div class="ec-header-text">
                            <h1>Edit client</h1>
                            <p>Update client details</p>
                        </div>
                    </div>

                    <button type="button" class="ec-close" aria-label="Close edit client dialog" @onclick="Cancel">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                            <path d="M6 6l12 12M18 6 6 18" />
                        </svg>
                    </button>
                </div>
            </header>

            <main class="ec-body ats-dialog-body">
                <MudForm @ref="EditClientForm">
                    <section class="ec-section" aria-labelledby="edit-client-details-heading">
                        <div class="ec-section-head">
                            <span class="ec-section-number">1</span>
                            <h2 id="edit-client-details-heading">Client details</h2>
                            <span class="ec-section-helper">Name and describe the client</span>
                        </div>

                        <div class="ec-section-body">
                            <div class="ec-field">
                                <label for="ec-client-name">Client name <span class="ec-required">*</span></label>
                                <div class="ec-input-wrap ec-name-wrap">
                                    <MudTextField @bind-Value="EditClient.ClientName"
                                                  InputId="ec-client-name"
                                                  Placeholder="e.g. Acme Talent Group"
                                                  Required="true"
                                                  RequiredError="Client name is required"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  MaxLength="100"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Outlined.Apartment"
                                                  Class="ec-control" />
                                </div>
                            </div>

                            <div class="ec-field">
                                <label for="ec-client-description">Client description <span class="ec-required">*</span></label>
                                <div class="ec-input-wrap ec-description-wrap">
                                    <MudTextField @bind-Value="EditClient.ClientDescription"
                                                  InputId="ec-client-description"
                                                  Placeholder="A short note about this client"
                                                  Required="true"
                                                  RequiredError="Client description is required"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Lines="4"
                                                  Immediate="true"
                                                  MaxLength="240"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Outlined.Article"
                                                  Class="ec-control ec-description-control" />
                                </div>
                                <div class="ec-character-count" aria-live="polite">@DescriptionLength / 240</div>
                            </div>
                        </div>
                    </section>

                    <section class="ec-section" aria-labelledby="edit-client-packages-heading">
                        <div class="ec-section-head">
                            <span class="ec-section-number">2</span>
                            <h2 id="edit-client-packages-heading">Packages &amp; availability</h2>
                            <span class="ec-section-helper">Assigned packages and status</span>
                        </div>

                        <div class="ec-section-body">
                            <div class="ec-field">
                                <label>Packages</label>
                                <div class="ec-chip-box @(PackageError is not null ? "has-error" : string.Empty)">
                                    @foreach (var package in SelectedPackages)
                                    {
                                        <span class="ec-chip">
                                            @package.PackageName
                                            <button type="button" aria-label="Remove @package.PackageName" @onclick="() => RemovePackage(package.PackageId)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                                                    <path d="M7 7l10 10M17 7 7 17" />
                                                </svg>
                                            </button>
                                        </span>
                                    }

                                    <MudMenu Label="Add package"
                                             StartIcon="@Icons.Material.Filled.Add"
                                             Variant="Variant.Text"
                                             Dense="true"
                                             Class="ec-package-menu">
                                        @foreach (var package in Packages)
                                        {
                                            var isSelected = SelectedPackageIds.Contains(package.PackageId);
                                            <MudMenuItem Disabled="@(!package.IsActive && !isSelected)"
                                                         OnClick="@(() => TogglePackage(package.PackageId))">
                                                <MudIcon Icon="@(isSelected ? Icons.Material.Filled.CheckBox : Icons.Material.Outlined.CheckBoxOutlineBlank)" Size="Size.Small" />
                                                <span>@package.PackageName@(!package.IsActive ? " (Inactive)" : string.Empty)</span>
                                            </MudMenuItem>
                                        }
                                    </MudMenu>
                                </div>
                                @if (PackageError is not null)
                                {
                                    <span class="ec-error" role="alert">@PackageError</span>
                                }
                            </div>

                            <div class="ec-field">
                                <label>Status</label>
                                <div class="ec-status-row">
                                    <div class="ec-status-copy">
                                        <p>Client @(EditClient.IsActive ? "active" : "inactive")</p>
                                        <span>Visible for assignment</span>
                                    </div>
                                    <div class="ec-status-control">
                                        <span class="ec-status-badge @(EditClient.IsActive ? string.Empty : "is-off")">
                                            @(EditClient.IsActive ? "Active" : "Inactive")
                                        </span>
                                        <button type="button"
                                                class="ec-toggle @(EditClient.IsActive ? string.Empty : "is-off")"
                                                role="switch"
                                                aria-checked="@EditClient.IsActive.ToString().ToLowerInvariant()"
                                                aria-label="Toggle client status"
                                                @onclick="ToggleStatus">
                                            <span></span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </MudForm>
            </main>

            <footer class="ec-footer ats-dialog-footer">
                <button type="button" class="ec-button ec-button-cancel" @onclick="Cancel">Cancel</button>
                <button type="button" class="ec-button ec-button-save" @onclick="Submit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5" />
                    </svg>
                    Save
                </button>
            </footer>
        </div>
    </DialogContent>
</MudDialog>
