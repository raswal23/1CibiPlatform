@namespace FrontendWebassembly.Component.ATS
@inject IReportService ReportService

<MudDialog Class="um-dialog ats-order-history-dialog"
           Style="padding: 0; width: min(540px, calc(100vw - 24px)); max-width: 540px;">
    <DialogContent>
        <div class="ats-history-header">
            <div class="ats-history-header-content">
                <div class="ats-history-header-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Outlined.History" />
                </div>

                <div class="ats-history-header-text">
                    <h2>Order status history</h2>
                    <p>@GetHeaderSubtitle()</p>
                </div>
            </div>

            <button type="button"
                    class="ats-history-close"
                    aria-label="Close status history"
                    @onclick="Cancel">
                <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
            </button>
        </div>

        @if (_loading)
        {
            <div class="ats-history-state">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                Loading history...
            </div>
        }
        else if (_failed)
        {
            <div class="ats-history-state">
                History could not be loaded.
                <MudButton OnClick="LoadAsync">Retry</MudButton>
            </div>
        }
        else if (_history.Count == 0)
        {
            <div class="ats-history-empty-state">
                <div class="ats-history-empty-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Outlined.HistoryToggleOff" />
                </div>

                <h3>No activity yet</h3>
                <p>
                    Status updates for this order will appear here as the request progresses.
                </p>
            </div>
        }
        else
        {
            <div class="ats-history-timeline">
                @foreach (var item in _history)
                {
                    <div class="ats-history-item @GetTone(item.EventType)">
                        <div class="ats-history-marker">
                            <MudIcon Icon="@GetIcon(item.EventType)" Size="Size.Small" />
                        </div>

                        <div>
                            <div class="ats-history-title">@GetTitle(item.EventType)</div>
                            <div class="ats-history-description">@GetDescription(item.EventType)</div>
                            <div class="ats-history-meta">
                                @item.OccurredAt.ToLocalTime().ToString("MMMM dd, yyyy - h:mm tt") &#183; @item.Source
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid EmailInvitationRequestId { get; set; }

    [Parameter]
    public string? SubjectName { get; set; }

    private IReadOnlyList<OrderStatusHistoryDTO> _history = [];
    private bool _loading = true;
    private bool _failed;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _failed = false;

        var response = await ReportService.GetOrderStatusHistoryAsync(
            EmailInvitationRequestId);

        if (response.IsSuccess && response.Data is not null)
        {
            _history = response.Data;
        }
        else
        {
            _failed = true;
        }

        _loading = false;
    }

    private void Cancel() => MudDialog.Cancel();

    private string GetHeaderSubtitle() => string.IsNullOrWhiteSpace(SubjectName)
        ? "Track this order's lifecycle"
        : $"Activity for {SubjectName}";

    private static string GetTitle(string eventType) => eventType switch
    {
        "OrderCreated" => "Order created",
        "ApplicationFormSubmitted" => "Application form submitted",
        "ApplicationFormWithdrawn" => "Application withdrawn",
        "ApplicationFormResent" => "Application form resent",
        "ApplicationFormFollowUpSent" => "Follow-up reminder sent",
        "WithdrawalNoticeEmail" => "Withdrawal notice",
        "DisputeAcknowledgementEmail" => "Dispute acknowledgement",
        "CompletionNoticeEmail" => "Completion notice",
        "InvitationEmailSent" => "Invitation email delivered",
        "ReportUploaded" => "Report uploaded",
        "ReportDisputed" => "Report disputed",
        "TicketRetryRequested" => "Ticketing retry requested",
        _ => eventType
    };

    private static string GetDescription(string eventType) => eventType switch
    {
        // "queued" for the events that hand a message to the sender, "delivered" only for
        // InvitationEmailSent, which is written after the SMTP server accepted it.
        "OrderCreated" => "The order was created and an application invitation was queued.",
        "ApplicationFormSubmitted" => "The subject successfully completed the application form.",
        "ApplicationFormWithdrawn" => "The subject withdrew the application form.",
        "ApplicationFormResent" => "A new application invitation was queued for the subject.",
        "ApplicationFormFollowUpSent" => "A reminder to complete the application form was queued for the subject.",
        "InvitationEmailSent" => "The invitation email was accepted by the mail server and is on its way to the subject.",
        "WithdrawalNoticeEmail" => "A withdrawal notice was issued to the requestor by email.",
        "DisputeAcknowledgementEmail" => "A dispute acknowledgement was issued to the filer by email.",
        "CompletionNoticeEmail" => "A completion notice was issued to the requestor by email.",
        "ReportUploaded" => "The final report was uploaded and the order was completed.",
        "ReportDisputed" => "The completed report was disputed by the requestor.",
        "TicketRetryRequested" => "The order was placed back on the ticketing queue. Its status is unchanged.",
        _ => "The order lifecycle was updated."
    };

    // The tone a row carries is the colour its status carries elsewhere in the console:
    // withdrawn is the red of the Search Report badge, completed its green, disputed the
    // orange the dispute screens use.
    //
    // The email rows are coloured by what the message did rather than by which screen sent
    // it. An acknowledgement confirms something already happened, so it takes the same green
    // as the completion it confirms. A notice announces something the reader has to know
    // about and may have to act on, so it takes amber. Both read down the timeline as
    // families - every green row is a confirmation, every amber row an announcement.
    private static string GetTone(string eventType) => eventType switch
    {
        // Lifecycle steps.
        "ReportUploaded" => "is-success",
        "ApplicationFormSubmitted" => "is-active",
        "ReportDisputed" => "is-dispute",
        "ApplicationFormWithdrawn" => "is-danger",

        // Both land the order in Pending Candidate Info, which the board draws as a
        // dashed outline rather than a filled pill - nothing has happened yet.
        "OrderCreated" => "is-pending",
        "ApplicationFormResent" => "is-pending",

        // Acknowledgements: a message confirming something that already happened. The
        // invitation row belongs here because it is the one email event written after the
        // mail server accepted the message rather than when it was queued.
        "DisputeAcknowledgementEmail" => "is-success",
        "InvitationEmailSent" => "is-success",

        // Notices: a message telling someone about a change. The follow-up reminder is one
        // in everything but name - it chases a subject whose form is still outstanding.
        "WithdrawalNoticeEmail" => "is-warning",
        "CompletionNoticeEmail" => "is-warning",
        "ApplicationFormFollowUpSent" => "is-warning",

        // Neither an acknowledgement nor a notice: nothing was sent and the order did not
        // move, so there is nothing for a colour to say.
        "TicketRetryRequested" => "is-neutral",
        _ => "is-neutral"
    };

    private static string GetIcon(string eventType) => eventType switch
    {
        "OrderCreated" => Icons.Material.Outlined.MailOutline,
        "ApplicationFormSubmitted" => Icons.Material.Outlined.EditNote,
        "ApplicationFormWithdrawn" => Icons.Material.Outlined.Cancel,
        "ApplicationFormResent" => Icons.Material.Outlined.Replay,
        "ApplicationFormFollowUpSent" => Icons.Material.Outlined.NotificationsActive,
        "WithdrawalNoticeEmail" => Icons.Material.Outlined.Send,
        "DisputeAcknowledgementEmail" => Icons.Material.Outlined.MarkEmailRead,
        "CompletionNoticeEmail" => Icons.Material.Outlined.ForwardToInbox,
        "InvitationEmailSent" => Icons.Material.Outlined.MarkEmailRead,
        "ReportUploaded" => Icons.Material.Outlined.Check,
        "ReportDisputed" => Icons.Material.Outlined.WarningAmber,

        // Autorenew rather than Replay, which already belongs to ApplicationFormResent.
        "TicketRetryRequested" => Icons.Material.Outlined.Autorenew,
        _ => Icons.Material.Outlined.Circle
    };
}
