@namespace FrontendWebassembly.Component.ATS
@inject IReportService ReportService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog Class="ats-download-dialog ats-scroll-dialog" Style="padding: 0;">
    <DialogContent>
        <div class="ats-download-shell ats-dialog-shell">
        <div class="ats-download-header ats-dialog-header">
            <div class="ats-download-header-row">
                <div class="ats-download-header-left">
                    <span class="ats-download-header-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 4v12M12 16l-4.5-4.5M12 16l4.5-4.5" /><path d="M4 18v1.5A1.5 1.5 0 005.5 21h13a1.5 1.5 0 001.5-1.5V18" /></svg>
                    </span>
                    <div>
                        <MudText Typo="Typo.h5" Class="ats-download-title">Select files to download</MudText>
                        <MudText Typo="Typo.body1" Class="ats-download-subtitle">@AvailableDocumentCount of @TotalDocuments documents are available</MudText>
                    </div>
                </div>
                <button type="button" class="ats-download-close" aria-label="Close" @onclick="Cancel">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
            </div>
        </div>

        <div class="ats-download-list ats-dialog-body">
            <div class="ats-download-item">
                <MudCheckBox @bind-Value="BiometricPhotoSelected"
                                 Disabled="@(string.IsNullOrWhiteSpace(ReportResult!.BiometricPhotoFileName))"
                                Class="ats-download-checkbox" />
                <div class="ats-download-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.BiometricPhotoFileName) ? "missing" : "available")">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                </div>
                <MudText Class="ats-download-doc-name">Biometric Photo</MudText>
                <MudText Class="@($"ats-download-pill {(string.IsNullOrWhiteSpace(ReportResult.BiometricPhotoFileName) ? "missing" : "available")}")">@(string.IsNullOrWhiteSpace(ReportResult.BiometricPhotoFileName) ? "Not uploaded" : "Available")</MudText>
            </div>

            <div class="ats-download-item">
                <MudCheckBox @bind-Value="ResumeSelected"
                             Disabled="@(string.IsNullOrWhiteSpace(ReportResult!.ResumeFileName))"
                             Class="ats-download-checkbox" />
                <div class="ats-download-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.ResumeFileName) ? "missing" : "available")">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                </div>
                <MudText Class="ats-download-doc-name">Resume / CV</MudText>
                <MudText Class="@($"ats-download-pill {(string.IsNullOrWhiteSpace(ReportResult.ResumeFileName) ? "missing" : "available")}")">@(string.IsNullOrWhiteSpace(ReportResult.ResumeFileName) ? "Not uploaded" : "Available")</MudText>
            </div>

            <div class="ats-download-item">
                <MudCheckBox @bind-Value="GovernmentIdSelected"
                             Disabled="@(string.IsNullOrWhiteSpace(ReportResult!.IdUploadedFileName))"
                             Class="ats-download-checkbox" />
                <div class="ats-download-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.IdUploadedFileName) ? "missing" : "available")">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                </div>
                <MudText Class="ats-download-doc-name">Government ID</MudText>
                <MudText Class="@($"ats-download-pill {(string.IsNullOrWhiteSpace(ReportResult.IdUploadedFileName) ? "missing" : "available")}")">@(string.IsNullOrWhiteSpace(ReportResult.IdUploadedFileName) ? "Not uploaded" : "Available")</MudText>
            </div>

            <div class="ats-download-item">
                <MudCheckBox @bind-Value="NbiSelected"
                             Disabled="@(string.IsNullOrWhiteSpace(ReportResult!.NbiClearanceFileName))"
                             Class="ats-download-checkbox" />
                <div class="ats-download-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.NbiClearanceFileName) ? "missing" : "available")">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                </div>
                <MudText Class="ats-download-doc-name">NBI clearance</MudText>
                <MudText Class="@($"ats-download-pill {(string.IsNullOrWhiteSpace(ReportResult.NbiClearanceFileName) ? "missing" : "available")}")">@(string.IsNullOrWhiteSpace(ReportResult.NbiClearanceFileName) ? "Not uploaded" : "Available")</MudText>
            </div>

            <div class="ats-download-item">
                <MudCheckBox @bind-Value="DiplomaSelected"
                             Disabled="@(string.IsNullOrWhiteSpace(ReportResult!.DiplomaFileName))"
                             Class="ats-download-checkbox" />
                <div class="ats-download-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.DiplomaFileName) ? "missing" : "available")">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                </div>
                <MudText Class="ats-download-doc-name">Diploma</MudText>
                <MudText Class="@($"ats-download-pill {(string.IsNullOrWhiteSpace(ReportResult.DiplomaFileName) ? "missing" : "available")}")">@(string.IsNullOrWhiteSpace(ReportResult.DiplomaFileName) ? "Not uploaded" : "Available")</MudText>
            </div>

            <div class="ats-download-item">
                <MudCheckBox @bind-Value="Coe1Selected"
                             Disabled="@(string.IsNullOrWhiteSpace(Coe1DisplayFileName))"
                             Class="ats-download-checkbox" />
                <div class="ats-download-doc-icon @(string.IsNullOrWhiteSpace(Coe1DisplayFileName) ? "missing" : "available")">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                </div>
                <MudText Class="ats-download-doc-name">Certificate of employment 1</MudText>
                <MudText Class="@($"ats-download-pill {(string.IsNullOrWhiteSpace(Coe1DisplayFileName) ? "missing" : "available")}")">@(string.IsNullOrWhiteSpace(Coe1DisplayFileName) ? "Not uploaded" : "Available")</MudText>
            </div>

            <div class="ats-download-item">
                <MudCheckBox @bind-Value="Coe2Selected"
                             Disabled="@(string.IsNullOrWhiteSpace(ReportResult!.Coe2FileName))"
                             Class="ats-download-checkbox" />
                <div class="ats-download-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.Coe2FileName) ? "missing" : "available")">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                </div>
                <MudText Class="ats-download-doc-name">Certificate of employment 2</MudText>
                <MudText Class="@($"ats-download-pill {(string.IsNullOrWhiteSpace(ReportResult.Coe2FileName) ? "missing" : "available")}")">@(string.IsNullOrWhiteSpace(ReportResult.Coe2FileName) ? "Not uploaded" : "Available")</MudText>
            </div>

            <div class="ats-download-item">
                <MudCheckBox @bind-Value="Coe3Selected"
                             Disabled="@(string.IsNullOrWhiteSpace(ReportResult!.Coe3FileName))"
                             Class="ats-download-checkbox" />
                <div class="ats-download-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.Coe3FileName) ? "missing" : "available")">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                </div>
                <MudText Class="ats-download-doc-name">Certificate of employment 3</MudText>
                <MudText Class="@($"ats-download-pill {(string.IsNullOrWhiteSpace(ReportResult.Coe3FileName) ? "missing" : "available")}")">@(string.IsNullOrWhiteSpace(ReportResult.Coe3FileName) ? "Not uploaded" : "Available")</MudText>
            </div>

            <div class="ats-download-item">
                <MudCheckBox @bind-Value="ConsentSelected"
                             Disabled="@(string.IsNullOrWhiteSpace(ReportResult!.ConsentFormFileName))"
                             Class="ats-download-checkbox" />
                <div class="ats-download-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.ConsentFormFileName) ? "missing" : "available")">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                </div>
                <MudText Class="ats-download-doc-name">Consent form</MudText>
                <MudText Class="@($"ats-download-pill {(string.IsNullOrWhiteSpace(ReportResult.ConsentFormFileName) ? "missing" : "available")}")">@(string.IsNullOrWhiteSpace(ReportResult.ConsentFormFileName) ? "Not uploaded" : "Available")</MudText>
            </div>

            <div class="ats-download-item ats-download-item-last">
                <MudCheckBox @bind-Value="ReportSelected"
                             Disabled="@(string.IsNullOrWhiteSpace(ReportResult!.UploadedReportFileName))"
                             Class="ats-download-checkbox" />
                <div class="ats-download-doc-icon @(string.IsNullOrWhiteSpace(ReportResult.UploadedReportFileName) ? "missing" : "available")">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                </div>
                @* The report's own type ("Initial Report", "Final Report"), or "No Report" when
                   none has been uploaded - the same label the result view shows for this row.
                   A fixed "Report file" told an operator nothing about WHICH report they were
                   about to download, and disagreed with the screen they opened this from. *@
                <MudText Class="ats-download-doc-name">@ReportResult.ReportStatus</MudText>
                <MudText Class="@($"ats-download-pill {(string.IsNullOrWhiteSpace(ReportResult.UploadedReportFileName) ? "missing" : "available")}")">@(string.IsNullOrWhiteSpace(ReportResult.UploadedReportFileName) ? "Not uploaded" : "Available")</MudText>
            </div>
        </div>

        <div class="ats-download-actions ats-dialog-footer">
            <MudTooltip Text="@(CanPreviewForm ? "View the answers submitted on the application form" : "The application form has not been filled up yet")">
                <MudButton Variant="Variant.Outlined"
                           Class="ats-download-preview"
                           Disabled="@(!CanPreviewForm || isLoadingPreview)"
                           StartIcon="@Icons.Material.Outlined.Visibility"
                           OnClick="OpenFormPreviewAsync">@(isLoadingPreview ? "Loading..." : "Preview form")</MudButton>
            </MudTooltip>

            <MudButton Variant="Variant.Filled"
                       Disabled="@(!HasSelectedFile)"
                       Class="@($"ats-download-submit {(HasSelectedFile ? "theme-button theme-button-active" : "theme-button-inactive")}")"
                       StartIcon="@Icons.Material.Outlined.Download"
                       OnClick="DownloadDocumentsAsync">@(HasSelectedFile ? $"Download ({SelectedFileCount})" : "Download")</MudButton>
        </div>
        </div>
    </DialogContent>
</MudDialog>
