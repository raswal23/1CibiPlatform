@page "/s&i/ats/aiassistant"
@namespace FrontendWebassembly.Component.ATS
@layout ATSLayout
@attribute [RequirePermission(6, 7)]
@attribute [RequireATSModule(12)]
@inject IAtsAssistantService AssistantService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inherits CrudPageBase
@implements IAsyncDisposable

<PageTitle>ATS - AI Assistant</PageTitle>

<div class="ats-assistant-page">
    <div class="ats-assistant-shell">

        <header class="ats-assistant-header">
            <div class="ats-assistant-brand">
                <span class="ats-assistant-brand-mark" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
                </span>
                <div class="ats-assistant-brand-text">
                    <h2>ATS Assistant</h2>
                    <p>Look up an order, or start a new one</p>
                </div>
            </div>

            <button type="button"
                    class="ats-assistant-clear"
                    disabled="@(_messages.Count == 0 || _isSending)"
                    @onclick="ClearConversation">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" aria-hidden="true">
                    <path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14" />
                </svg>
                Clear
            </button>
        </header>

        <div class="ats-assistant-stream" @ref="_streamRef" aria-live="polite">
            @if (_messages.Count == 0)
            {
                <div class="ats-assistant-empty">
                    <span class="ats-assistant-empty-mark" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" />
                    </span>
                    <strong>How can I help?</strong>
                    <span>Ask about an existing order, or tell me to create a new one.</span>

                    <div class="ats-assistant-suggestions">
                        @foreach (var suggestion in Suggestions)
                        {
                            <button type="button"
                                    class="ats-assistant-suggestion"
                                    @onclick="@(() => UseSuggestionAsync(suggestion))">
                                @suggestion
                            </button>
                        }
                    </div>
                </div>
            }

            @foreach (var message in _messages)
            {
                <div class="@GetRowClass(message)">
                    @if (!message.IsUser)
                    {
                        <span class="ats-assistant-avatar ats-assistant-avatar-bot" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
                        </span>
                    }

                    <div class="ats-assistant-bubble-group">
                        @if (!string.IsNullOrWhiteSpace(message.Html))
                        {
                            <div class="@GetBubbleClass(message)">
                                @((MarkupString)message.Html)
                            </div>
                        }

                        @if (message.Orders is { Count: > 0 })
                        {
                            <div class="ats-assistant-orders">
                                <table class="ats-assistant-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Candidate</th>
                                            <th scope="col">Status</th>
                                            <th scope="col">Package</th>
                                            <th scope="col">Requestor</th>
                                            <th scope="col">Hit Status</th>
                                            <th scope="col">Completed</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in message.Orders)
                                        {
                                            <tr>
                                                <td data-label="Candidate">
                                                    <span class="ats-assistant-subject">@order.SubjectName</span>
                                                </td>
                                                <td data-label="Status">
                                                    <span class="@GetStatusClass(order.OrderStatus)">
                                                        @(string.IsNullOrWhiteSpace(order.OrderStatus) ? "â€”" : order.OrderStatus)
                                                    </span>
                                                </td>
                                                <td data-label="Package">@(order.SelectedPackage ?? "â€”")</td>
                                                <td data-label="Requestor">@(order.Requestor ?? "â€”")</td>
                                                <td data-label="Result">@(order.HitStatus ?? "â€”")</td>
                                                <td data-label="Completed">@FormatDate(order.OrderCompletedAt)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (message.Draft is not null)
                        {
                            <div class="ats-assistant-confirm">
                                <div class="ats-assistant-confirm-head">
                                    <span class="ats-assistant-confirm-mark" aria-hidden="true">
                                        <MudIcon Icon="@Icons.Material.Filled.FactCheck" />
                                    </span>
                                    <div>
                                        <strong>Review this order</strong>
                                        <span>Nothing is sent until you confirm.</span>
                                    </div>
                                </div>

                                <dl class="ats-assistant-confirm-grid">
                                    <div>
                                        <dt>Candidate</dt>
                                        <dd>@message.Draft.FullName</dd>
                                    </div>
                                    <div>
                                        <dt>Email</dt>
                                        <dd>@message.Draft.EmailAddress</dd>
                                    </div>
                                    <div>
                                        <dt>Mobile</dt>
                                        <dd>@message.Draft.MobileNumber</dd>
                                    </div>
                                    <div>
                                        <dt>Package</dt>
                                        <dd>@message.Draft.SelectPackage</dd>
                                    </div>
                                    <div>
                                        <dt>Speed</dt>
                                        <dd>@message.Draft.RushNormal</dd>
                                    </div>
                                </dl>

                                @if (message.DraftState == OrderDraftState.Pending)
                                {
                                    <div class="ats-assistant-confirm-actions">
                                        <button type="button"
                                                class="ats-assistant-btn ats-assistant-btn-ghost"
                                                disabled="@_isConfirming"
                                                @onclick="@(() => CancelDraft(message))">
                                            Cancel
                                        </button>
                                        <button type="button"
                                                class="ats-assistant-btn ats-assistant-btn-primary"
                                                disabled="@_isConfirming"
                                                @onclick="@(() => ConfirmDraftAsync(message))">
                                            @if (_isConfirming)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                                <span>Sendingâ€¦</span>
                                            }
                                            else
                                            {
                                                <span>Confirm &amp; send</span>
                                            }
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="@GetDraftStateClass(message.DraftState)">
                                        @(message.DraftState == OrderDraftState.Confirmed
                                            ? "Order created and invitation sent."
                                            : "Cancelled. Nothing was sent.")
                                    </div>
                                }
                            </div>
                        }

                        <span class="ats-assistant-time">@message.Time.ToString("hh:mm tt")</span>
                    </div>

                    @if (message.IsUser)
                    {
                        <span class="ats-assistant-avatar ats-assistant-avatar-user" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                        </span>
                    }
                </div>
            }

            @if (_isTyping)
            {
                <div class="ats-assistant-row ats-assistant-row-bot">
                    <span class="ats-assistant-avatar ats-assistant-avatar-bot" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
                    </span>
                    <div class="ats-assistant-bubble ats-assistant-bubble-bot ats-assistant-typing">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            }
        </div>

        <div class="ats-assistant-composer">
            <div class="ats-assistant-input-wrap">
                <input class="ats-assistant-input"
                       type="text"
                       placeholder="@(_isListening ? "Listening" : "Ask about an order, or describe a new one")"
                       aria-label="Message the ATS assistant"
                       disabled="@_isSending"
                       @bind="_currentMessage"
                       @bind:event="oninput"
                       @bind:after="OnMessageTyped"
                       @onkeydown="HandleKeyDown" />

                @if (_isSpeechSupported)
                {
                    <button type="button"
                            class="@GetMicClass()"
                            aria-label="@(_isListening ? "Stop dictation" : "Dictate your message")"
                            aria-pressed="@_isListening"
                            title="@(_isListening ? "Listening â€” click to stop" : "Dictate your message")"
                            disabled="@_isSending"
                            @onclick="ToggleDictationAsync">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="9" y="2" width="6" height="11" rx="3" />
                            <path d="M5 11a7 7 0 0 0 14 0M12 18v4M9 22h6" />
                        </svg>
                    </button>
                }

                <button type="button"
                        class="ats-assistant-send"
                        aria-label="Send message"
                        disabled="@(_isSending || string.IsNullOrWhiteSpace(_currentMessage))"
                        @onclick="SendAsync">
                    @if (_isSending)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z" />
                        </svg>
                    }
                </button>
            </div>

            <span class="ats-assistant-sr-only" role="status" aria-live="polite">
                @_dictationStatus
            </span>

            <p class="ats-assistant-hint">
                The assistant always asks you to confirm before an order is created.
                @if (_isSpeechSupported)
                {
                    <span>Dictation is handled by your browser and is never sent to us.</span>
                }
            </p>
        </div>
    </div>
</div>
