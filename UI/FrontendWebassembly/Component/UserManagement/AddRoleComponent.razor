<UserManagementDialogShell Title="Add role"
                           Subtitle="Create a new role for access control"
                           SectionTitle="Role details"
                           SectionHelper="Name and describe the role"
                           Icon="@Icons.Material.Outlined.AdminPanelSettings"
                           OnClose="Cancel">
    <ChildContent>
        <MudForm @ref="AddRoleForm">
            <div class="um-field">
                <label for="um-role-name">Role name <span class="um-required">*</span></label>
                <div class="um-input-wrap um-single-line-wrap">
                    <MudTextField @bind-Value="Role.RoleName"
                                  InputId="um-role-name"
                                  Placeholder="e.g. Branch supervisor"
                                  Required="true"
                                  RequiredError="Role Name is required"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  MaxLength="100"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.AdminPanelSettings" />
                </div>
            </div>

            <div class="um-field">
                <label for="um-role-description">Role description <span class="um-required">*</span></label>
                <div class="um-input-wrap um-description-wrap">
                    <MudTextField @bind-Value="Role.Description"
                                  InputId="um-role-description"
                                  Placeholder="What access does this role grant?"
                                  Required="true"
                                  RequiredError="Description is required"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="4"
                                  Immediate="true"
                                  MaxLength="100"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Article" />
                </div>
                <div class="um-character-count" aria-live="polite">@(Role.Description?.Length ?? 0) / 100</div>
            </div>
        </MudForm>
    </ChildContent>
    <FooterContent>
        <button type="button" class="um-button um-button-cancel" @onclick="Cancel">Cancel</button>
        <button type="button" class="um-button um-button-save" @onclick="Submit">Save</button>
    </FooterContent>
</UserManagementDialogShell>
