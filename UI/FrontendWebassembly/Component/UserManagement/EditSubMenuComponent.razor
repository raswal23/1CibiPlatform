<MudDialog Style="padding: 8px;">
    <DialogContent>
        <MudForm @ref="EditSubMenuForm">
            <MudTextField @bind-Value="EditSubMenu.subMenuId"
                          Label="SubMenu Id"
                          ReadOnly
                          Adornment="Adornment.Start"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="100"
                          Class="oneplatform-rounded-input philsys-uppercase-input" />

            <MudAutocomplete T="string"
                             @bind-Value="EditSubMenu.subMenuName"
                             Label="SubMenu Name"
                             Required="true"
                             RequiredError="SubMenu Name is required"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             MaxLength="100"
                             Adornment="Adornment.Start"
                             SearchFunc="SearchSubMenus"
                             ToStringFunc="@(x => x)"
                             ResetValueOnEmptyText="false"
                             Clearable="true"
                             Dense="true"
                             Class="oneplatform-rounded-input philsys-uppercase-input" />

            <MudTextField @bind-Value="EditSubMenu.Description"
                          Label="Description"
                          Required="true"
                          RequiredError="Description is required"
                          Adornment="Adornment.Start"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="100"
                          Class="oneplatform-rounded-input philsys-uppercase-input" />

            <MudCheckBox T="bool"
                         @bind-Value="EditSubMenu.IsActive"
                         Label="Is Active" />
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Style="border-radius: 4px; border: 2px solid gray;">
            Cancel
        </MudButton>
        <MudButton OnClick="Submit"
                   Class="theme-button theme-button-active"
                   Style="border-radius: 4px;">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>
