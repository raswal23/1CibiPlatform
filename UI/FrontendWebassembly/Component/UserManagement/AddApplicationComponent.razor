<UserManagementDialogShell Title="Add application"
                           Subtitle="Create a new application record"
                           SectionTitle="Application details"
                           SectionHelper="Name and describe the application"
                           SecondarySectionTitle="Availability"
                           SecondarySectionHelper="Turn the application on or off"
                           Icon="@Icons.Material.Outlined.Apps"
                           OnClose="Cancel">
    <ChildContent>
        <MudForm @ref="AddApplicationForm">
            <div class="um-field">
                <label for="um-application-name">Application name <span class="um-required">*</span></label>
                <div class="um-input-wrap um-single-line-wrap">
                    <MudAutocomplete T="string"
                                     @bind-Value="Application.AppName"
                                     InputId="um-application-name"
                                     Placeholder="Select an application name"
                                     Required="true"
                                     RequiredError="Application Name is required"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MaxLength="100"
                                     MaxItems="50"
                                     SearchFunc="SearchApplications"
                                     ToStringFunc="@(x => x)"
                                     ResetValueOnEmptyText="false"
                                     Clearable="false"
                                     Dense="true"
                                     OpenOnFocus="true"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Outlined.Apps"
                                     OpenIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     CloseIcon="@Icons.Material.Filled.KeyboardArrowUp" />
                </div>
            </div>

            <div class="um-field">
                <label for="um-application-description">Application description <span class="um-required">*</span></label>
                <div class="um-input-wrap um-description-wrap">
                    <MudTextField @bind-Value="Application.Description"
                                  InputId="um-application-description"
                                  Placeholder="What does this application provide?"
                                  Required="true"
                                  RequiredError="Application description is required"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="4"
                                  Immediate="true"
                                  MaxLength="240"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Article" />
                </div>
                <div class="um-character-count">@(Application.Description?.Length ?? 0) / 240</div>
            </div>
        </MudForm>
    </ChildContent>
    <SecondaryContent>
        <div class="um-field">
            <label>Status</label>
            <div class="um-status-row">
                <div class="um-status-copy">
                    <p>Application @(Application.IsActive ? "active" : "inactive")</p>
                    <span>Available to assign to users once saved</span>
                </div>
                <div class="um-status-control">
                    <span class="um-status-badge @(Application.IsActive ? string.Empty : "is-off")">
                        @(Application.IsActive ? "Active" : "Inactive")
                    </span>
                    <button type="button"
                            class="um-toggle @(Application.IsActive ? string.Empty : "is-off")"
                            role="switch"
                            aria-checked="@Application.IsActive.ToString().ToLowerInvariant()"
                            aria-label="Toggle application status"
                            @onclick="ToggleStatus">
                        <span></span>
                    </button>
                </div>
            </div>
        </div>
    </SecondaryContent>
    <FooterContent>
        <button type="button" class="um-button um-button-cancel" @onclick="Cancel">Cancel</button>
        <button type="button" class="um-button um-button-save" @onclick="Submit">Save</button>
    </FooterContent>
</UserManagementDialogShell>
