<UserManagementDialogShell Title="Review user approval"
                           Subtitle="Approve or disapprove the selected user"
                           SectionTitle="User details"
                           SectionHelper="Review before making a decision"
                           SectionClass="approval-dialog-section"
                           Icon="@Icons.Material.Outlined.HowToReg"
                           SplitFooter="true"
                           OnClose="Cancel">
    <ChildContent>
        <MudForm @ref="EditUserApprovalForm">
            <div class="approval-field">
                <label>Email<span class="approval-required">*</span></label>
                <div class="approval-field-display">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="M3 7l9 6 9-6" />
                    </svg>
                    <span class="approval-email">@User.email</span>
                    <span class="approval-verified">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M20 6L9 17l-5-5" />
                        </svg>
                        Verified
                    </span>
                </div>
            </div>
        </MudForm>
    </ChildContent>
    <FooterContent>
        <button type="button" class="um-button um-button-danger" @onclick="Cancel">Disapprove</button>
        <button type="button" class="um-button um-button-save" @onclick="Submit">Approve</button>
    </FooterContent>
</UserManagementDialogShell>
