@inject LocalStorageService LocalStorageService
@inject IUserManagementService UserManagementService
@inject ISnackbar Snackbar

<UserManagementDialogShell Title="Assign application role"
                           Subtitle="Link a user, application, submenu, and role"
                           SectionTitle="Assignment details"
                           SectionHelper="Choose all access mappings"
                           Icon="@Icons.Material.Outlined.ManageAccounts"
                           OnClose="Cancel">
    <ChildContent>
        <MudForm @ref="AddAppSubRoleForm">
            <div class="um-field">
                <label for="um-appsubrole-user">User <span class="um-required">*</span></label>
                <div class="um-input-wrap um-single-line-wrap">
                    <MudAutocomplete T="UsersDTO"
                                     @bind-Value="selectedUser"
                                     InputId="um-appsubrole-user"
                                     Placeholder="Search by email address"
                                     SearchFunc="@SearchUsers"
                                     ToStringFunc="u => u?.email"
                                     Required="true"
                                     RequiredError="User is required"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MaxItems="50"
                                     Dense="true"
                                     OpenOnFocus="true"
                                     Clearable="true"
                                     ResetValueOnEmptyText="false"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Outlined.Person"
                                     OpenIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     CloseIcon="@Icons.Material.Filled.KeyboardArrowUp" />
                </div>
            </div>

            <div class="um-field">
                <label for="um-appsubrole-application">Application <span class="um-required">*</span></label>
                <div class="um-input-wrap um-single-line-wrap">
                    <MudAutocomplete T="ApplicationsDTO"
                                     @bind-Value="selectedApp"
                                     InputId="um-appsubrole-application"
                                     Placeholder="Select an application"
                                     SearchFunc="@SearchApplications"
                                     ToStringFunc="a => a?.applicationName"
                                     Required="true"
                                     RequiredError="Application is required"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MaxItems="50"
                                     Dense="true"
                                     OpenOnFocus="true"
                                     Clearable="true"
                                     ResetValueOnEmptyText="false"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Outlined.Apps"
                                     OpenIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     CloseIcon="@Icons.Material.Filled.KeyboardArrowUp" />
                </div>
            </div>

            <div class="um-field">
                <label for="um-appsubrole-submenu">Submenu <span class="um-required">*</span></label>
                <div class="um-input-wrap um-single-line-wrap">
                    <MudAutocomplete T="SubMenusDTO"
                                     @bind-Value="selectedMenu"
                                     InputId="um-appsubrole-submenu"
                                     Placeholder="Select a submenu"
                                     SearchFunc="@SearchSubMenus"
                                     ToStringFunc="s => s?.subMenuName"
                                     Required="true"
                                     RequiredError="SubMenu is required"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MaxItems="50"
                                     Dense="true"
                                     OpenOnFocus="true"
                                     Clearable="true"
                                     ResetValueOnEmptyText="false"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Outlined.Menu"
                                     OpenIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     CloseIcon="@Icons.Material.Filled.KeyboardArrowUp" />
                </div>
            </div>

            <div class="um-field">
                <label for="um-appsubrole-role">Role <span class="um-required">*</span></label>
                <div class="um-input-wrap um-single-line-wrap">
                    <MudAutocomplete T="RolesDTO"
                                     @bind-Value="selectedRole"
                                     InputId="um-appsubrole-role"
                                     Placeholder="Select a role"
                                     SearchFunc="@SearchRoles"
                                     ToStringFunc="r => r?.roleName"
                                     Required="true"
                                     RequiredError="Role is required"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MaxItems="50"
                                     Dense="true"
                                     OpenOnFocus="true"
                                     Clearable="true"
                                     ResetValueOnEmptyText="false"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Outlined.AdminPanelSettings"
                                     OpenIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     CloseIcon="@Icons.Material.Filled.KeyboardArrowUp" />
                </div>
            </div>
        </MudForm>
    </ChildContent>
    <FooterContent>
        <button type="button" class="um-button um-button-cancel" @onclick="Cancel">Cancel</button>
        <button type="button" class="um-button um-button-save" @onclick="Submit">Save</button>
    </FooterContent>
</UserManagementDialogShell>
