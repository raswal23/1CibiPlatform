@layout GenericLayout

<div class="philsys-loader-overlay">
    <MudPaper Class="philsys-loader-paper" Elevation="0" role="status" aria-live="polite" aria-busy="true">
        <div class="philsys-loader-brand" aria-hidden="true">
            <svg viewBox="0 0 100 100" focusable="false">
                <polygon points="50,5 10,35 50,50" class="philsys-logo-sky" />
                <polygon points="50,5 90,35 50,50" class="philsys-logo-sky philsys-logo-muted" />
                <polygon points="10,35 10,70 50,50" class="philsys-logo-blue philsys-logo-soft" />
                <polygon points="90,35 90,70 50,50" class="philsys-logo-blue" />
                <polygon points="10,70 50,95 50,50" class="philsys-logo-navy philsys-logo-soft" />
                <polygon points="90,70 50,95 50,50" class="philsys-logo-navy" />
            </svg>
        </div>
        <div class="philsys-loader-spinner" aria-hidden="true">
            <LoaderComponent Height="auto" />
        </div>
        <h1 class="philsys-loader-title">Verifying your identity</h1>
        <p class="philsys-loader-text">Please wait while we securely process your PhilSys verification result.</p>
    </MudPaper>
</div>
