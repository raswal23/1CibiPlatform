@inject IJSRuntime JS
@implements IAsyncDisposable

 <MudPaper Class="p-10 text-center d-flex flex-column justify-center align-center transparent-paper philsys-modern-card philsys-modern"
           Elevation="0"
           Style="padding: 18px; width:400px; max-width:90%;">
    <MudText Typo="Typo.h5" Class="mb-4 philsys-modern-title">
        Liveness Check
    </MudText>
    <MudText Typo="Typo.subtitle1" Class="mb-4 philsys-modern-sub">
        Click the button below to start the liveness verification process.
    </MudText>
    <ButtonComponent OnClick="@OnClick" Class="theme-button theme-button-active">
        <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Class="mr-2" />
        Start Liveness
    </ButtonComponent>
</MudPaper>


