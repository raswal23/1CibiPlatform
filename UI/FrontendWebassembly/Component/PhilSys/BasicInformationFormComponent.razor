@inject NavigationManager Navigation
@inject IPhilSysService PhilSysService
@inject IJSRuntime JS

<MudForm @ref="personalForm" Class="philsys-modern philsys-lookup-form">
    <MudPaper Class="pa-10 philsys-modern-card philsys-lookup-card" Elevation="3">
        <MudText Typo="Typo.h5" Class="philsys-modern-title mb-1">Personal information</MudText>
        <MudText Typo="Typo.body2" Class="philsys-modern-sub mb-3">Enter the details exactly as they appear on the registrant's PhilSys record.</MudText>

        <MudGrid Class="mb-1" Spacing="1">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="identityData.first_name"
                              Label="First name"
                              FullWidth="true"
                              Required="true"
                              RequiredError="First Name is required"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="100"
                              Class="oneplatform-rounded-input philsys-uppercase-input" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudSelect @bind-Value="identityData!.suffix"
                           Label="Suffix"
                           FullWidth="true"
                           Required="true"
                           RequiredError="Suffix is required"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="oneplatform-rounded-input">
                    <MudSelectItem Value=@("")>N/A</MudSelectItem>
                    <MudSelectItem Value=@("Jr.")>Jr.</MudSelectItem>
                    <MudSelectItem Value=@("Sr.")>Sr.</MudSelectItem>
                    <MudSelectItem Value=@("III.")>III.</MudSelectItem>
                    <MudSelectItem Value=@("IV.")>IV.</MudSelectItem>
                    <MudSelectItem Value=@("V.")>V.</MudSelectItem>
                    <MudSelectItem Value=@("VI.")>VI.</MudSelectItem>
                    <MudSelectItem Value=@("VII.")>VII.</MudSelectItem>
                    <MudSelectItem Value=@("VIII.")>VIII.</MudSelectItem>
                    <MudSelectItem Value=@("IX.")>IX.</MudSelectItem>
                    <MudSelectItem Value=@("X.")>X.</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="identityData!.middle_name"
                              Label="Middle name - Optional"
                              FullWidth="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="100"
                              Class="oneplatform-rounded-input philsys-uppercase-input" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="identityData!.last_name"
                              Label="Last name"
                              Required="true"
                              FullWidth="true"
                              RequiredError="Last Name is required"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="100"
                              Class="oneplatform-rounded-input philsys-uppercase-input" />
            </MudItem>

            <MudItem xs="12">
                <MudDatePicker @bind-Date="BirthDate"
                               Label="Birth date"
                               Adornment="Adornment.End"
                               Placeholder="dd/mm/yyyy"
                               Required="true"
                               RequiredError="Birth Date is required"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               MaxDate="@DateTime.Today.AddDays(-1)"
                               DateFormat="MM/dd/yyyy"
                               Class="oneplatform-rounded-input" />
                <MudText Typo="Typo.caption" Class="philsys-modern-sub mt-1">Must match the birth date on the registrant's ID.</MudText>
            </MudItem>
        </MudGrid>

        <div class="philsys-modern-actions">
            <div style="width: 120px; margin-left: auto;">
                <ButtonComponent OnClick="SubmitPersonalInfo"
                                 Class="theme-button theme-button-active mt-2"
                                 Style="min-width: 110px; min-height: 38px;">
                    Next →
                </ButtonComponent>
            </div>
        </div>
    </MudPaper>
</MudForm>
